$assert NR >= 8
$assert NR % 16 == 0
$assert KBLOCK == 4
$ABC = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"

#include <assert.h>
#include <stddef.h>
#include <stdint.h>

#include <immintrin.h>

#include "src/xnnpack/common.h"
#include "src/xnnpack/intrinsics-polyfill.h"
#include "src/xnnpack/packw.h"
$if PREFETCH:
  #include "src/xnnpack/prefetch.h"
static XNN_INTRINSIC __m128 xnn_load_ps_k(const float* ptr, size_t k) {
  if (k == 1) {
    return _mm_load_ss(ptr);
  } else if (k == 2) {
    return _mm_castsi128_ps(_mm_loadl_epi64((const __m128i*) ptr));
  } else {
    return _mm_setr_ps(ptr[0], ptr[1], ptr[2], 0.0f);
  }
}


void xnn_x32_packw_gemm_goi_ukernel_x${NR}__avx512f_u${KBLOCK}${"_prfm" if PREFETCH else ""}(
  size_t g,
  size_t nc,
  size_t kc,
  size_t nr,
  size_t kr,
  size_t sr,
  const uint32_t* weights,
  const uint32_t* bias,
  const void* scale,
  uint32_t* packed_weights,
  size_t extra_bytes,
  const void* params)
{
  assert(g != 0);
  assert(nc != 0);
  assert(kc != 0);
  assert(nr == ${NR});   // This kernel is for NR=${NR}
  assert(kr == 1);
  assert(sr == 1);
  assert(weights != NULL);
  assert(packed_weights != NULL);

  const __m512i vperm_idx = _mm512_setr_epi32(0, 4, 8, 12, 1, 5, 9, 13, 2, 6, 10, 14, 3, 7, 11, 15);

  const float* b = (const float*) bias;
  float* packed_w = (float*) packed_weights;
  do {
    // NC main loop multiple of ${NR}
    const float* w_base = (const float*) weights;
    size_t n = nc;

    for (; n >= ${NR}; n -= ${NR}) {
      if XNN_LIKELY(b != NULL) {
        const __m512 vb0 = _mm512_loadu_ps(b);
        $for N in range(16,NR,16):
          const __m512 vb${N} = _mm512_loadu_ps(b + ${N});
        _mm512_store_ps(packed_w, vb0);
        $for N in range(16,NR,16):
          _mm512_store_ps(packed_w + ${N}, vb${N});
        b += ${NR};
      } else {
        const __m512 vzero = _mm512_setzero_ps();
        _mm512_store_ps(packed_w, vzero);
        $for N in range(16,NR,16):
          _mm512_store_ps(packed_w + ${N}, vzero);
      }
      packed_w += ${NR};

      const ptrdiff_t stride1 = (ptrdiff_t) kc;
      const ptrdiff_t stride2 = stride1 * 2;
      const ptrdiff_t stride3 = stride1 * 3;

      $for N in range(0, NR, 4):
        $if N == 0:
          const float* w0 = w_base;
        $else:
          const float* w${N} = w0 + ${N} * stride1;
      $if PREFETCH:
        $for N in range(0, NR, 4):
          xnn_prefetch_to_l1((const int8_t*) w${N});
          xnn_prefetch_to_l1((const int8_t*) (w${N} + stride1));
          xnn_prefetch_to_l1((const int8_t*) (w${N} + stride2));
          xnn_prefetch_to_l1((const int8_t*) (w${N} + stride3));

      // KC main loop multiple of ${KBLOCK}
      size_t k = kc;
      for (; k >= ${KBLOCK}; k -= ${KBLOCK}) {
        // Read blocks of 4 rows x 4 cols into 512-bit registers
        $for N in range(0, NR, 16):
          $for G in range(0, 16, 4):
            const __m512 v${N+G} = _mm512_insertf32x4(_mm512_insertf32x4(_mm512_insertf32x4(_mm512_castps128_ps512(_mm_loadu_ps(w${N+G})), _mm_loadu_ps(w${N+G} + stride1), 1), _mm_loadu_ps(w${N+G} + stride2), 2), _mm_loadu_ps(w${N+G} + stride3), 3);

        $for B in range(0, NR, 4):
          w${B} += ${KBLOCK};

        $if PREFETCH:
          $for N in range(0, NR, 4):
            xnn_prefetch_to_l1((const int8_t*) w${N} + 128);
            xnn_prefetch_to_l1((const int8_t*) (w${N} + stride1) + 128);
            xnn_prefetch_to_l1((const int8_t*) (w${N} + stride2) + 128);
            xnn_prefetch_to_l1((const int8_t*) (w${N} + stride3) + 128);

        // Transpose 16x4 blocks: Step 1 (in-register 4x4 permute) + Step 2 (128-bit lane shuffles)
        $for N in range(0, NR, 16):
          const __m512 v${N+0}_tr = _mm512_permutexvar_ps(vperm_idx, v${N+0});
          const __m512 v${N+4}_tr = _mm512_permutexvar_ps(vperm_idx, v${N+4});
          const __m512 v${N+8}_tr = _mm512_permutexvar_ps(vperm_idx, v${N+8});
          const __m512 v${N+12}_tr = _mm512_permutexvar_ps(vperm_idx, v${N+12});

          const __m512 ab${N}_0 = _mm512_shuffle_f32x4(v${N+0}_tr, v${N+4}_tr, 0x44);
          const __m512 cd${N}_0 = _mm512_shuffle_f32x4(v${N+8}_tr, v${N+12}_tr, 0x44);
          const __m512 ab${N}_1 = _mm512_shuffle_f32x4(v${N+0}_tr, v${N+4}_tr, 0xEE);
          const __m512 cd${N}_1 = _mm512_shuffle_f32x4(v${N+8}_tr, v${N+12}_tr, 0xEE);

          const __m512 out${N}_0 = _mm512_shuffle_f32x4(ab${N}_0, cd${N}_0, 0x88);
          const __m512 out${N}_1 = _mm512_shuffle_f32x4(ab${N}_0, cd${N}_0, 0xDD);
          const __m512 out${N}_2 = _mm512_shuffle_f32x4(ab${N}_1, cd${N}_1, 0x88);
          const __m512 out${N}_3 = _mm512_shuffle_f32x4(ab${N}_1, cd${N}_1, 0xDD);

          _mm512_store_ps(packed_w + ${N + 0*NR}, out${N}_0);
          _mm512_store_ps(packed_w + ${N + 1*NR}, out${N}_1);
          _mm512_store_ps(packed_w + ${N + 2*NR}, out${N}_2);
          _mm512_store_ps(packed_w + ${N + 3*NR}, out${N}_3);

        packed_w += ${NR * KBLOCK};
      }

      // KC remainder (1..3)
      if XNN_UNLIKELY(k != 0) {
        assert(k >= 1);
        assert(k <= 3);

        $for N in range(0, NR, 16):
          $for G in range(0, 16, 4):
            const __m512 v${N+G} = _mm512_insertf32x4(_mm512_insertf32x4(_mm512_insertf32x4(_mm512_castps128_ps512(xnn_load_ps_k(w${N+G}, k)), xnn_load_ps_k(w${N+G} + stride1, k), 1), xnn_load_ps_k(w${N+G} + stride2, k), 2), xnn_load_ps_k(w${N+G} + stride3, k), 3);

          const __m512 v${N+0}_tr = _mm512_permutexvar_ps(vperm_idx, v${N+0});
          const __m512 v${N+4}_tr = _mm512_permutexvar_ps(vperm_idx, v${N+4});
          const __m512 v${N+8}_tr = _mm512_permutexvar_ps(vperm_idx, v${N+8});
          const __m512 v${N+12}_tr = _mm512_permutexvar_ps(vperm_idx, v${N+12});

          const __m512 ab${N}_0 = _mm512_shuffle_f32x4(v${N+0}_tr, v${N+4}_tr, 0x44);
          const __m512 cd${N}_0 = _mm512_shuffle_f32x4(v${N+8}_tr, v${N+12}_tr, 0x44);
          const __m512 ab${N}_1 = _mm512_shuffle_f32x4(v${N+0}_tr, v${N+4}_tr, 0xEE);
          const __m512 cd${N}_1 = _mm512_shuffle_f32x4(v${N+8}_tr, v${N+12}_tr, 0xEE);

          const __m512 out${N}_0 = _mm512_shuffle_f32x4(ab${N}_0, cd${N}_0, 0x88);
          const __m512 out${N}_1 = _mm512_shuffle_f32x4(ab${N}_0, cd${N}_0, 0xDD);
          const __m512 out${N}_2 = _mm512_shuffle_f32x4(ab${N}_1, cd${N}_1, 0x88);

          _mm512_store_ps(packed_w + ${N + 0*NR}, out${N}_0);
          if (k > 1) {
            _mm512_store_ps(packed_w + ${N + 1*NR}, out${N}_1);
          }
          if (k > 2) {
            _mm512_store_ps(packed_w + ${N + 2*NR}, out${N}_2);
          }

        packed_w += ${NR} * k;
      }
      packed_w = (float*) ((uintptr_t) packed_w + extra_bytes);
      w_base += ${NR} * stride1;
    }

    // NC remainder (1..${NR-1})
    if XNN_UNLIKELY(n != 0) {
      assert(n >= 1);
      assert(n <= ${NR-1});
      const float* w0 = w_base;
      if XNN_LIKELY(b != NULL) {
        size_t nb = n;
        do {
          *packed_w++  = *b++;
        } while (--nb != 0);
        packed_w += (${NR} - n);
      } else {
        const __m512 vzero = _mm512_setzero_ps();
        _mm512_store_ps(packed_w, vzero);
        $for N in range(16,NR,16):
          _mm512_store_ps(packed_w + ${N}, vzero);
        packed_w += ${NR};
      }

      // NR remainder has less than ${NR} rows so last row is not loaded
      // For SR=4 the
      $for N in range(1, NR-1):
        const float* w${N} = w${N-1} + kc;
        $if N % 2 == 0:
          if XNN_UNPREDICTABLE(n <= ${N}) {
            w${N} = w${N-1};
          }
        $else:
          if XNN_UNPREDICTABLE(n < ${N+1}) {
            w${N} = w${N-1};
          }

      // KC main loop multiple of ${KBLOCK}
      size_t k = kc;
      for (; k >= ${KBLOCK}; k -= ${KBLOCK}) {
        // Read blocks of 4 rows x 4 cols into 512-bit registers
        $for N in range(0, NR, 16):
          $for G in range(0, 16, 4):
            $if N + G + 3 == NR - 1:
              const __m512 v${N+G} = _mm512_insertf32x4(_mm512_insertf32x4(_mm512_insertf32x4(_mm512_castps128_ps512(_mm_loadu_ps(w${N+G})), _mm_loadu_ps(w${N+G+1}), 1), _mm_loadu_ps(w${N+G+2}), 2), _mm_setzero_ps(), 3);
            $else:
              const __m512 v${N+G} = _mm512_insertf32x4(_mm512_insertf32x4(_mm512_insertf32x4(_mm512_castps128_ps512(_mm_loadu_ps(w${N+G})), _mm_loadu_ps(w${N+G+1}), 1), _mm_loadu_ps(w${N+G+2}), 2), _mm_loadu_ps(w${N+G+3}), 3);

        $for N in range(NR-1):
          w${N} += ${KBLOCK};

        $if PREFETCH:
          $for N in range(0, NR-1):
            xnn_prefetch_to_l1((const int8_t*) w${N} + 128);

        // Transpose 16x4 blocks: Step 1 (in-register 4x4 permute) + Step 2 (128-bit lane shuffles)
        $for N in range(0, NR, 16):
          const __m512 v${N+0}_tr = _mm512_permutexvar_ps(vperm_idx, v${N+0});
          const __m512 v${N+4}_tr = _mm512_permutexvar_ps(vperm_idx, v${N+4});
          const __m512 v${N+8}_tr = _mm512_permutexvar_ps(vperm_idx, v${N+8});
          const __m512 v${N+12}_tr = _mm512_permutexvar_ps(vperm_idx, v${N+12});

          const __m512 ab${N}_0 = _mm512_shuffle_f32x4(v${N+0}_tr, v${N+4}_tr, 0x44);
          const __m512 cd${N}_0 = _mm512_shuffle_f32x4(v${N+8}_tr, v${N+12}_tr, 0x44);
          const __m512 ab${N}_1 = _mm512_shuffle_f32x4(v${N+0}_tr, v${N+4}_tr, 0xEE);
          const __m512 cd${N}_1 = _mm512_shuffle_f32x4(v${N+8}_tr, v${N+12}_tr, 0xEE);

          const __m512 out${N}_0 = _mm512_shuffle_f32x4(ab${N}_0, cd${N}_0, 0x88);
          const __m512 out${N}_1 = _mm512_shuffle_f32x4(ab${N}_0, cd${N}_0, 0xDD);
          const __m512 out${N}_2 = _mm512_shuffle_f32x4(ab${N}_1, cd${N}_1, 0x88);
          const __m512 out${N}_3 = _mm512_shuffle_f32x4(ab${N}_1, cd${N}_1, 0xDD);

          _mm512_store_ps(packed_w + ${N + 0*NR}, out${N}_0);
          _mm512_store_ps(packed_w + ${N + 1*NR}, out${N}_1);
          _mm512_store_ps(packed_w + ${N + 2*NR}, out${N}_2);
          _mm512_store_ps(packed_w + ${N + 3*NR}, out${N}_3);

        packed_w += ${NR * KBLOCK};
      }

      // KC remainder (1..3)
      if XNN_UNLIKELY(k != 0) {
        assert(k >= 1);
        assert(k <= 3);

        $for N in range(0, NR, 16):
          $for G in range(0, 16, 4):
            $if N + G + 3 == NR - 1:
              const __m512 v${N+G} = _mm512_insertf32x4(_mm512_insertf32x4(_mm512_insertf32x4(_mm512_castps128_ps512(xnn_load_ps_k(w${N+G}, k)), xnn_load_ps_k(w${N+G+1}, k), 1), xnn_load_ps_k(w${N+G+2}, k), 2), _mm_setzero_ps(), 3);
            $else:
              const __m512 v${N+G} = _mm512_insertf32x4(_mm512_insertf32x4(_mm512_insertf32x4(_mm512_castps128_ps512(xnn_load_ps_k(w${N+G}, k)), xnn_load_ps_k(w${N+G+1}, k), 1), xnn_load_ps_k(w${N+G+2}, k), 2), xnn_load_ps_k(w${N+G+3}, k), 3);

          const __m512 v${N+0}_tr = _mm512_permutexvar_ps(vperm_idx, v${N+0});
          const __m512 v${N+4}_tr = _mm512_permutexvar_ps(vperm_idx, v${N+4});
          const __m512 v${N+8}_tr = _mm512_permutexvar_ps(vperm_idx, v${N+8});
          const __m512 v${N+12}_tr = _mm512_permutexvar_ps(vperm_idx, v${N+12});

          const __m512 ab${N}_0 = _mm512_shuffle_f32x4(v${N+0}_tr, v${N+4}_tr, 0x44);
          const __m512 cd${N}_0 = _mm512_shuffle_f32x4(v${N+8}_tr, v${N+12}_tr, 0x44);
          const __m512 ab${N}_1 = _mm512_shuffle_f32x4(v${N+0}_tr, v${N+4}_tr, 0xEE);
          const __m512 cd${N}_1 = _mm512_shuffle_f32x4(v${N+8}_tr, v${N+12}_tr, 0xEE);

          const __m512 out${N}_0 = _mm512_shuffle_f32x4(ab${N}_0, cd${N}_0, 0x88);
          const __m512 out${N}_1 = _mm512_shuffle_f32x4(ab${N}_0, cd${N}_0, 0xDD);
          const __m512 out${N}_2 = _mm512_shuffle_f32x4(ab${N}_1, cd${N}_1, 0x88);

          _mm512_store_ps(packed_w + ${N + 0*NR}, out${N}_0);
          if (k > 1) {
            _mm512_store_ps(packed_w + ${N + 1*NR}, out${N}_1);
          }
          if (k > 2) {
            _mm512_store_ps(packed_w + ${N + 2*NR}, out${N}_2);
          }

        packed_w += ${NR} * k;
      }
    }
    weights += nc * kc;
  } while (--g != 0);
}
