$assert MR >= 1
$assert NR in (8, 16)
$NV = NR // 4
#include <arm_neon.h>
#include <assert.h>
#include <stddef.h>
#include <stdint.h>

#include "src/xnnpack/common.h"
#include "src/xnnpack/igemm.h"
#include "src/xnnpack/microparams.h"
#include "src/xnnpack/unaligned.h"


// Packed weights layout, per block of ${NR} output channels:
//   float bias[${NR}];
//   for each kernel element, for each pair of input channels:
//     uint16_t kernel[${NR}][2];  // bf16
//
// Each pair of input channels is multiplied with the pairs of weights using
// BFDOT, so this needs the Arm BF16 extension (e.g. Apple M2 and later).
void xnn_bf16_f32_igemm_minmax_ukernel_${MR}x${NR}c2__neonbf16_bfdot_lane_ld128(
    size_t mr,
    size_t nc,
    size_t kc,
    size_t ks,
    const xnn_bfloat16** restrict a,
    const void* restrict w,
    float* restrict c,
    size_t cm_stride,
    size_t cn_stride,
    size_t a_offset,
    const xnn_bfloat16* zero,
    const struct xnn_f32_minmax_params* restrict params)
{
  assert(mr != 0);
  assert(mr <= ${MR});
  assert(nc != 0);
  assert(kc != 0);
  assert(kc % sizeof(xnn_bfloat16) == 0);
  assert(ks != 0);
  assert(ks % (${MR} * sizeof(void*)) == 0);
  assert(a_offset % sizeof(xnn_bfloat16) == 0);
  assert(a != NULL);
  assert(w != NULL);
  assert(c != NULL);

  float* c0 = c;
  $for M in range(1, MR):
    float* c${M} = (float*) ((uintptr_t) c${M-1} + cm_stride);
    $if M % 2 == 0:
      if XNN_UNPREDICTABLE(mr <= ${M}) {
        c${M} = c${M-1};
      }
    $elif M + 1 == MR:
      if XNN_UNPREDICTABLE(mr != ${M+1}) {
        c${M} = c${M-1};
      }
    $else:
      if XNN_UNPREDICTABLE(mr < ${M+1}) {
        c${M} = c${M-1};
      }

  const float32x4_t vmin = vdupq_n_f32(params->scalar.min);
  const float32x4_t vmax = vdupq_n_f32(params->scalar.max);
  do {
    $for N in range(NV):
      float32x4_t vacc0x${N} = vld1q_f32((const float*) w + ${N * 4});
    $for M in range(1, MR):
      $for N in range(NV):
        float32x4_t vacc${M}x${N} = vacc0x${N};
    const uint16_t* wk = (const uint16_t*) ((const float*) w + ${NR});

    size_t p = ks;
    do {
      $for M in range(MR):
        const uint16_t* restrict a${M} = (const uint16_t*) a[${M}];
        assert(a${M} != NULL);
        if XNN_UNPREDICTABLE(a${M} != (const uint16_t*) zero) {
          a${M} = (const uint16_t*) ((uintptr_t) a${M} + a_offset);
        }
      a += ${MR};

      size_t k = kc;
      for (; k >= 8 * sizeof(xnn_bfloat16); k -= 8 * sizeof(xnn_bfloat16)) {
        $for M in range(MR):
          const bfloat16x8_t va${M} = vreinterpretq_bf16_u16(vld1q_u16(a${M}));
          a${M} += 8;

        $for L in range(4):
          $for N in range(NV):
            const bfloat16x8_t vb${N}c${L} = vreinterpretq_bf16_u16(vld1q_u16(wk + ${L * 2 * NR + N * 8}));
          $for M in range(MR):
            $for N in range(NV):
              vacc${M}x${N} = vbfdotq_laneq_f32(vacc${M}x${N}, vb${N}c${L}, va${M}, ${L});
        wk += ${8 * NR};
      }
      // Remaining pairs of input channels. When the number of input channels
      // is odd, only the last one is loaded, so bytes past the end of the row
      // can't leak into the result through the zero-padded weights.
      while (k != 0) {
        $for M in range(MR):
          uint32_t va${M}_pair;
        if XNN_LIKELY(k >= 2 * sizeof(xnn_bfloat16)) {
          $for M in range(MR):
            va${M}_pair = unaligned_load_u32(a${M});
            a${M} += 2;
          k -= 2 * sizeof(xnn_bfloat16);
        } else {
          $for M in range(MR):
            va${M}_pair = (uint32_t) *a${M};
          k = 0;
        }
        $for M in range(MR):
          const bfloat16x8_t va${M} = vreinterpretq_bf16_u32(vdupq_n_u32(va${M}_pair));

        $for N in range(NV):
          const bfloat16x8_t vb${N} = vreinterpretq_bf16_u16(vld1q_u16(wk + ${N * 8}));
        wk += ${2 * NR};

        $for M in range(MR):
          $for N in range(NV):
            vacc${M}x${N} = vbfdotq_f32(vacc${M}x${N}, vb${N}, va${M});
      }
      p -= ${MR} * sizeof(void*);
    } while (p != 0);
    w = (const void*) wk;

    $for M in range(MR):
      $for N in range(NV):
        vacc${M}x${N} = vmaxq_f32(vacc${M}x${N}, vmin);
    $for M in range(MR):
      $for N in range(NV):
        vacc${M}x${N} = vminq_f32(vacc${M}x${N}, vmax);

    if XNN_LIKELY(nc >= ${NR}) {
      $for M in reversed(range(MR)):
        $for N in range(NV):
          vst1q_f32(c${M} + ${N * 4}, vacc${M}x${N});
        c${M} = (float*) ((uintptr_t) c${M} + cn_stride);

      a = (const xnn_bfloat16**restrict) ((uintptr_t) a - ks);
      nc -= ${NR};
    } else {
      $if NR == 16:
        if (nc & 8) {
          $for M in reversed(range(MR)):
            vst1q_f32(c${M}, vacc${M}x0);
            vst1q_f32(c${M} + 4, vacc${M}x1);
            vacc${M}x0 = vacc${M}x2;
            vacc${M}x1 = vacc${M}x3;
            c${M} += 8;
        }
      if (nc & 4) {
        $for M in reversed(range(MR)):
          vst1q_f32(c${M}, vacc${M}x0);
          vacc${M}x0 = vacc${M}x1;
          c${M} += 4;
      }
      $for M in reversed(range(MR)):
        float32x2_t vacc${M}_lo = vget_low_f32(vacc${M}x0);
      if (nc & 2) {
        $for M in reversed(range(MR)):
          vst1_f32(c${M}, vacc${M}_lo);
          vacc${M}_lo = vget_high_f32(vacc${M}x0);
          c${M} += 2;
      }
      if (nc & 1) {
        $for M in reversed(range(MR)):
          vst1_lane_f32(c${M}, vacc${M}_lo, 0);
      }
      nc = 0;
    }
  } while (nc != 0);
}
