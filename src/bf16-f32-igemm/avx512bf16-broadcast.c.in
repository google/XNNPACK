$assert MR >= 1
$assert NR in (16, 32)
$NV = NR // 16
#include <assert.h>
#include <immintrin.h>
#include <stddef.h>
#include <stdint.h>

#include "src/xnnpack/common.h"
#include "src/xnnpack/igemm.h"
#include "src/xnnpack/intrinsics-polyfill.h"
#include "src/xnnpack/microparams.h"
#include "src/xnnpack/unaligned.h"


// Packed weights layout, per block of ${NR} output channels:
//   float bias[${NR}];
//   for each kernel element, for each pair of input channels:
//     uint16_t kernel[${NR}][2];  // bf16
//
// Each pair of input channels is broadcast from the input rows and multiplied
// with the pairs of weights using vdpbf16ps.
void xnn_bf16_f32_igemm_minmax_ukernel_${MR}x${NR}c2__avx512bf16_broadcast(
    size_t mr,
    size_t nc,
    size_t kc,
    size_t ks,
    const xnn_bfloat16** restrict a,
    const void* restrict w,
    float* restrict c,
    size_t cm_stride,
    size_t cn_stride,
    size_t a_offset,
    const xnn_bfloat16* zero,
    const struct xnn_f32_minmax_params* restrict params)
{
  assert(mr != 0);
  assert(mr <= ${MR});
  assert(nc != 0);
  assert(kc != 0);
  assert(kc % sizeof(xnn_bfloat16) == 0);
  assert(ks != 0);
  assert(ks % (${MR} * sizeof(void*)) == 0);
  assert(a_offset % sizeof(xnn_bfloat16) == 0);
  assert(a != NULL);
  assert(w != NULL);
  assert(c != NULL);

  float* c0 = c;
  $for M in range(1, MR):
    float* c${M} = (float*) ((uintptr_t) c${M-1} + cm_stride);
    $if M % 2 == 0:
      if XNN_UNPREDICTABLE(mr <= ${M}) {
        c${M} = c${M-1};
      }
    $elif M + 1 == MR:
      if XNN_UNPREDICTABLE(mr != ${M+1}) {
        c${M} = c${M-1};
      }
    $else:
      if XNN_UNPREDICTABLE(mr < ${M+1}) {
        c${M} = c${M-1};
      }

  const __m512 vmin = _mm512_set1_ps(params->scalar.min);
  const __m512 vmax = _mm512_set1_ps(params->scalar.max);
  do {
    $for N in range(NV):
      __m512 vacc0x${N} = _mm512_loadu_ps((const float*) w + ${N * 16});
    $for M in range(1, MR):
      $for N in range(NV):
        __m512 vacc${M}x${N} = vacc0x${N};
    w = (const float*) w + ${NR};

    size_t p = ks;
    do {
      $for M in range(MR):
        const uint16_t* restrict a${M} = (const uint16_t*) a[${M}];
        assert(a${M} != NULL);
        if XNN_UNPREDICTABLE(a${M} != (const uint16_t*) zero) {
          a${M} = (const uint16_t*) ((uintptr_t) a${M} + a_offset);
        }
      a += ${MR};

      size_t k = kc;
      for (; k >= 2 * sizeof(xnn_bfloat16); k -= 2 * sizeof(xnn_bfloat16)) {
        $for N in range(NV):
          const __m512i vb${N} = _mm512_loadu_si512((const uint16_t*) w + ${N * 32});
        w = (const uint16_t*) w + ${2 * NR};

        $for M in range(MR):
          const __m512i va${M} = _mm512_set1_epi32((int) unaligned_load_u32(a${M}));
          a${M} += 2;
          $for N in range(NV):
            vacc${M}x${N} = _mm512_dpbf16_ps(vacc${M}x${N}, (__m512bh) va${M}, (__m512bh) vb${N});
      }
      if XNN_UNLIKELY(k != 0) {
        // Odd number of input channels: the packed weights are zero-padded,
        // but the input is not, so only load the last input channel.
        $for N in range(NV):
          const __m512i vb${N} = _mm512_loadu_si512((const uint16_t*) w + ${N * 32});
        w = (const uint16_t*) w + ${2 * NR};

        $for M in range(MR):
          const __m512i va${M} = _mm512_set1_epi32((int) (uint32_t) a${M}[0]);
          $for N in range(NV):
            vacc${M}x${N} = _mm512_dpbf16_ps(vacc${M}x${N}, (__m512bh) va${M}, (__m512bh) vb${N});
      }
      p -= ${MR} * sizeof(void*);
    } while (p != 0);

    $for M in range(MR):
      $for N in range(NV):
        vacc${M}x${N} = _mm512_max_ps(vmin, vacc${M}x${N});
    $for M in range(MR):
      $for N in range(NV):
        vacc${M}x${N} = _mm512_min_ps(vmax, vacc${M}x${N});

    if XNN_LIKELY(nc >= ${NR}) {
      $for M in reversed(range(MR)):
        $for N in range(NV):
          _mm512_storeu_ps(c${M} + ${N * 16}, vacc${M}x${N});
        c${M} = (float*) ((uintptr_t) c${M} + cn_stride);

      a = (const xnn_bfloat16**restrict) ((uintptr_t) a - ks);
      nc -= ${NR};
    } else {
      $if NV == 2:
        if (nc & 16) {
          $for M in reversed(range(MR)):
            _mm512_storeu_ps(c${M}, vacc${M}x0);
            vacc${M}x0 = vacc${M}x1;
            c${M} += 16;
          nc -= 16;
        }
      if (nc != 0) {
        const __mmask16 vmask = _cvtu32_mask16((uint32_t) ((UINT32_C(1) << nc) - 1));
        $for M in reversed(range(MR)):
          _mm512_mask_storeu_ps(c${M}, vmask, vacc${M}x0);
      }
      nc = 0;
    }
  } while (nc != 0);
}
