$assert DATATYPE in ["QS8", "QU8"]
#include <assert.h>
#include <stddef.h>
#include <stdint.h>

#include "src/xnnpack/avgpool.h"
#include "src/xnnpack/common.h"
#include "src/xnnpack/math.h"
#include "src/xnnpack/microparams.h"


$XINT8_T = {"QS8": "int8_t", "QU8": "uint8_t"}[DATATYPE]
void xnn_${DATATYPE.lower()}_avgpool_minmax_fp32_ukernel_9p__scalar_fmagic_u1(
    size_t output_pixels,
    size_t kernel_elements,
    size_t channels,
    const ${XINT8_T}** input,
    size_t input_offset,
    size_t input_pixel_stride,
    const ${XINT8_T}* zero,
    const float* multiplier,
    ${XINT8_T}* output,
    size_t input_increment,
    size_t output_increment,
    const struct xnn_${DATATYPE.lower()}_avgpool_minmax_params* restrict params)
{
  assert(output_pixels != 0);
  assert(kernel_elements != 0);
  assert(channels != 0);

  const int32_t vinit_bias = params->scalar.init_bias;
  float vscale = params->scalar.scale;
  const float voutput_min_less_zero_point =
      (float) ((int32_t) params->scalar.output_min - (int32_t) params->scalar.output_zero_point);
  const float voutput_max_less_zero_point =
      (float) ((int32_t) params->scalar.output_max - (int32_t) params->scalar.output_zero_point);
  const float vmagic_bias = 12582912.0f;
  const int32_t vmagic_bias_less_output_zero_point =
      INT32_C(0x4B400000) - (int32_t) params->scalar.output_zero_point;

  do {
    if (multiplier != NULL) {
      vscale = *multiplier++;
    }

    ${XINT8_T}* o = output;
    size_t c_offset = 0;
    size_t c = channels;
    do {
      const ${XINT8_T}** i = input;
      size_t k = kernel_elements;
      int32_t vacc = 0;
      do {
        vacc += vinit_bias;
        $for K in range(9):
          const ${XINT8_T}* i${K} = ${K} < k ? *i++ : zero;
          assert(i${K} != NULL);
          if XNN_UNPREDICTABLE(i${K} != zero) {
            i${K} = (const ${XINT8_T}*) ((uintptr_t) i${K} + input_offset);
          }
          vacc += (int32_t) i${K}[c_offset];
        k = doz(k, 9);
      } while (k != 0);

      float vfpacc = (float) vacc * vscale;
      vfpacc = math_max_f32(vfpacc, voutput_min_less_zero_point);
      vfpacc = math_min_f32(vfpacc, voutput_max_less_zero_point);
      vfpacc += vmagic_bias;
      int32_t vout = (int32_t) float_as_uint32(vfpacc) - vmagic_bias_less_output_zero_point;
      *o++ = (${XINT8_T}) vout;
      c_offset += 1;
    } while (--c != 0);

    input = (const ${XINT8_T}**) ((uintptr_t) input + input_increment);
    input_offset += input_pixel_stride;
    output = (${XINT8_T}*) ((uintptr_t) output + output_increment);
  } while (--output_pixels != 0);
}
