$assert FUN in {"SIN", "COS"}
$assert LMUL in [1, 2, 4, 8]
#include <assert.h>
#include <stddef.h>
#include <stdint.h>

#include <riscv_vector.h>

#include "src/xnnpack/common.h"
#include "src/xnnpack/microparams.h"
#include "src/xnnpack/vunary.h"


void xnn_f32_v${FUN.lower()}_ukernel__rvv_poly_4_u${LMUL}v(
    size_t batch,
    const float* input,
    float* output,
    const struct xnn_f32_default_params* unused_params)
{
  assert(batch != 0);
  assert(batch % sizeof(float) == 0);
  assert(input != NULL);
  assert(output != NULL);

  batch >>= XNN_LOG2_SIZEOF_FLOAT;

  const float vmagic = 12582912.0f;  // 1.5 * 2^23
  $if FUN == "SIN":
    const float vone_over_pi = 0.31830988618379067154f;
    const float vpi_0 = -3.14159274e+00f;
    const float vpi_1 = 8.74227766e-08f;
    const float vpi_2 = 3.43024902e-15f;
  $else:
    const float vtwo_over_pi = 0.63661977236758134308f;
    const float vpi_over_two = 1.5707963267948966f;
    const float vhalf_pi_0 = -1.57079637e+00f;
    const float vhalf_pi_1 = 4.37113883e-08f;
    const float vhalf_pi_2 = 1.71512451e-15f;

  const float vc4 = 2.6052248359e-06f;
  const float vc3 = -1.9809075457e-04f;
  const float vc2 = 8.3330506459e-03f;
  const float vc1 = -1.6666658223e-01f;
  const float vc0 = 1.0000000000e+00f;

  do {
    size_t vl = __riscv_vsetvl_e32m${LMUL}(batch); batch -= vl;
    vfloat32m${LMUL}_t vx = __riscv_vle32_v_f32m${LMUL}(input, vl); input += vl;

    $if FUN == "SIN":
      vfloat32m${LMUL}_t vy = __riscv_vfmul(vx, vone_over_pi, vl);
      vfloat32m${LMUL}_t vk = __riscv_vfadd(vy, vmagic, vl);
      vfloat32m${LMUL}_t vk_float = __riscv_vfsub(vk, vmagic, vl);

      vx = __riscv_vfmacc_vf_f32m${LMUL}(vx, vpi_0, vk_float, vl);
      vx = __riscv_vfmacc_vf_f32m${LMUL}(vx, vpi_1, vk_float, vl);
      vx = __riscv_vfmacc_vf_f32m${LMUL}(vx, vpi_2, vk_float, vl);

      vuint32m${LMUL}_t vu_k = __riscv_vreinterpret_u32m${LMUL}(vk);
      vuint32m${LMUL}_t vsign_flip = __riscv_vsll(vu_k, 31u, vl);
      vx = __riscv_vreinterpret_f32m${LMUL}(__riscv_vxor(__riscv_vreinterpret_u32m${LMUL}(vx), vsign_flip, vl));
    $else:
      vfloat32m${LMUL}_t vy = __riscv_vfmul(vx, vtwo_over_pi, vl);
      vfloat32m${LMUL}_t vk = __riscv_vfadd(vy, vmagic, vl);
      vfloat32m${LMUL}_t vk_float = __riscv_vfsub(vk, vmagic, vl);

      vx = __riscv_vfmacc_vf_f32m${LMUL}(vx, vhalf_pi_0, vk_float, vl);
      vx = __riscv_vfmacc_vf_f32m${LMUL}(vx, vhalf_pi_1, vk_float, vl);
      vx = __riscv_vfmacc_vf_f32m${LMUL}(vx, vhalf_pi_2, vk_float, vl);

      vfloat32m${LMUL}_t vk_quad = __riscv_vfadd(vk, 1.0f, vl);
      vuint32m${LMUL}_t vu_quad = __riscv_vreinterpret_u32m${LMUL}(vk_quad);
      vbool${32 // LMUL}_t vmask_odd = __riscv_vmseq(__riscv_vand(vu_quad, 1u, vl), 1u, vl);
      vuint32m${LMUL}_t vsign_flip = __riscv_vsll(__riscv_vsrl(vu_quad, 1u, vl), 31u, vl);

      vfloat32m${LMUL}_t vabs_x = __riscv_vfabs(vx, vl);
      vfloat32m${LMUL}_t vsub_x = __riscv_vfrsub(vabs_x, vpi_over_two, vl);
      vx = __riscv_vmerge(vx, vsub_x, vmask_odd, vl);
      vx = __riscv_vreinterpret_f32m${LMUL}(__riscv_vxor(__riscv_vreinterpret_u32m${LMUL}(vx), vsign_flip, vl));

    const vfloat32m${LMUL}_t vx2 = __riscv_vfmul(vx, vx, vl);

    vfloat32m${LMUL}_t vp = __riscv_vfadd(__riscv_vfmul(vx2, vc4, vl), vc3, vl);
    vp = __riscv_vfadd(__riscv_vfmul(vx2, vp, vl), vc2, vl);
    vp = __riscv_vfadd(__riscv_vfmul(vx2, vp, vl), vc1, vl);
    vp = __riscv_vfadd(__riscv_vfmul(vx2, vp, vl), vc0, vl);

    vfloat32m${LMUL}_t vy_res = __riscv_vfmul(vx, vp, vl);

    __riscv_vse32_v_f32m${LMUL}(output, vy_res, vl); output += vl;
  } while (batch != 0);
}
