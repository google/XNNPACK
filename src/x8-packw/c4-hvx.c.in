$assert NR in [64, 128]
$assert KR == 4
$assert DATATYPE == "QS8"
$assert IZP in [0, 128]
$SIMD_TILE = NR // 32
#include <assert.h>
#include <hexagon_protos.h>
#include <hexagon_types.h>
#include <hvx_hexagon_protos.h>
#include <stddef.h>
#include <stdint.h>
#include <string.h>

#include "src/xnnpack/common.h"
#include "src/xnnpack/microparams.h"
#include "src/xnnpack/packw.h"
#include "src/xnnpack/simd/s32-hvx.h"
#include "src/xnnpack/unaligned.h"

void xnn_qs8${"_to_qu8" if IZP == 128 else ""}_packw_gemm_goi_ukernel_x${NR}c${KR}__hvx(
    size_t g,
    size_t nc,
    size_t kc,
    size_t nr,
    size_t kr,
    size_t sr,
    size_t n_stride,
    const int8_t* weights,
    const int32_t* bias,
    const void* scale,
    int8_t* packed_weights,
    size_t extra_bytes,
    const void* params) {
  assert(g != 0);
  assert(nc != 0);
  assert(kc != 0);
  assert(nr == ${NR});
  assert(kr == ${KR});
  assert(sr == 1);
  assert(weights != NULL);
  assert(packed_weights != NULL);

  const int32_t izp = (int32_t) (params
      ? (((const struct xnn_qs8_packw_params*) params)->input_zero_point + ${IZP})
      : ${IZP});
  const HVX_Vector vzero = Q6_V_vzero();
  const HVX_Vector vones = Q6_Vb_vsplat_R(1);
  const HVX_Vector vizp = Q6_V_vsplat_R(izp);

  int8_t* out = packed_weights;
  const int32_t* b = bias;

  do {
    const int8_t* w0 = weights;
    size_t n = nc;
    for (; n >= ${NR}; n -= ${NR}) {
      int32_t* packed_b = (int32_t*) out;
      if XNN_LIKELY(b != NULL) {
        $for T in range(SIMD_TILE):
          *((HVX_UVector*) (packed_b + ${T * 32})) =
              *((const HVX_UVector*) (b + ${T * 32}));
        b += ${NR};
      } else {
        $for T in range(SIMD_TILE):
          *((HVX_UVector*) (packed_b + ${T * 32})) = vzero;
      }
      out += ${NR} * sizeof(int32_t);

      $for N in range(1, NR):
        const int8_t* w${N} = w${N - 1} + n_stride;
      $for T in range(SIMD_TILE):
        HVX_Vector vacc${T}_0 = vzero;
        HVX_Vector vacc${T}_1 = vzero;

      size_t k = kc;
      for (; k >= 128; k -= 128) {
        $for T in range(SIMD_TILE):
          $N_OFFSET = T * 32
          {
            $for N in range(32):
              const HVX_Vector v5_${N} = *((const HVX_UVector*) w${N_OFFSET + N});
              w${N_OFFSET + N} += 128;

            $for N in range(16):
              const HVX_VectorPair v4_${N} =
                  Q6_W_vshuff_VVR(v5_${2 * N + 1}, v5_${2 * N}, -4);

            $for N in range(8):
              const HVX_VectorPair v3_${2 * N} = Q6_W_vshuff_VVR(
                  Q6_V_lo_W(v4_${2 * N + 1}), Q6_V_lo_W(v4_${2 * N}), -8);
              const HVX_VectorPair v3_${2 * N + 1} = Q6_W_vshuff_VVR(
                  Q6_V_hi_W(v4_${2 * N + 1}), Q6_V_hi_W(v4_${2 * N}), -8);

            $for N in range(0, 16, 4):
              $for O in range(2):
                const HVX_VectorPair v2_${N + 2 * O} = Q6_W_vshuff_VVR(
                    Q6_V_lo_W(v3_${N + O + 2}), Q6_V_lo_W(v3_${N + O}), -16);
                const HVX_VectorPair v2_${N + 2 * O + 1} = Q6_W_vshuff_VVR(
                    Q6_V_hi_W(v3_${N + O + 2}), Q6_V_hi_W(v3_${N + O}), -16);

            $for N in range(0, 16, 8):
              $for O in range(4):
                const HVX_VectorPair v1_${N + 2 * O} = Q6_W_vshuff_VVR(
                    Q6_V_lo_W(v2_${N + O + 4}), Q6_V_lo_W(v2_${N + O}), -32);
                const HVX_VectorPair v1_${N + 2 * O + 1} = Q6_W_vshuff_VVR(
                    Q6_V_hi_W(v2_${N + O + 4}), Q6_V_hi_W(v2_${N + O}), -32);

            $for O in range(8):
              const HVX_VectorPair v0_${2 * O} = Q6_W_vshuff_VVR(
                  Q6_V_lo_W(v1_${O + 8}), Q6_V_lo_W(v1_${O}), -64);
              const HVX_VectorPair v0_${2 * O + 1} = Q6_W_vshuff_VVR(
                  Q6_V_hi_W(v1_${O + 8}), Q6_V_hi_W(v1_${O}), -64);

            $for K in range(16):
              const HVX_Vector vt_lo_${K} = Q6_V_lo_W(v0_${K});
              const HVX_Vector vt_hi_${K} = Q6_V_hi_W(v0_${K});
              *((HVX_UVector*) (out + ${(2 * K) * NR * 4 + N_OFFSET * 4})) =
                  vt_lo_${K};
              *((HVX_UVector*) (out + ${(2 * K + 1) * NR * 4 + N_OFFSET * 4})) =
                  vt_hi_${K};
              vacc${T}_0 = Q6_Vw_vrmpyacc_VwVbVb(vacc${T}_0, vt_lo_${K}, vones);
              vacc${T}_1 = Q6_Vw_vrmpyacc_VwVbVb(vacc${T}_1, vt_hi_${K}, vones);
          }
        out += ${NR * 128};
      }

      for (; k >= 4; k -= 4) {
        $for N in range(NR):
          unaligned_store_u32(out + ${N * 4}, unaligned_load_u32(w${N}));
          w${N} += 4;
        $for T in range(SIMD_TILE):
          vacc${T}_0 = Q6_Vw_vrmpyacc_VwVbVb(
              vacc${T}_0, *((const HVX_UVector*) (out + ${T * 128})), vones);
        out += ${NR * 4};
      }

      if (k != 0) {
        assert(k >= 1 && k <= 3);
        $for N in range(NR):
          {
            const uint32_t b0 = (uint8_t) w${N}[0];
            const uint32_t b1 = k > 1 ? (uint32_t) (uint8_t) w${N}[1] : 0;
            const uint32_t b2 = k > 2 ? (uint32_t) (uint8_t) w${N}[2] : 0;
            unaligned_store_u32(out + ${N * 4}, b0 | (b1 << 8) | (b2 << 16));
            w${N} += k;
          }
        $for T in range(SIMD_TILE):
          vacc${T}_0 = Q6_Vw_vrmpyacc_VwVbVb(
              vacc${T}_0, *((const HVX_UVector*) (out + ${T * 128})), vones);
        out += ${NR * 4};
      }

      $for T in range(SIMD_TILE):
        {
          const HVX_Vector vksum = Q6_Vw_vadd_VwVw(vacc${T}_0, vacc${T}_1);
          const HVX_Vector vpb = *((const HVX_UVector*) (packed_b + ${T * 32}));
          *((HVX_UVector*) (packed_b + ${T * 32})) =
              Q6_Vw_vsub_VwVw(vpb, xnn_mul_s32(vksum, vizp));
        }

      out = (int8_t*) ((uintptr_t) out + extra_bytes);
      w0 = w${NR - 1} + n_stride - kc;
    }

    if XNN_UNLIKELY(n != 0) {
      int32_t* packed_b = (int32_t*) out;
      if XNN_LIKELY(b != NULL) {
        memcpy(packed_b, b, n * sizeof(int32_t));
        b += n;
      } else {
        memset(packed_b, 0, n * sizeof(int32_t));
      }
      out += ${NR} * sizeof(int32_t);

      const int8_t* w_ptr[${NR}];
      w_ptr[0] = w0;
      for (size_t i = 1; i < n; ++i) {
        w_ptr[i] = w_ptr[i - 1] + n_stride;
      }

      HVX_Vector vacc_even[${SIMD_TILE}];
      HVX_Vector vacc_odd[${SIMD_TILE}];
      $for T in range(SIMD_TILE):
        vacc_even[${T}] = vzero;
        vacc_odd[${T}] = vzero;

      size_t k = kc;
      for (; k >= 128; k -= 128) {
        for (size_t t = 0; t < ${SIMD_TILE}; ++t) {
          const size_t n_off = t * 32;
          if (n_off >= n) {
            for (size_t kk = 0; kk < 32; ++kk) {
              *((HVX_UVector*) (out + kk * ${NR * 4} + n_off * 4)) = vzero;
            }
          } else {
            $for N in range(32):
              HVX_Vector v5_${N} = vzero;
              if (n_off + ${N} < n) {
                v5_${N} = *((const HVX_UVector*) w_ptr[n_off + ${N}]);
                w_ptr[n_off + ${N}] += 128;
              }

            $for N in range(16):
              const HVX_VectorPair v4_${N} =
                  Q6_W_vshuff_VVR(v5_${2 * N + 1}, v5_${2 * N}, -4);

            $for N in range(8):
              const HVX_VectorPair v3_${2 * N} = Q6_W_vshuff_VVR(
                  Q6_V_lo_W(v4_${2 * N + 1}), Q6_V_lo_W(v4_${2 * N}), -8);
              const HVX_VectorPair v3_${2 * N + 1} = Q6_W_vshuff_VVR(
                  Q6_V_hi_W(v4_${2 * N + 1}), Q6_V_hi_W(v4_${2 * N}), -8);

            $for N in range(0, 16, 4):
              $for O in range(2):
                const HVX_VectorPair v2_${N + 2 * O} = Q6_W_vshuff_VVR(
                    Q6_V_lo_W(v3_${N + O + 2}), Q6_V_lo_W(v3_${N + O}), -16);
                const HVX_VectorPair v2_${N + 2 * O + 1} = Q6_W_vshuff_VVR(
                    Q6_V_hi_W(v3_${N + O + 2}), Q6_V_hi_W(v3_${N + O}), -16);

            $for N in range(0, 16, 8):
              $for O in range(4):
                const HVX_VectorPair v1_${N + 2 * O} = Q6_W_vshuff_VVR(
                    Q6_V_lo_W(v2_${N + O + 4}), Q6_V_lo_W(v2_${N + O}), -32);
                const HVX_VectorPair v1_${N + 2 * O + 1} = Q6_W_vshuff_VVR(
                    Q6_V_hi_W(v2_${N + O + 4}), Q6_V_hi_W(v2_${N + O}), -32);

            $for O in range(8):
              const HVX_VectorPair v0_${2 * O} = Q6_W_vshuff_VVR(
                  Q6_V_lo_W(v1_${O + 8}), Q6_V_lo_W(v1_${O}), -64);
              const HVX_VectorPair v0_${2 * O + 1} = Q6_W_vshuff_VVR(
                  Q6_V_hi_W(v1_${O + 8}), Q6_V_hi_W(v1_${O}), -64);

            $for K in range(16):
              const HVX_Vector vt_lo_${K} = Q6_V_lo_W(v0_${K});
              const HVX_Vector vt_hi_${K} = Q6_V_hi_W(v0_${K});
              *((HVX_UVector*) (out + ${(2 * K) * NR * 4} + n_off * 4)) =
                  vt_lo_${K};
              *((HVX_UVector*) (out + ${(2 * K + 1) * NR * 4} + n_off * 4)) =
                  vt_hi_${K};
              vacc_even[t] =
                  Q6_Vw_vrmpyacc_VwVbVb(vacc_even[t], vt_lo_${K}, vones);
              vacc_odd[t] =
                  Q6_Vw_vrmpyacc_VwVbVb(vacc_odd[t], vt_hi_${K}, vones);
          }
        }
        out += ${NR * 128};
      }

      for (; k >= 4; k -= 4) {
        size_t i = 0;
        for (; i < n; ++i) {
          unaligned_store_u32(out + i * 4, unaligned_load_u32(w_ptr[i]));
          w_ptr[i] += 4;
        }
        for (; i < ${NR}; ++i) {
          unaligned_store_u32(out + i * 4, 0);
        }
        $for T in range(SIMD_TILE):
          vacc_even[${T}] = Q6_Vw_vrmpyacc_VwVbVb(
              vacc_even[${T}], *((const HVX_UVector*) (out + ${T * 128})),
              vones);
        out += ${NR * 4};
      }

      if (k != 0) {
        assert(k >= 1 && k <= 3);
        size_t i = 0;
        for (; i < n; ++i) {
          const uint32_t b0 = (uint8_t) w_ptr[i][0];
          const uint32_t b1 = k > 1 ? (uint32_t) (uint8_t) w_ptr[i][1] : 0;
          const uint32_t b2 = k > 2 ? (uint32_t) (uint8_t) w_ptr[i][2] : 0;
          unaligned_store_u32(out + i * 4, b0 | (b1 << 8) | (b2 << 16));
          w_ptr[i] += k;
        }
        for (; i < ${NR}; ++i) {
          unaligned_store_u32(out + i * 4, 0);
        }
        $for T in range(SIMD_TILE):
          vacc_even[${T}] = Q6_Vw_vrmpyacc_VwVbVb(
              vacc_even[${T}], *((const HVX_UVector*) (out + ${T * 128})),
              vones);
        out += ${NR * 4};
      }

      for (size_t t = 0; t < ${SIMD_TILE}; ++t) {
        const size_t n_off = t * 32;
        if (n_off >= n) {
          break;
        }
        const HVX_Vector vadj =
            xnn_mul_s32(Q6_Vw_vadd_VwVw(vacc_even[t], vacc_odd[t]), vizp);
        if (n - n_off >= 32) {
          const HVX_Vector vpb = *((const HVX_UVector*) (packed_b + n_off));
          *((HVX_UVector*) (packed_b + n_off)) = Q6_Vw_vsub_VwVw(vpb, vadj);
        } else {
          XNN_ALIGN(128) int32_t adj_buf[32];
          *((HVX_Vector*) adj_buf) = vadj;
          const size_t rem = n - n_off;
          for (size_t r = 0; r < rem; ++r) {
            packed_b[n_off + r] =
                (int32_t) ((uint32_t) packed_b[n_off + r] -
                           (uint32_t) adj_buf[r]);
          }
        }
      }

      out = (int8_t*) ((uintptr_t) out + extra_bytes);
    }
    weights += nc * n_stride;
  } while (--g != 0);
}
