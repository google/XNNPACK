$BATCH_TILE = 4
#include <assert.h>
#include <math.h>
#include <stddef.h>

#include "src/xnnpack/math.h"
#include "src/xnnpack/microparams.h"
#include "src/xnnpack/vunary.h"


$for OP in ["SQR", "RSQRT", "SIGMOID"]:
  void xnn_bf16_v${OP.lower()}_ukernel__scalar_u${BATCH_TILE}(
      size_t batch,
      const xnn_bfloat16* input,
      xnn_bfloat16* output,
      const struct xnn_bf16_default_params* restrict params)
  {
    assert(batch != 0);
    assert(batch % sizeof(xnn_bfloat16) == 0);
    assert(input != NULL);
    assert(output != NULL);

    for (; batch >= ${BATCH_TILE} * sizeof(xnn_bfloat16);
         batch -= ${BATCH_TILE} * sizeof(xnn_bfloat16)) {
      $for N in range(BATCH_TILE):
        const float vx${N} = xnn_bfloat16_to_float(input[${N}]);
      input += ${BATCH_TILE};

      $for N in range(BATCH_TILE):
        $if OP == "SQR":
          const float vy${N} = vx${N} * vx${N};
        $elif OP == "RSQRT":
          const float vy${N} = 1.0f / sqrtf(vx${N});
        $else:
          const float vy${N} = 1.0f / (1.0f + expf(-vx${N}));

      $for N in range(BATCH_TILE):
        output[${N}] = xnn_bfloat16_from_float(vy${N});
      output += ${BATCH_TILE};
    }

    while (batch != 0) {
      const float vx = xnn_bfloat16_to_float(*input++);
      $if OP == "SQR":
        const float vy = vx * vx;
      $elif OP == "RSQRT":
        const float vy = 1.0f / sqrtf(vx);
      $else:
        const float vy = 1.0f / (1.0f + expf(-vx));
      *output++ = xnn_bfloat16_from_float(vy);
      batch -= sizeof(xnn_bfloat16);
    }
  }
