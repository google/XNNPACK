$assert REQUANTIZATION in ["FP32", "RNDNU"]
$assert DATATYPE in ["QC8", "QS8"]
$assert DATATYPE != "QC8" or REQUANTIZATION == "FP32"

#include "src/xnnpack/assembly.h"

$DATATYPE_SPEC = {"QC8": "qs8_qc8w", "QS8": "qs8"}[DATATYPE]
$PARAMS_UNION = {"QC8": "xnn_qs8_qc8w_conv_minmax_params", "QS8": "xnn_qs8_conv_minmax_params"}[DATATYPE]
$REWIND_DECREMENT = 3 if DATATYPE == "QC8" else {"RNDNU": 15, "FP32": 7}[REQUANTIZATION]
# void xnn_${DATATYPE_SPEC}_igemm_minmax_${REQUANTIZATION.lower()}_ukernel_1x16c4s2__asm_aarch64_neon_mlal(
#     size_t mr,                 x0
#     size_t nc,                 x1
#     size_t kc,                 x2 / x0
#     size_t ks,                 x3 / x9
#     const int8_t** restrict a, x4
#     const void* restrict w,    x5
#     int8_t* restrict c,        x6
#     size_t cm_stride,          (x7)
#     size_t cn_stride,                  [sp] -> x10
#     size_t a_offset,                   [sp + 8] -> x8
#     const int8_t* zero,                [sp + 16] -> x12
#     const union ${PARAMS_UNION} params [sp + 24] -> x11

# d8-d15, x19-x30 need to be preserved if used. x18 is reserved by the OS.

// Register usage
// A0  x13  v0  v1
// B    x5  v2  v3  v4  v5
// C0   x6  v24 v25 v26 v27 v28 v29 v30 v31
// temp0    v6  v7  v16 v17

BEGIN_FUNCTION xnn_${DATATYPE_SPEC}_igemm_minmax_${REQUANTIZATION.lower()}_ukernel_1x16c4s2__asm_aarch64_neon_mlal
        LDP         x10, x8, [sp]           // Load cn_stride, a_offset
        ADD         x2, x2, 7               // kc = (kc + 7) & ~7
        LDP         x12, x11, [sp, 16]      // Load zero, params pointer
        BIC         x2, x2, 7

        .p2align    3
0:
        # Load initial bias from w into accumulators
        LDP         q0, q1, [x5], 32
        UXTL        v24.2d, v0.2s
        UXTL2       v25.2d, v0.4s
        UXTL        v26.2d, v1.2s
        UXTL2       v27.2d, v1.4s
        LDP         q0, q1, [x5], 32
        UXTL        v28.2d, v0.2s
        UXTL2       v29.2d, v0.4s
        UXTL        v30.2d, v1.2s
        UXTL2       v31.2d, v1.4s
        MOV         x9, x3                  // p = ks

        .p2align    3
1:
        # Load next A pointer
        LDR         x13, [x4], 8
        CMP         x13, x12                // if a0 == zero
        ADD         x13, x13, x8            // a0 += a_offset
        CSEL        x13, x12, x13, EQ       //   a0 = zero, else += a_offset

        SUBS        x0, x2, 16
        B.LO        3f

        .p2align    3
2:
        LDP         d0, d1, [x13], 16
        LDP         d2, d3, [x5]
        LDP         d4, d5, [x5, 128]
        SMULL       v6.8h, v2.8b, v0.8b
        SMULL       v7.8h, v3.8b, v0.8b
        LDP         d2, d3, [x5, 16]
        SMLAL       v6.8h, v4.8b, v1.8b
        SMLAL       v7.8h, v5.8b, v1.8b
        LDP         d4, d5, [x5, 144]
        SADALP      v24.4s, v6.8h
        SADALP      v25.4s, v7.8h
        SMULL       v16.8h, v2.8b, v0.8b
        SMULL       v17.8h, v3.8b, v0.8b
        LDP         d2, d3, [x5, 32]
        SMLAL       v16.8h, v4.8b, v1.8b
        SMLAL       v17.8h, v5.8b, v1.8b
        LDP         d4, d5, [x5, 160]
        SADALP      v26.4s, v16.8h
        SADALP      v27.4s, v17.8h
        SMULL       v6.8h, v2.8b, v0.8b
        SMULL       v7.8h, v3.8b, v0.8b
        LDP         d2, d3, [x5, 48]
        SMLAL       v6.8h, v4.8b, v1.8b
        SMLAL       v7.8h, v5.8b, v1.8b
        LDP         d4, d5, [x5, 176]
        SADALP      v28.4s, v6.8h
        SADALP      v29.4s, v7.8h
        SMULL       v16.8h, v2.8b, v0.8b
        SMULL       v17.8h, v3.8b, v0.8b
        LDP         d2, d3, [x5, 64]
        SMLAL       v16.8h, v4.8b, v1.8b
        SMLAL       v17.8h, v5.8b, v1.8b
        LDP         d4, d5, [x5, 192]
        SADALP      v30.4s, v16.8h
        SADALP      v31.4s, v17.8h
        EXT         v0.8b, v0.8b, v0.8b, 4
        EXT         v1.8b, v1.8b, v1.8b, 4
        SMULL       v6.8h, v2.8b, v0.8b
        SMULL       v7.8h, v3.8b, v0.8b
        LDP         d2, d3, [x5, 80]
        SMLAL       v6.8h, v4.8b, v1.8b
        SMLAL       v7.8h, v5.8b, v1.8b
        LDP         d4, d5, [x5, 208]
        SADALP      v24.4s, v6.8h
        SADALP      v25.4s, v7.8h
        SMULL       v16.8h, v2.8b, v0.8b
        SMULL       v17.8h, v3.8b, v0.8b
        LDP         d2, d3, [x5, 96]
        SMLAL       v16.8h, v4.8b, v1.8b
        SMLAL       v17.8h, v5.8b, v1.8b
        LDP         d4, d5, [x5, 224]
        SADALP      v26.4s, v16.8h
        SADALP      v27.4s, v17.8h
        SMULL       v6.8h, v2.8b, v0.8b
        SMULL       v7.8h, v3.8b, v0.8b
        LDP         d2, d3, [x5, 112]
        SMLAL       v6.8h, v4.8b, v1.8b
        SMLAL       v7.8h, v5.8b, v1.8b
        LDP         d4, d5, [x5, 240]
        SADALP      v28.4s, v6.8h
        SADALP      v29.4s, v7.8h
        SMULL       v16.8h, v2.8b, v0.8b
        SMULL       v17.8h, v3.8b, v0.8b
        SMLAL       v16.8h, v4.8b, v1.8b
        SMLAL       v17.8h, v5.8b, v1.8b
        SADALP      v30.4s, v16.8h
        SADALP      v31.4s, v17.8h
        ADD         x5, x5, 256
        SUBS        x0, x0, 16
        B.HS        2b

        TBZ         x0, 3, 4f

        # Remainder - 8 bytes of A
        .p2align    3
3:
        LDR         d0, [x13]
        LDP         d2, d3, [x5]
        SMULL       v6.8h, v2.8b, v0.8b
        SADALP      v24.4s, v6.8h
        SMULL       v7.8h, v3.8b, v0.8b
        LDP         d2, d3, [x5, 16]
        SADALP      v25.4s, v7.8h
        SMULL       v6.8h, v2.8b, v0.8b
        SADALP      v26.4s, v6.8h
        SMULL       v7.8h, v3.8b, v0.8b
        LDP         d2, d3, [x5, 32]
        SADALP      v27.4s, v7.8h
        SMULL       v6.8h, v2.8b, v0.8b
        SADALP      v28.4s, v6.8h
        SMULL       v7.8h, v3.8b, v0.8b
        LDP         d2, d3, [x5, 48]
        SADALP      v29.4s, v7.8h
        SMULL       v6.8h, v2.8b, v0.8b
        SADALP      v30.4s, v6.8h
        SMULL       v7.8h, v3.8b, v0.8b
        LDP         d2, d3, [x5, 64]
        SADALP      v31.4s, v7.8h
        EXT         v0.8b, v0.8b, v0.8b, 4
        SMULL       v6.8h, v2.8b, v0.8b
        SADALP      v24.4s, v6.8h
        SMULL       v7.8h, v3.8b, v0.8b
        LDP         d2, d3, [x5, 80]
        SADALP      v25.4s, v7.8h
        SMULL       v6.8h, v2.8b, v0.8b
        SADALP      v26.4s, v6.8h
        SMULL       v7.8h, v3.8b, v0.8b
        LDP         d2, d3, [x5, 96]
        SADALP      v27.4s, v7.8h
        SMULL       v6.8h, v2.8b, v0.8b
        SADALP      v28.4s, v6.8h
        SMULL       v7.8h, v3.8b, v0.8b
        LDP         d2, d3, [x5, 112]
        SADALP      v29.4s, v7.8h
        SMULL       v6.8h, v2.8b, v0.8b
        SADALP      v30.4s, v6.8h
        SMULL       v7.8h, v3.8b, v0.8b
        SADALP      v31.4s, v7.8h
        ADD         x5, x5, 128

4:
        # ks loop
        SUBS        x9, x9, 8               // ks -= MR * sizeof(int8_t*)
        B.HI        1b

        ADDP        v24.4s, v24.4s, v25.4s
        ADDP        v26.4s, v26.4s, v27.4s
        ADDP        v28.4s, v28.4s, v29.4s
        ADDP        v30.4s, v30.4s, v31.4s

        $if REQUANTIZATION == "RNDNU":
          LD1R        {v4.4s}, [x11], 4
          LD1R        {v7.4s}, [x11], 4
          LD1R        {v5.4s}, [x11], 4
          SQSHL       v24.4s, v24.4s, v4.4s
          SQSHL       v26.4s, v26.4s, v4.4s
          SQSHL       v28.4s, v28.4s, v4.4s
          SQSHL       v30.4s, v30.4s, v4.4s
          SQDMULH     v24.4s, v24.4s, v7.4s
          SQDMULH     v26.4s, v26.4s, v7.4s
          SQDMULH     v28.4s, v28.4s, v7.4s
          SQDMULH     v30.4s, v30.4s, v7.4s
          SRSHL       v24.4s, v24.4s, v5.4s
          SRSHL       v26.4s, v26.4s, v5.4s
          SRSHL       v28.4s, v28.4s, v5.4s
          SRSHL       v30.4s, v30.4s, v5.4s
        $elif REQUANTIZATION == "FP32":
          SCVTF       v24.4s, v24.4s
          SCVTF       v26.4s, v26.4s
          SCVTF       v28.4s, v28.4s
          SCVTF       v30.4s, v30.4s
          $if DATATYPE == "QC8":
            LDP         q4, q5, [x5], 32
            LDP         q6, q7, [x5], 32
            FMUL        v24.4s, v24.4s, v4.4s
            FMUL        v26.4s, v26.4s, v5.4s
            FMUL        v28.4s, v28.4s, v6.4s
            FMUL        v30.4s, v30.4s, v7.4s
          $else:
            LD1R        {v4.4s}, [x11], 4
            FMUL        v24.4s, v24.4s, v4.4s
            FMUL        v26.4s, v26.4s, v4.4s
            FMUL        v28.4s, v28.4s, v4.4s
            FMUL        v30.4s, v30.4s, v4.4s
          FCVTNS      v24.4s, v24.4s
          FCVTNS      v26.4s, v26.4s
          FCVTNS      v28.4s, v28.4s
          FCVTNS      v30.4s, v30.4s

        LD1R        {v6.8h}, [x11], 2
        SQXTN       v24.4h, v24.4s
        SQXTN2      v24.8h, v26.4s
        SQXTN       v28.4h, v28.4s
        SQXTN2      v28.8h, v30.4s
        SQADD       v24.8h, v24.8h, v6.8h
        SQADD       v28.8h, v28.8h, v6.8h
        LD1R        {v4.16b}, [x11], 1
        LD1R        {v5.16b}, [x11]
        SUB         x11, x11, ${REWIND_DECREMENT}
        SQXTN       v0.8b, v24.8h
        SQXTN2      v0.16b, v28.8h
        SUBS        x1, x1, 16
        SMAX        v0.16b, v0.16b, v4.16b
        SMIN        v0.16b, v0.16b, v5.16b
        B.LO        5f

        # Store full 1 x 16
        ST1         {v0.16b}, [x6], x10
        SUB         x4, x4, x3              // a -= ks
        B.HI        0b
        RET

        # Store odd width
        .p2align    3
5:
        TBZ         x1, 3, 6f
        STR         d0, [x6], 8
        DUP         d0, v0.d[1]
6:
        TBZ         x1, 2, 7f
        STR         s0, [x6], 4
        DUP         s0, v0.s[1]
7:
        TBZ         x1, 1, 8f
        STR         h0, [x6], 2
        DUP         h0, v0.h[1]
8:
        TBZ         x1, 0, 9f
        STR         b0, [x6]
9:
        RET

END_FUNCTION xnn_${DATATYPE_SPEC}_igemm_minmax_${REQUANTIZATION.lower()}_ukernel_1x16c4s2__asm_aarch64_neon_mlal

#ifdef __ELF__
.section ".note.GNU-stack","",%progbits
#endif
