$assert NR % 16 == 0
$assert 16 <= NR <= 64
$assert 1 <= MR <= 16
$assert DATATYPE in ["f16", "f16_f32"]
#include <assert.h>
#include <stddef.h>
#include <stdint.h>
#if defined(__has_feature)
  #if __has_feature(memory_sanitizer)
    #include <sanitizer/msan_interface.h>
  #endif
#endif

#include <immintrin.h>

#include "src/xnnpack/common.h"
#include "src/xnnpack/igemm.h"
#include "src/xnnpack/intrinsics-polyfill.h"
#include "src/xnnpack/math.h"
#include "src/xnnpack/microparams.h"
$if PREFETCH:
  #include "src/xnnpack/prefetch.h"


$DATATYPE_SPEC = {"f16": "f16", "f16_f32": "f16_f32"}[DATATYPE]
$PARAMS_TYPE = {"f16": "struct xnn_f16_minmax_params", "f16_f32": "struct xnn_f32_minmax_params"}[DATATYPE]
$OUT_T = {"f16": "xnn_float16", "f16_f32": "float"}[DATATYPE]
void xnn_${DATATYPE_SPEC}_igemm_minmax_ukernel_${MR}x${NR}c2__avx512amxfp16${"_prfm" if PREFETCH else ""}(
    size_t mr,
    size_t nc,
    size_t kc,
    size_t ks,
    const xnn_float16** restrict a,
    const xnn_float16* restrict w,
    ${OUT_T}* restrict c,
    size_t cm_stride,
    size_t cn_stride,
    size_t a_offset,
    const xnn_float16* zero,
    const ${PARAMS_TYPE}* restrict params)
{
  assert(mr != 0);
  assert(mr <= ${MR});
  assert(nc != 0);
  assert(kc != 0);
  assert(kc % sizeof(xnn_float16) == 0);
  assert(ks != 0);
  assert(ks % (${MR} * sizeof(void*)) == 0);
  assert(a_offset % sizeof(xnn_float16) == 0);
  assert(a != NULL);
  assert(w != NULL);
  assert(c != NULL);

// AMX is only available for __x86_64__
#if XNN_ARCH_X86_64

  // Define tile config data structure
  struct __tile_config {
    uint8_t palette_id;
    uint8_t start_row;
    uint8_t reserved_0[14];
    uint16_t colsb[8];
    uint16_t reserved_1[8];
    uint8_t rows[8];
    uint8_t reserved_2[8];
  };

  XNN_ALIGN(64) struct __tile_config tile_data = {0};
  XNN_ALIGN(64) float res[${NR // 16}][${MR} * 16];
  $if MR > 1:
    XNN_ALIGN(64) int32_t vintile[2][${MR} * 16];

  const size_t kremainder = (kc & 63) ? (kc & 63) : 64;
  const size_t kremainder_colsb = round_up_po2(kremainder, 2 * sizeof(xnn_float16));
  const __mmask32 kremainder_mask = _cvtu32_mask32((uint32_t) ((UINT64_C(1) << (kremainder >> XNN_LOG2_SIZEOF_FLOAT16)) - 1));

  // Load tile configuration
  tile_data.palette_id = 1;
  tile_data.rows[0] = ${1 if MR == 1 else "mr"};              // tmm0 = res[0]
  tile_data.rows[1] = ${1 if MR == 1 else "mr"};              // tmm1 = res[1]
  tile_data.rows[2] = ${1 if MR == 1 else "mr"};              // tmm2 = res[2]
  tile_data.rows[3] = ${1 if MR == 1 else "mr"};              // tmm3 = res[3]
  tile_data.rows[4] = ${1 if MR == 1 else "mr"};              // tmm4 = input
  tile_data.rows[5] = 16;                    // tmm5 = weights
  tile_data.rows[6] = ${1 if MR == 1 else "mr"};              // tmm6 = input remainder
  tile_data.rows[7] = kremainder_colsb >> 2; // tmm7 = weights remainder

  tile_data.colsb[0] = 64;                   // tmm0 = res[0]
  tile_data.colsb[1] = 64;                   // tmm1 = res[1]
  tile_data.colsb[2] = 64;                   // tmm2 = res[2]
  tile_data.colsb[3] = 64;                   // tmm3 = res[3]
  tile_data.colsb[4] = 64;                   // tmm4 = input
  tile_data.colsb[5] = 64;                   // tmm5 = weights
  tile_data.colsb[6] = kremainder_colsb;     // tmm6 = input remainder
  tile_data.colsb[7] = 64;                   // tmm7 = weights remainder

  _tile_loadconfig(&tile_data);

  $if DATATYPE == "f16":
    const __m512 voutput_min = _mm512_cvtph_ps(_mm256_set1_epi16(*(const uint16_t*) &params->scalar.min));
    const __m512 voutput_max = _mm512_cvtph_ps(_mm256_set1_epi16(*(const uint16_t*) &params->scalar.max));
  $else:
    const __m512 voutput_min = _mm512_set1_ps(params->scalar.min);
    const __m512 voutput_max = _mm512_set1_ps(params->scalar.max);

  do {
    $if DATATYPE == "f16":
      $for N in range(0, NR, 16):
        const __m512 vbias${N // 16} = _mm512_cvtph_ps(_mm256_loadu_si256((const __m256i*) ((const xnn_float16*) w + ${N})));
      w = (const xnn_float16*) w + ${NR};
    $else:
      $for N in range(0, NR, 16):
        const __m512 vbias${N // 16} = _mm512_loadu_ps((const float*) w + ${N});
      w = (const xnn_float16*) ((const float*) w + ${NR});

    // Zero tile accumulator
    $for N in range(0, NR, 16):
      _tile_zero(${N // 16});

    size_t p = ks;
    do {
      const xnn_float16* restrict a0 = a[0];
      assert(a0 != NULL);
      if XNN_UNPREDICTABLE(a0 != zero) {
        a0 = (const xnn_float16*) ((uintptr_t) a0 + a_offset);
      }

      size_t k = kc;
      $if MR == 1:
        a += 1;
        while (k >= 32 * sizeof(xnn_float16)) {
          _tile_loadd(4, a0, 64);
          a0 += 32;
          $for N in range(0, NR, 16):
            $if N == 0:
              _tile_loadd(5, (const int8_t*) w + ${N * 4}, ${NR * 4});
              _tile_dpfp16ps(${N // 16}, 4, 5);
            $else:
              if XNN_LIKELY(nc > ${N}) {
                _tile_loadd(5, (const int8_t*) w + ${N * 4}, ${NR * 4});
                _tile_dpfp16ps(${N // 16}, 4, 5);
              }
          $if PREFETCH:
            $for P in range(4096, 5120 + NR // 16 * 1024, 64):
              xnn_prefetch_to_l1((const int8_t*) w + ${P});

          w = (const xnn_float16*) ((const int8_t*) w + ${NR // 16 * 1024});
          k -= 32 * sizeof(xnn_float16);
        }
        if XNN_UNLIKELY(k != 0) {
          const __m512i vin0 = _mm512_maskz_loadu_epi16(kremainder_mask, a0);
          _mm512_store_epi32(&res[0][0], vin0);
          _tile_loadd(6, &res[0][0], 64);
          $for N in range(0, NR, 16):
            $if N == 0:
              _tile_loadd(7, (const int8_t*) w + ${N * 4}, ${NR * 4});
              _tile_dpfp16ps(${N // 16}, 6, 7);
            $else:
              if XNN_LIKELY(nc > ${N}) {
                _tile_loadd(7, (const int8_t*) w + ${N * 4}, ${NR * 4});
                _tile_dpfp16ps(${N // 16}, 6, 7);
              }

          w = (const xnn_float16*) ((const int8_t*) w + kremainder_colsb * ${NR});
          k -= kremainder;
        }
      $else:
        const xnn_float16* restrict a1 = a[1];
        assert(a1 != NULL);
        if XNN_UNPREDICTABLE(a1 != zero) {
          a1 = (const xnn_float16*) ((uintptr_t) a1 + a_offset);
        }

        if (mr <= 2) {
          a += ${MR};
          const intptr_t a_stride = (intptr_t) a1 - (intptr_t) a0;
          while (k >= 32 * sizeof(xnn_float16)) {
            _tile_loadd(4, a0, a_stride);
            a0 += 32;
            $for N in range(0, NR, 16):
              $if N == 0:
                _tile_loadd(5, (const int8_t*) w + ${N * 4}, ${NR * 4});
                _tile_dpfp16ps(${N // 16}, 4, 5);
              $else:
                if XNN_LIKELY(nc > ${N}) {
                  _tile_loadd(5, (const int8_t*) w + ${N * 4}, ${NR * 4});
                  _tile_dpfp16ps(${N // 16}, 4, 5);
                }
            $if PREFETCH:
              $for P in range(4096, 5120 + NR // 16 * 1024, 64):
                xnn_prefetch_to_l1((const int8_t*) w + ${P});

            w = (const xnn_float16*) ((const int8_t*) w + ${NR // 16 * 1024});
            k -= 32 * sizeof(xnn_float16);
          }
          if XNN_UNLIKELY(k != 0) {
            const __m512i vin0 = _mm512_maskz_loadu_epi16(kremainder_mask, a0);
            const __m512i vin1 = _mm512_maskz_loadu_epi16(kremainder_mask, (const void*) ((intptr_t) a0 + a_stride));
            _mm512_store_epi32(&vintile[0][0], vin0);
            _mm512_store_epi32(&vintile[0][16], vin1);
            _tile_loadd(6, &vintile[0][0], 64);
            $for N in range(0, NR, 16):
              $if N == 0:
                _tile_loadd(7, (const int8_t*) w + ${N * 4}, ${NR * 4});
                _tile_dpfp16ps(${N // 16}, 6, 7);
              $else:
                if XNN_LIKELY(nc > ${N}) {
                  _tile_loadd(7, (const int8_t*) w + ${N * 4}, ${NR * 4});
                  _tile_dpfp16ps(${N // 16}, 6, 7);
                }

            w = (const xnn_float16*) ((const int8_t*) w + kremainder_colsb * ${NR});
            k -= kremainder;
          }
        } else {
          $for M in range(2, MR):
            const xnn_float16* restrict a${M} = a[${M}];
            assert(a${M} != NULL);
            if XNN_UNPREDICTABLE(a${M} != zero) {
              a${M} = (const xnn_float16*) ((uintptr_t) a${M} + a_offset);
            }
          a += ${MR};

          size_t buf_idx = 0;
          while (k >= 32 * sizeof(xnn_float16)) {
            $for M in range(MR):
              const __m512i vin${M} = _mm512_loadu_epi32(a${M});
              a${M} += 32;
              _mm512_store_epi32(&vintile[buf_idx][${M * 16}], vin${M});
            _tile_loadd(4, &vintile[buf_idx][0], 64);
            buf_idx ^= 1;
            $for N in range(0, NR, 16):
              $if N == 0:
                _tile_loadd(5, (const int8_t*) w + ${N * 4}, ${NR * 4});
                _tile_dpfp16ps(${N // 16}, 4, 5);
              $else:
                if XNN_LIKELY(nc > ${N}) {
                  _tile_loadd(5, (const int8_t*) w + ${N * 4}, ${NR * 4});
                  _tile_dpfp16ps(${N // 16}, 4, 5);
                }
            $if PREFETCH:
              $for P in range(4096, 5120 + NR // 16 * 1024, 64):
                xnn_prefetch_to_l1((const int8_t*) w + ${P});

            w = (const xnn_float16*) ((const int8_t*) w + ${NR // 16 * 1024});
            k -= 32 * sizeof(xnn_float16);
          }
          if XNN_UNLIKELY(k != 0) {
            $for M in range(MR):
              const __m512i vin${M} = _mm512_maskz_loadu_epi16(kremainder_mask, a${M});
              a${M} = (const xnn_float16*) ((uintptr_t) a${M} + kremainder);
              _mm512_store_epi32(&vintile[buf_idx][${M * 16}], vin${M});
            _tile_loadd(6, &vintile[buf_idx][0], 64);
            $for N in range(0, NR, 16):
              $if N == 0:
                _tile_loadd(7, (const int8_t*) w + ${N * 4}, ${NR * 4});
                _tile_dpfp16ps(${N // 16}, 6, 7);
              $else:
                if XNN_LIKELY(nc > ${N}) {
                  _tile_loadd(7, (const int8_t*) w + ${N * 4}, ${NR * 4});
                  _tile_dpfp16ps(${N // 16}, 6, 7);
                }

            w = (const xnn_float16*) ((const int8_t*) w + kremainder_colsb * ${NR});
            k -= kremainder;
          }
        }

      p -= ${MR} * sizeof(void*);
    } while (p != 0);

    // TODO: Instead of processing up to 4 tiles (16x64) consider
    // quantizing 1 tile at a time (16 registers)
    $for N in range(0, NR, 16):
      $if N == 0:
        _tile_stored(${N // 16}, &res[${N // 16}][0], 64);
      $else:
        if XNN_LIKELY(nc > ${N}) {
          _tile_stored(${N // 16}, &res[${N // 16}][0], 64);
        }

    // TODO: Fix msan for AMX
    #if defined(__has_feature)
      #if __has_feature(memory_sanitizer)
        __msan_unpoison(res, sizeof(res));
      #endif
    #endif

    ${OUT_T}* c0 = c;
    $if MR > 1:
      for (size_t m = 0; m < mr; ++m)
    {
      $ROW_OFFSET = "" if MR == 1 else " + m * 16"
      if XNN_LIKELY(nc >= ${NR}) {
        $for N in range(0, NR, 16):
          __m512 vacc${N // 16} = _mm512_add_ps(_mm512_load_ps(&res[${N // 16}][0]${ROW_OFFSET}), vbias${N // 16});
        $for N in range(0, NR, 16):
          vacc${N // 16} = _mm512_max_ps(vacc${N // 16}, voutput_min);
        $for N in range(0, NR, 16):
          vacc${N // 16} = _mm512_min_ps(vacc${N // 16}, voutput_max);
        $if DATATYPE == "f16":
          $for N in range(0, NR, 16):
            __m256i vfp16out${N // 16} = _mm512_cvtps_ph(vacc${N // 16}, _MM_FROUND_TO_NEAREST_INT);
          $for N in range(0, NR, 16):
            _mm256_storeu_si256((__m256i*) (c0 + ${N}), vfp16out${N // 16});
        $else:
          $for N in range(0, NR, 16):
            _mm512_storeu_ps(c0 + ${N}, vacc${N // 16});
      } else {
        $for N in range(0, NR, 16):
          $if N > 0:
            if (nc > ${N}) {
          __m512 vacc${N // 16} = _mm512_add_ps(_mm512_load_ps(&res[${N // 16}][0]${ROW_OFFSET}), vbias${N // 16});
          vacc${N // 16} = _mm512_max_ps(vacc${N // 16}, voutput_min);
          vacc${N // 16} = _mm512_min_ps(vacc${N // 16}, voutput_max);
          const __mmask16 vmask${N // 16} = _cvtu32_mask16((uint32_t) ((((UINT64_C(1) << nc) - 1) >> ${N}) & 0xFFFF));
          $if DATATYPE == "f16":
            __m256i vfp16out${N // 16} = _mm512_cvtps_ph(vacc${N // 16}, _MM_FROUND_TO_NEAREST_INT);
            _mm256_mask_storeu_epi16(c0 + ${N}, vmask${N // 16}, vfp16out${N // 16});
          $else:
            _mm512_mask_storeu_ps(c0 + ${N}, vmask${N // 16}, vacc${N // 16});
          $if N > 0:
            }
      }
      $if MR > 1:
        c0 = (${OUT_T}*) ((uintptr_t) c0 + cm_stride);
    }
    if XNN_LIKELY(nc >= ${NR}) {
      c = (${OUT_T}*) ((uintptr_t) c + cn_stride);
      a = (const xnn_float16** restrict) ((uintptr_t) a - ks);
      nc -= ${NR};
    } else {
      nc = 0;
    }
  } while (nc != 0);

  // Release tile config
  _tile_release();
  #endif  // defined(__x86_64__)
}
