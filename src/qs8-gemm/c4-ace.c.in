$assert NR in [16, 32, 64]
$assert MR in [1, 16]
$assert DATATYPE == "QD8_F32"
#include <assert.h>
#include <stddef.h>
#include <stdint.h>

#include <immintrin.h>

#include "src/xnnpack/ace.h"
#include "src/xnnpack/common.h"
#include "src/xnnpack/gemm.h"
#include "src/xnnpack/intrinsics-polyfill.h"
#include "src/xnnpack/microparams.h"
#include "src/xnnpack/unaligned.h"


void xnn_qd8_f32_qc8w_gemm_minmax_ukernel_${MR}x${NR}c4__ace(
    size_t mr,
    size_t nc,
    size_t kc,
    const int8_t* restrict a,
    size_t a_stride,
    const void* restrict w,
    float* restrict c,
    size_t cm_stride,
    size_t cn_stride,
    const struct xnn_f32_minmax_params* restrict params,
    const struct xnn_qd8_quantization_params* restrict quantization_params)
{
  assert(mr != 0);
  assert(mr <= ${MR});
  assert(nc != 0);
  assert(kc != 0);
  assert(kc % sizeof(int8_t) == 0);
  assert(a != NULL);
  assert(w != NULL);
  assert(c != NULL);

#if XNN_ARCH_X86_64
  const __m512 voutput_min = _mm512_set1_ps(params->scalar.min);
  const __m512 voutput_max = _mm512_set1_ps(params->scalar.max);

  $if MR == 1:
    (void) mr;
    (void) a_stride;
    (void) cm_stride;
    const __m512i vzero_point = _mm512_set1_epi32((int) quantization_params[0].zero_point);
    const __m512 vinv_scale = _mm512_set1_ps(quantization_params[0].inv_scale);

    do {
      $for N in range(0, NR, 16):
        const __m512i vksum${N // 16} = _mm512_loadu_epi32((const int32_t*) w + ${N});
      w = (const int32_t*) w + ${NR};

      $for N in range(0, NR, 16):
        __m512i vacc${N // 16} = _mm512_mullo_epi32(vksum${N // 16}, vzero_point);

      size_t k = 0;
      for (; k + 4 * sizeof(int8_t) <= kc; k += 4 * sizeof(int8_t)) {
        const __m512i va = _mm512_set1_epi32(unaligned_load_s32(a + k));
        const __m512i vb0 = _mm512_loadu_epi32((const int8_t*) w);
        vacc0 = xnn_avx10_dpbssd_epi32_t0(vacc0, va, vb0);
        $for N in range(16, NR, 16):
          if XNN_LIKELY(nc > ${N}) {
            const __m512i vb${N // 16} = _mm512_loadu_epi32((const int8_t*) w + ${N * 4});
            vacc${N // 16} = xnn_avx10_dpbssd_epi32_t${N // 16}(vacc${N // 16}, va, vb${N // 16});
          }
        w = (const int8_t*) w + ${NR * 4};
      }
      if XNN_UNLIKELY(k < kc) {
        const __mmask16 vkmask = _cvtu32_mask16((UINT32_C(1) << (kc - k)) - UINT32_C(1));
        const __m512i va = _mm512_set1_epi32(_mm_cvtsi128_si32(_mm_maskz_loadu_epi8(vkmask, a + k)));
        const __m512i vb0 = _mm512_loadu_epi32((const int8_t*) w);
        vacc0 = xnn_avx10_dpbssd_epi32_t0(vacc0, va, vb0);
        $for N in range(16, NR, 16):
          if XNN_LIKELY(nc > ${N}) {
            const __m512i vb${N // 16} = _mm512_loadu_epi32((const int8_t*) w + ${N * 4});
            vacc${N // 16} = xnn_avx10_dpbssd_epi32_t${N // 16}(vacc${N // 16}, va, vb${N // 16});
          }
        w = (const int8_t*) w + ${NR * 4};
      }

      $for N in range(0, NR, 16):
        const __m512 vfilter_output_scale${N // 16} = _mm512_loadu_ps((const float*) w + ${N});
      w = (const int32_t*) w + ${NR};
      $for N in range(0, NR, 16):
        const __m512 vbias${N // 16} = _mm512_loadu_ps((const float*) w + ${N});
      w = (const int32_t*) w + ${NR};

      $for N in range(0, NR, 16):
        __m512 vscaled${N // 16} = _mm512_cvtepi32_ps(vacc${N // 16});
      $for N in range(0, NR, 16):
        vscaled${N // 16} = _mm512_mul_ps(vscaled${N // 16}, vinv_scale);
      $for N in range(0, NR, 16):
        vscaled${N // 16} = _mm512_fmadd_ps(vscaled${N // 16}, vfilter_output_scale${N // 16}, vbias${N // 16});
      $for N in range(0, NR, 16):
        vscaled${N // 16} = _mm512_max_ps(vscaled${N // 16}, voutput_min);
      $for N in range(0, NR, 16):
        vscaled${N // 16} = _mm512_min_ps(vscaled${N // 16}, voutput_max);

      if XNN_LIKELY(nc >= ${NR}) {
        $for N in range(0, NR, 16):
          _mm512_storeu_ps(c + ${N}, vscaled${N // 16});
        c = (float*) ((uintptr_t) c + cn_stride);
        nc -= ${NR};
      } else {
        $for N in range(0, NR, 16):
          $if N > 0:
            if (nc > ${N}) {
          const __mmask16 vmask${N // 16} = _cvtu32_mask16((uint32_t) ((((UINT64_C(1) << nc) - UINT64_C(1)) >> ${N}) & 0xFFFF));
          _mm512_mask_storeu_ps(c + ${N}, vmask${N // 16}, vscaled${N // 16});
          $if N > 0:
            }
        nc = 0;
      }
    } while (nc != 0);
  $else:
    const int8_t* a0 = a;
    $for M in range(1, MR):
      const int8_t* a${M} = (const int8_t*) ((uintptr_t) a${M - 1} + a_stride);
      $if M % 2 == 0:
        if XNN_UNPREDICTABLE(mr <= ${M}) {
          a${M} = a${M - 1};
        }
      $elif M + 1 == MR:
        if XNN_UNPREDICTABLE(mr != ${M + 1}) {
          a${M} = a${M - 1};
        }
      $else:
        if XNN_UNPREDICTABLE(mr < ${M + 1}) {
          a${M} = a${M - 1};
        }

    xnn_ace_load_palette2_config();

    do {
      $for N in range(0, NR, 16):
        const __m512i vksum${N // 16} = _mm512_loadu_epi32((const int32_t*) w + ${N});
      w = (const int32_t*) w + ${NR};

      $for N in range(0, NR, 16):
        _tile_zero(${N // 16});

      size_t k = 0;
      for (; k + 64 * sizeof(int8_t) <= kc; k += 64 * sizeof(int8_t)) {
        $for M in range(MR):
          xnn_ace_tilemovcol_tmm7(_mm512_loadu_si512((const __m512i*) (a${M} + k)), ${M});
        $for K_STEP in range(16):
          {
            const __m512i va = xnn_ace_tilemovrow_imm_tmm7(${K_STEP});
            const __m512i vb0 = _mm512_loadu_epi32((const int8_t*) w + ${K_STEP * NR * 4});
            xnn_ace_top4bssd_tmm0(va, vb0);
            $for N in range(16, NR, 16):
              if XNN_LIKELY(nc > ${N}) {
                const __m512i vb${N // 16} = _mm512_loadu_epi32((const int8_t*) w + ${K_STEP * NR * 4 + N * 4});
                xnn_ace_top4bssd_tmm${N // 16}(va, vb${N // 16});
              }
          }
        w = (const int8_t*) w + ${16 * NR * 4};
      }
      if XNN_UNLIKELY(k < kc) {
        const __mmask64 vkmask = _cvtu64_mask64((UINT64_C(1) << (kc - k)) - UINT64_C(1));
        $for M in range(MR):
          xnn_ace_tilemovcol_tmm7(_mm512_maskz_loadu_epi8(vkmask, a${M} + k), ${M});
        for (uint32_t k_step = 0; k < kc; k += 4 * sizeof(int8_t), ++k_step) {
          const __m512i va = xnn_ace_tilemovrow_tmm7(k_step);
          const __m512i vb0 = _mm512_loadu_epi32((const int8_t*) w);
          xnn_ace_top4bssd_tmm0(va, vb0);
          $for N in range(16, NR, 16):
            if XNN_LIKELY(nc > ${N}) {
              const __m512i vb${N // 16} = _mm512_loadu_epi32((const int8_t*) w + ${N * 4});
              xnn_ace_top4bssd_tmm${N // 16}(va, vb${N // 16});
            }
          w = (const int8_t*) w + ${NR * 4};
        }
      }

      $for N in range(0, NR, 16):
        const __m512 vfilter_output_scale${N // 16} = _mm512_loadu_ps((const float*) w + ${N});
      w = (const int32_t*) w + ${NR};
      $for N in range(0, NR, 16):
        const __m512 vbias${N // 16} = _mm512_loadu_ps((const float*) w + ${N});
      w = (const int32_t*) w + ${NR};

      float* c0 = c;
      for (size_t m = 0; m < mr; ++m) {
        const __m512i vzero_point = _mm512_set1_epi32((int) quantization_params[m].zero_point);
        const __m512 vinv_scale = _mm512_set1_ps(quantization_params[m].inv_scale);
        if XNN_LIKELY(nc >= ${NR}) {
          $for N in range(0, NR, 16):
            __m512i vacc${N // 16} = _mm512_mullo_epi32(vksum${N // 16}, vzero_point);
          $for N in range(0, NR, 16):
            vacc${N // 16} = _mm512_add_epi32(vacc${N // 16}, xnn_ace_tilemovrow_tmm${N // 16}((uint32_t) m));
          $for N in range(0, NR, 16):
            __m512 vscaled${N // 16} = _mm512_cvtepi32_ps(vacc${N // 16});
          $for N in range(0, NR, 16):
            vscaled${N // 16} = _mm512_mul_ps(vscaled${N // 16}, vinv_scale);
          $for N in range(0, NR, 16):
            vscaled${N // 16} = _mm512_fmadd_ps(vscaled${N // 16}, vfilter_output_scale${N // 16}, vbias${N // 16});
          $for N in range(0, NR, 16):
            vscaled${N // 16} = _mm512_max_ps(vscaled${N // 16}, voutput_min);
          $for N in range(0, NR, 16):
            vscaled${N // 16} = _mm512_min_ps(vscaled${N // 16}, voutput_max);
          $for N in range(0, NR, 16):
            _mm512_storeu_ps(c0 + ${N}, vscaled${N // 16});
        } else {
          $for N in range(0, NR, 16):
            $if N > 0:
              if (nc > ${N}) {
            __m512i vacc${N // 16} = _mm512_mullo_epi32(vksum${N // 16}, vzero_point);
            vacc${N // 16} = _mm512_add_epi32(vacc${N // 16}, xnn_ace_tilemovrow_tmm${N // 16}((uint32_t) m));
            __m512 vscaled${N // 16} = _mm512_cvtepi32_ps(vacc${N // 16});
            vscaled${N // 16} = _mm512_mul_ps(vscaled${N // 16}, vinv_scale);
            vscaled${N // 16} = _mm512_fmadd_ps(vscaled${N // 16}, vfilter_output_scale${N // 16}, vbias${N // 16});
            vscaled${N // 16} = _mm512_max_ps(vscaled${N // 16}, voutput_min);
            vscaled${N // 16} = _mm512_min_ps(vscaled${N // 16}, voutput_max);
            const __mmask16 vmask${N // 16} = _cvtu32_mask16((uint32_t) ((((UINT64_C(1) << nc) - UINT64_C(1)) >> ${N}) & 0xFFFF));
            _mm512_mask_storeu_ps(c0 + ${N}, vmask${N // 16}, vscaled${N // 16});
            $if N > 0:
              }
        }
        c0 = (float*) ((uintptr_t) c0 + cm_stride);
      }

      if XNN_LIKELY(nc >= ${NR}) {
        c = (float*) ((uintptr_t) c + cn_stride);
        nc -= ${NR};
      } else {
        nc = 0;
      }
    } while (nc != 0);

    _tile_release();
#else
  (void) mr;
  (void) nc;
  (void) kc;
  (void) a;
  (void) a_stride;
  (void) w;
  (void) c;
  (void) cm_stride;
  (void) cn_stride;
  (void) params;
  (void) quantization_params;
#endif  // XNN_ARCH_X86_64
}
