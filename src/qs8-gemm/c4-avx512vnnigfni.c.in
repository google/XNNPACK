$assert NR % 16 == 0
$assert 16 <= NR <= 64
$assert 1 <= MR <= 8
$assert REQUANTIZATION == "FP32" or not REQUANTIZATION
$assert DATATYPE in ["QC2_F32", "QC2_F16"]
$assert GFNI in [0, 1]
#include <assert.h>
#include <stddef.h>
#include <stdint.h>

#include <immintrin.h>

#include "src/xnnpack/common.h"
#include "src/xnnpack/gemm.h"
#include "src/xnnpack/intrinsics-polyfill.h"
#include "src/xnnpack/math.h"
#include "src/xnnpack/microparams.h"
$if PREFETCH:
  #include "src/xnnpack/prefetch.h"
#include "src/xnnpack/unaligned.h"


$DATATYPE_SPEC = {"QC2_F32": "qd8_f32_qc2w", "QC2_F16": "qd8_f16_qc2w"}[DATATYPE]
$PARAMS_TYPE = {"QC2_F32": "struct xnn_f32_minmax_params", "QC2_F16": "struct xnn_f16_minmax_params"}[DATATYPE]
$OUT_T = {"QC2_F32": "float", "QC2_F16": "xnn_float16"}[DATATYPE]
$SPLIT_ACC = 1 if MR * (NR // 16) <= 8 else 0
void xnn_${DATATYPE_SPEC}_gemm_minmax_ukernel_${MR}x${NR}c4__avx512vnni${"gfni" if GFNI else ""}${"_prfm" if PREFETCH else ""}(
    size_t mr,
    size_t nc,
    size_t kc,
    const int8_t* restrict a,
    size_t a_stride,
    const void* restrict w,
    ${OUT_T}* restrict c,
    size_t cm_stride,
    size_t cn_stride,
    const ${PARAMS_TYPE}* restrict params,
    const float* row_sum,
    const struct xnn_qd8_quantization_params* restrict quantization_params) XNN_OOB_READS
{
  assert(mr != 0);
  assert(mr <= ${MR});
  assert(nc != 0);
  assert(kc != 0);
  assert(kc % sizeof(int8_t) == 0);
  assert(a != NULL);
  assert(w != NULL);
  assert(c != NULL);
  assert(row_sum != NULL);

  kc = round_up_po2(kc, 4 * sizeof(int8_t));
  const int8_t* a0 = a;
  $if DATATYPE == "QC2_F16":
    uint16_t* c0 = (uint16_t*) c;
  $else:
    float* c0 = c;
  $for M in range(1, MR):
    const int8_t* a${M} = (const int8_t*) ((uintptr_t) a${M-1} + a_stride);
    $if DATATYPE == "QC2_F16":
      uint16_t* c${M} = (uint16_t*) ((uintptr_t) c${M-1} + cm_stride);
    $else:
      float* c${M} = (float*) ((uintptr_t) c${M-1} + cm_stride);
    $if M % 2 == 0:
      if XNN_UNPREDICTABLE(mr <= ${M}) {
        a${M} = a${M-1};
        c${M} = c${M-1};
      }
    $elif M + 1 == MR:
      if XNN_UNPREDICTABLE(mr != ${M+1}) {
        a${M} = a${M-1};
        c${M} = c${M-1};
      }
    $else:
      if XNN_UNPREDICTABLE(mr < ${M+1}) {
        a${M} = a${M-1};
        c${M} = c${M-1};
      }

  $if DATATYPE == "QC2_F16":
    const __m512 voutput_min = _mm512_cvtph_ps(_mm256_set1_epi16(*(const uint16_t*) &params->scalar.min));
    const __m512 voutput_max = _mm512_cvtph_ps(_mm256_set1_epi16(*(const uint16_t*) &params->scalar.max));
  $else:
    const __m512 voutput_min = _mm512_set1_ps(params->scalar.min);
    const __m512 voutput_max = _mm512_set1_ps(params->scalar.max);

  const __m512i vmask = _mm512_set1_epi8(0x03);
  $if GFNI:
    const __m512i vshr2 = _mm512_set1_epi64(0x0408000000000000);
    const __m512i vshr4 = _mm512_set1_epi64(0x1020000000000000);
    const __m512i vshr6 = _mm512_set1_epi64(0x4080000000000000);
  const __m512 vtwo = _mm512_set1_ps(2.0f);
  $for M in range(MR):
    const __m512i vinput_zero_point${M} = _mm512_set1_epi32((int) quantization_params[${M}].zero_point);
    const __m512 vlh_row_sum_${M} = _mm512_set1_ps(row_sum[${M}]);
    const __m512 vscaled_lh_zero_point_${M} = _mm512_set1_ps((float) kc * quantization_params[${M}].zero_point);
    const __m512 vinv_scale_${M} = _mm512_set1_ps(quantization_params[${M}].inv_scale);

  do {
    const int32_t* ksum = (const int32_t*) w;
    w = (const int32_t*) w + ${NR};
    const float* kzp = (const float*) w;
    w = (const float*) w + ${NR};
    $for M in range(MR):
      $for N in range(0, NR, 16):
        __m512i vacc${M}x${N//16} = _mm512_setzero_epi32();
    $if SPLIT_ACC:
      $for M in range(MR):
        $for N in range(0, NR, 16):
          __m512i vacc1x${M}x${N//16} = _mm512_setzero_epi32();

    size_t k = kc;
    while (k >= 16 * sizeof(int8_t)) {
      $for N in range(0, NR, 16):
        const __m512i vbb${N//16} = _mm512_load_si512((const int8_t*) w + ${N * 4});

      $for N in range(0, NR, 16):
        const __m512i vb${N//16}x0 = _mm512_and_si512(vbb${N//16}, vmask);
      $for M in range(MR):
        const __m512i va${M}x0 = _mm512_set1_epi32((int) unaligned_load_u32(a${M}));
        $for N in range(0, NR, 16):
          vacc${M}x${N//16} = _mm512_dpbusd_epi32(vacc${M}x${N//16}, vb${N//16}x0, va${M}x0);

      $for N in range(0, NR, 16):
        $if GFNI:
          const __m512i vb${N//16}x1 = _mm512_gf2p8affine_epi64_epi8(vbb${N//16}, vshr2, 0);
        $else:
          const __m512i vb${N//16}x1 = _mm512_and_si512(_mm512_srli_epi32(vbb${N//16}, 2), vmask);
      $for M in range(MR):
        const __m512i va${M}x1 = _mm512_set1_epi32((int) unaligned_load_u32(a${M} + 4));
        $for N in range(0, NR, 16):
          $if SPLIT_ACC:
            vacc1x${M}x${N//16} = _mm512_dpbusd_epi32(vacc1x${M}x${N//16}, vb${N//16}x1, va${M}x1);
          $else:
            vacc${M}x${N//16} = _mm512_dpbusd_epi32(vacc${M}x${N//16}, vb${N//16}x1, va${M}x1);

      $if PREFETCH:
        $for P in range(6 * NR * 4, 7 * NR * 4, 64):
          xnn_prefetch_to_l1((const int8_t*) w + ${P});

      $for N in range(0, NR, 16):
        $if GFNI:
          const __m512i vb${N//16}x2 = _mm512_gf2p8affine_epi64_epi8(vbb${N//16}, vshr4, 0);
        $else:
          const __m512i vb${N//16}x2 = _mm512_and_si512(_mm512_srli_epi32(vbb${N//16}, 4), vmask);
      $for M in range(MR):
        const __m512i va${M}x2 = _mm512_set1_epi32((int) unaligned_load_u32(a${M} + 8));
        $for N in range(0, NR, 16):
          vacc${M}x${N//16} = _mm512_dpbusd_epi32(vacc${M}x${N//16}, vb${N//16}x2, va${M}x2);

      $for N in range(0, NR, 16):
        $if GFNI:
          const __m512i vb${N//16}x3 = _mm512_gf2p8affine_epi64_epi8(vbb${N//16}, vshr6, 0);
        $else:
          const __m512i vb${N//16}x3 = _mm512_and_si512(_mm512_srli_epi32(vbb${N//16}, 6), vmask);
      $for M in range(MR):
        const __m512i va${M}x3 = _mm512_set1_epi32((int) unaligned_load_u32(a${M} + 12));
        a${M} += 16;
        $for N in range(0, NR, 16):
          $if SPLIT_ACC:
            vacc1x${M}x${N//16} = _mm512_dpbusd_epi32(vacc1x${M}x${N//16}, vb${N//16}x3, va${M}x3);
          $else:
            vacc${M}x${N//16} = _mm512_dpbusd_epi32(vacc${M}x${N//16}, vb${N//16}x3, va${M}x3);

      w = (const int8_t*) w + ${NR * 4};
      k -= 16 * sizeof(int8_t);
    }

    if XNN_UNLIKELY(k != 0) {
      $for N in range(0, NR, 16):
        const __m512i vbb${N//16} = _mm512_load_si512((const int8_t*) w + ${N * 4});
      $for N in range(0, NR, 16):
        const __m512i vb${N//16}x0 = _mm512_and_si512(vbb${N//16}, vmask);
      $for M in range(MR):
        const __m512i va${M}x0 = _mm512_set1_epi32((int) unaligned_load_u32(a${M}));
        a${M} += 4;
        $for N in range(0, NR, 16):
          vacc${M}x${N//16} = _mm512_dpbusd_epi32(vacc${M}x${N//16}, vb${N//16}x0, va${M}x0);

      if (k > 4 * sizeof(int8_t)) {
        $for N in range(0, NR, 16):
          $if GFNI:
            const __m512i vb${N//16}x1 = _mm512_gf2p8affine_epi64_epi8(vbb${N//16}, vshr2, 0);
          $else:
            const __m512i vb${N//16}x1 = _mm512_and_si512(_mm512_srli_epi32(vbb${N//16}, 2), vmask);
        $for M in range(MR):
          const __m512i va${M}x1 = _mm512_set1_epi32((int) unaligned_load_u32(a${M}));
          a${M} += 4;
          $for N in range(0, NR, 16):
            $if SPLIT_ACC:
              vacc1x${M}x${N//16} = _mm512_dpbusd_epi32(vacc1x${M}x${N//16}, vb${N//16}x1, va${M}x1);
            $else:
              vacc${M}x${N//16} = _mm512_dpbusd_epi32(vacc${M}x${N//16}, vb${N//16}x1, va${M}x1);

        if (k > 8 * sizeof(int8_t)) {
          $for N in range(0, NR, 16):
            $if GFNI:
              const __m512i vb${N//16}x2 = _mm512_gf2p8affine_epi64_epi8(vbb${N//16}, vshr4, 0);
            $else:
              const __m512i vb${N//16}x2 = _mm512_and_si512(_mm512_srli_epi32(vbb${N//16}, 4), vmask);
          $for M in range(MR):
            const __m512i va${M}x2 = _mm512_set1_epi32((int) unaligned_load_u32(a${M}));
            a${M} += 4;
            $for N in range(0, NR, 16):
              vacc${M}x${N//16} = _mm512_dpbusd_epi32(vacc${M}x${N//16}, vb${N//16}x2, va${M}x2);
        }
      }
      w = (const int8_t*) w + ${NR * 4};
    }

    $if SPLIT_ACC:
      $for M in range(MR):
        $for N in range(0, NR, 16):
          vacc${M}x${N//16} = _mm512_add_epi32(vacc${M}x${N//16}, vacc1x${M}x${N//16});

    $for N in range(0, NR, 16):
      const __m512i vksum${N//16} = _mm512_load_epi32(ksum + ${N});
    $for M in range(MR):
      $for N in range(0, NR, 16):
        vacc${M}x${N//16} = _mm512_add_epi32(vacc${M}x${N//16}, _mm512_mullo_epi32(vksum${N//16}, vinput_zero_point${M}));

    $for M in range(MR):
      $for N in range(0, NR, 16):
        __m512 vscaled${M}x${N//16} = _mm512_cvtepi32_ps(vacc${M}x${N//16});

    $for N in range(0, NR, 16):
      const __m512 rh_zero_points_${N//16} = _mm512_load_ps(kzp + ${N});
      const __m512 biased_rh_zero_points_${N//16} = _mm512_add_ps(rh_zero_points_${N//16}, vtwo);

    $for M in range(MR):
      $for N in range(0, NR, 16):
        vscaled${M}x${N//16} = _mm512_fnmadd_ps(biased_rh_zero_points_${N//16}, vlh_row_sum_${M}, vscaled${M}x${N//16});

    $for M in range(MR):
      $for N in range(0, NR, 16):
        vscaled${M}x${N//16} = _mm512_fmadd_ps(rh_zero_points_${N//16}, vscaled_lh_zero_point_${M}, vscaled${M}x${N//16});

    $for M in range(MR):
      $for N in range(0, NR, 16):
        vscaled${M}x${N//16} = _mm512_mul_ps(vscaled${M}x${N//16}, vinv_scale_${M});

    $for N in range(0, NR, 16):
      const __m512 vfilter_output_scale${N//16} = _mm512_load_ps((const float*) w + ${N});
    w = (const float*) w + ${NR};
    $for N in range(0, NR, 16):
      const __m512 vbias${N//16} = _mm512_load_ps((const float*) w + ${N});
    w = (const float*) w + ${NR};

    $for M in range(MR):
      $for N in range(0, NR, 16):
        vscaled${M}x${N//16} = _mm512_fmadd_ps(vscaled${M}x${N//16}, vfilter_output_scale${N//16}, vbias${N//16});

    $for M in range(MR):
      $for N in range(0, NR, 16):
        vscaled${M}x${N//16} = _mm512_max_ps(vscaled${M}x${N//16}, voutput_min);

    $for M in range(MR):
      $for N in range(0, NR, 16):
        vscaled${M}x${N//16} = _mm512_min_ps(vscaled${M}x${N//16}, voutput_max);

    if XNN_LIKELY(nc >= ${NR}) {
      $if DATATYPE == "QC2_F16":
        $for M in range(MR):
          $for N in range(0, NR, 16):
            _mm256_storeu_si256((__m256i*) (c${M} + ${N}), _mm512_cvtps_ph(vscaled${M}x${N//16}, _MM_FROUND_TO_NEAREST_INT));
      $else:
        $for M in range(MR):
          $for N in range(0, NR, 16):
            _mm512_storeu_ps(c${M} + ${N}, vscaled${M}x${N//16});

      $for M in range(MR):
        a${M} = (const int8_t*) ((uintptr_t) a${M} - kc);

      $for M in range(MR):
        $if DATATYPE == "QC2_F16":
          c${M} = (uint16_t*) ((uintptr_t) c${M} + cn_stride);
        $else:
          c${M} = (float*) ((uintptr_t) c${M} + cn_stride);

      nc -= ${NR};
    } else {
      $for N in range(0, NR, 16):
        $if N > 0:
          if (nc > ${N}) {
        const __mmask16 vmask${N // 16} = _cvtu32_mask16((uint32_t) ((((UINT64_C(1) << nc) - 1) >> ${N}) & 0xFFFF));
        $if DATATYPE == "QC2_F16":
          $for M in range(MR):
            _mm256_mask_storeu_epi16(c${M} + ${N}, vmask${N // 16}, _mm512_cvtps_ph(vscaled${M}x${N//16}, _MM_FROUND_TO_NEAREST_INT));
        $else:
          $for M in range(MR):
            _mm512_mask_storeu_ps(c${M} + ${N}, vmask${N // 16}, vscaled${M}x${N//16});
        $if N > 0:
          }
      nc = 0;
    }
  } while (nc != 0);
}
