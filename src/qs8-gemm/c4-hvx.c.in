$assert REQUANTIZATION == "FP32" or not REQUANTIZATION
$assert REQUANTIZATION in ["FP32", "RNDNU"] or not REQUANTIZATION
$assert DATATYPE in ["QC8", "QS8", "QS8_QC4", "QD8_F32", "QC4_F32", "QC2_F32", "QC2_F16"]
$assert DATATYPE != "QC8" or REQUANTIZATION == "FP32"
$assert not DATATYPE in ["QD8_F32", "QC4_F32", "QC2_F32", "QC2_F16"] or not REQUANTIZATION
#include <assert.h>
$if DATATYPE not in ["QD8_F32", "QC4_F32", "QC2_F32", "QC2_F16"]:
  #include <math.h>  // for lrintf
$if DATATYPE not in ["QC4_F32", "QC2_F32", "QC2_F16"]:
  #include <stdio.h>  // for printf

#include <hexagon_types.h>
#include <hexagon_protos.h>
#include <hvx_hexagon_protos.h>

#include "src/xnnpack/gemm.h"
#include "src/xnnpack/intrinsics-polyfill.h"  // for Q6_V_vstu_variable
#include "src/xnnpack/math.h"
#include "src/xnnpack/simd/f32-hvx.h"
$if DATATYPE in ["QD8_F32", "QC4_F32", "QC2_F32", "QC2_F16"]:
  #include "src/xnnpack/simd/s32-hvx.h"
#include "src/xnnpack/unaligned.h"

$DATATYPE_SPEC = {"QC8": "qs8_qc8w", "QS8": "qs8", "QS8_QC4": "qs8_qc4w", "QD8_F16" : "qd8_f16_qc8w", "QD8_F32": "qd8_f32_qc8w", "QC4_F16": "qd8_f16_qc4w", "QC4_F32": "qd8_f32_qc4w", "QC2_F16": "qd8_f16_qc2w", "QC2_F32": "qd8_f32_qc2w"}[DATATYPE]
$REQUANTIZATION_SPEC = "_" + REQUANTIZATION.lower() if REQUANTIZATION else ""
$PARAMS_STRUCT = REQUANTIZATION.lower() + "_scalar" if REQUANTIZATION else "scalar"
$PARAMS_TYPE = {"QC8": "union xnn_qs8_qc8w_conv_minmax_params", "QS8": "union xnn_qs8_conv_minmax_params", "QS8_QC4": "union xnn_qs8_qc8w_conv_minmax_params", "QD8_F16": "struct xnn_f16_minmax_params", "QD8_F32": "struct xnn_f32_minmax_params", "QC4_F16": "struct xnn_f16_qc4w_minmax_params", "QC4_F32": "struct xnn_f32_qc4w_minmax_params", "QC2_F16": "struct xnn_f16_minmax_params", "QC2_F32": "struct xnn_f32_minmax_params"}[DATATYPE]
$OUT_T = {"QC8": "int8_t", "QS8": "int8_t", "QS8_QC4": "int8_t", "QD8_F16": "xnn_float16", "QD8_F32": "float", "QC4_F16": "xnn_float16", "QC4_F32": "float", "QC2_F16": "xnn_float16", "QC2_F32": "float"}[DATATYPE]
$IS_UNALIGNED = "(((uintptr_t) a) & (sizeof(int32_t) - 1)) != 0" if MR == 1 else "((((uintptr_t) a) | a_stride) & (sizeof(int32_t) - 1)) != 0"
$UNALIGNED_COMMENT = "Use unaligned loads if activation pointer is not 4-byte aligned." if MR == 1 else "Use unaligned loads if activation pointer or row stride is not 4-byte aligned."

$if DATATYPE not in ["QD8_F32", "QC4_F32", "QC2_F32", "QC2_F16"]:
  #if __HVX_ARCH__ < 73
  static HVX_Vector rescale_fp32(HVX_Vector vacc, HVX_Vector vscale)
  {
    XNN_ALIGN(128) int32_t vacc_buffer[32];
    XNN_ALIGN(128) float vscale_buffer[32];

    *((HVX_Vector *)&vacc_buffer) = vacc;
    *((HVX_Vector *)&vscale_buffer) = vscale;

    for (int i = 0; i < 32; ++i) {
      vacc_buffer[i] = (int32_t)lrintf((float)vacc_buffer[i] * vscale_buffer[i]);
    }
    return *(HVX_Vector *)&vacc_buffer;
  }
  #endif  // __HVX_ARCH__ < 73

void xnn_${DATATYPE_SPEC}_gemm_minmax${REQUANTIZATION_SPEC}_ukernel_${MR}x${NR}c4__hvx${"_prfm" if PREFETCH else ""}(
    size_t mr,
    size_t nc,
    size_t kc,
    const int8_t* restrict a,
    size_t a_stride,
    const void* restrict w,
    ${OUT_T}* restrict c,
    size_t cm_stride,
    size_t cn_stride,
    $if DATATYPE in ["QD8_F16", "QD8_F32", "QC4_F16", "QC4_F32", "QC2_F16", "QC2_F32"]:
      const ${PARAMS_TYPE}* restrict params,
      $if DATATYPE in ["QC2_F16", "QC2_F32"]:
        const float* row_sum,
      const struct xnn_qd8_quantization_params* restrict quantization_params) XNN_OOB_READS
    $else:
      const ${PARAMS_TYPE}* restrict params) XNN_OOB_READS
{
  assert(mr != 0);
  assert(mr <= ${MR});
  assert(nc != 0);
  assert(kc != 0);
  assert(kc % sizeof(int8_t) == 0);
  assert(a != NULL);
  assert(w != NULL);
  assert(c != NULL);
  $if DATATYPE in ["QC2_F16", "QC2_F32"]:
    assert(row_sum != NULL);

  $if DATATYPE == "QC4_F32":
    const size_t kc_aligned8 = kc & ~(size_t) 7;
  $elif DATATYPE in ["QC2_F16", "QC2_F32"]:
    const size_t kc_aligned16 = kc & ~(size_t) 15;
  $else:
    kc = round_up_po2(kc, 4 * sizeof(int8_t));
  const int8_t* a0 = a;
  $if DATATYPE in ["QD8_F16", "QC4_F16", "QC2_F16"]:
    uint16_t* c0 = (uint16_t*) c;
  $else:
    ${OUT_T}* c0 = c;
  $for M in range(1, MR):
    const int8_t* a${M} = (const int8_t*) ((uintptr_t) a${M-1} + a_stride);
    $if DATATYPE in ["QD8_F16", "QC4_F16", "QC2_F16"]:
      uint16_t* c${M} = (uint16_t*) ((uintptr_t) c${M-1} + cm_stride);
    $else:
      ${OUT_T}* c${M} = (${OUT_T}*) ((uintptr_t) c${M-1} + cm_stride);
    $if M % 2 == 0:
      if XNN_UNPREDICTABLE(mr <= ${M}) {
        a${M} = a${M-1};
        c${M} = c${M-1};
      }
    $elif M + 1 == MR:
      if XNN_UNPREDICTABLE(mr != ${M+1}) {
        a${M} = a${M-1};
        c${M} = c${M-1};
      }
    $else:
      if XNN_UNPREDICTABLE(mr < ${M+1}) {
        a${M} = a${M-1};
        c${M} = c${M-1};
      }

  $if DATATYPE not in ["QC4_F32", "QC2_F16", "QC2_F32"]:
    // TODO: Use log when fixed
    {
      static int warning_unaligned = 0;
      if ((a_stride & (sizeof(int32_t) - 1)) != 0 && warning_unaligned == 0) {
        printf("HEXAGON GEMM a_stride unaligned.");
        warning_unaligned = 1;
      }
      static int warning_a_unaligned = 0;
      if ((((intptr_t) a) & (sizeof(int32_t) - 1)) != 0 && warning_a_unaligned == 0) {
        printf("HEXAGON GEMM a unaligned.");
        warning_a_unaligned = 1;
      }
      fflush(stdout);
    }

  $if DATATYPE == "QD8_F32":
    const HVX_Vector vmin = Q6_V_vsplat_R(float_as_uint32(params->scalar.min));
    const HVX_Vector vmax = Q6_V_vsplat_R(float_as_uint32(params->scalar.max));
  $elif DATATYPE == "QC2_F16":
    const uint32_t rmin = float_as_uint32(xnn_float16_to_float(params->scalar.min));
    const uint32_t rmax = float_as_uint32(xnn_float16_to_float(params->scalar.max));
  $elif DATATYPE not in ["QC4_F32", "QC2_F32"]:
    $if DATATYPE == "QS8":
      const HVX_Vector vscale = Q6_V_vsplat_R(float_as_uint32(params->${PARAMS_STRUCT}.scale));
    #if __HVX_ARCH__ >= 73
    const HVX_Vector vmagic_bias = xnn_set1_f32(12582912.0f);
    const HVX_Vector vmagic_bias_less_zero_point = Q6_V_vsplat_R(INT32_C(0x4B400000) - (int32_t) params->${PARAMS_STRUCT}.output_zero_point);
    #else
    const HVX_Vector voutput_zero_point = Q6_Vh_vsplat_R(params->${PARAMS_STRUCT}.output_zero_point);
    #endif
    const HVX_Vector voutput_min = Q6_Vb_vsplat_R(params->${PARAMS_STRUCT}.output_min);
    const HVX_Vector voutput_max = Q6_Vb_vsplat_R(params->${PARAMS_STRUCT}.output_max);
  $if DATATYPE in ["QC4_F16", "QS8_QC4"]:
    const HVX_Vector vmask = Q6_Vb_vsplat_R(0xF0);
  $elif DATATYPE == "QC4_F32":
    const HVX_Vector v0x88 = Q6_Vb_vsplat_R(0x88);
    const HVX_Vector vmask0f = Q6_Vb_vsplat_R(0x0F);
    $if MR == 1:
      const HVX_Vector vmaskf0 = Q6_Vb_vsplat_R(0xF0);
    const HVX_Vector vones = Q6_Vb_vsplat_R(1);
    $for M in range(MR):
      int32_t row_sum8_${M};
      {
        HVX_Vector vsum = Q6_V_vzero();
        const int8_t* ra_ptr = a${M};
        size_t rk = kc;
        for (; rk >= 128; rk -= 128) {
          vsum = Q6_Vw_vrmpyacc_VwVubVb(vsum, vones, *((const HVX_UVector*) ra_ptr));
          ra_ptr += 128;
        }
        vsum = Q6_Vw_vadd_VwVw(vsum, Q6_V_vror_VR(vsum, 64));
        vsum = Q6_Vw_vadd_VwVw(vsum, Q6_V_vror_VR(vsum, 32));
        vsum = Q6_Vw_vadd_VwVw(vsum, Q6_V_vror_VR(vsum, 16));
        vsum = Q6_Vw_vadd_VwVw(vsum, Q6_V_vror_VR(vsum, 8));
        vsum = Q6_Vw_vadd_VwVw(vsum, Q6_V_vror_VR(vsum, 4));
        int32_t sum = Q6_R_vextract_VR(vsum, 0);
        for (; rk != 0; --rk) {
          sum += (int32_t) *ra_ptr++;
        }
        row_sum8_${M} = (int32_t) ((uint32_t) sum << 3);
      }
  $elif DATATYPE in ["QC2_F16", "QC2_F32"]:
    const HVX_Vector vmask03 = Q6_Vb_vsplat_R(0x03);
    $if MR == 1:
      const HVX_Vector vmask0c = Q6_Vb_vsplat_R(0x0C);
  $if PREFETCH:
    $if DATATYPE in ["QC2_F16", "QC2_F32"]:
      const uint32_t prefetch_size = HEXAGON_V64_CREATE_H(0, 0, (round_up_po2(kc, 16) / 4 + 16) * ${NR}, 1);
    $elif DATATYPE == "QC4_F32":
      const uint32_t prefetch_size = HEXAGON_V64_CREATE_H(0, 0, (round_up_po2(kc, 8) / 2 + 12) * ${NR}, 1);
    $else:
      const uint32_t prefetch_size = HEXAGON_V64_CREATE_H(0, 0, kc * ${NR}, 1);
  do {
    $if PREFETCH:
      Q6_l2fetch_AR((void*) w, prefetch_size);
    $if DATATYPE == "QC4_F32":
      $for N in range(0, NR, 32):
        HVX_Vector vksum${N//32} = *((const HVX_Vector*) w); w = (const int32_t*) w + 32;
        vksum${N//32} = Q6_Vw_vasr_VwR(vksum${N//32}, 4);
      $for M in range(MR):
        const HVX_Vector vinput_zero_point${M} = Q6_V_vsplat_R(quantization_params[${M}].zero_point);
        const HVX_Vector vrow_sum8_${M} = Q6_V_vsplat_R(row_sum8_${M});
        $for N in range(0, NR, 32):
          HVX_Vector vacc${M}x${N//32} = Q6_Vw_vsub_VwVw(xnn_mul_s32(vksum${N//32}, vinput_zero_point${M}), vrow_sum8_${M});
      $if MR == 1:
        $for N in range(0, NR, 32):
          HVX_Vector vacc1x0x${N//32} = Q6_V_vzero();
    $elif DATATYPE in ["QC2_F16", "QC2_F32"]:
      // Load NR int32_t weight sums (ksum), then save pointer to NR float kernel_zero_points (loaded in epilogue).
      $for N in range(0, NR, 32):
        const HVX_Vector vksum${N//32} = *((const HVX_Vector*) w); w = (const int32_t*) w + 32;
      const HVX_Vector* kzp = (const HVX_Vector*) w;
      w = (const float*) w + ${NR};
      $for M in range(MR):
        const HVX_Vector vinput_zero_point${M} = Q6_V_vsplat_R(quantization_params[${M}].zero_point);
        $for N in range(0, NR, 32):
          HVX_Vector vacc${M}x${N//32} = xnn_mul_s32(vksum${N//32}, vinput_zero_point${M});
      $if MR == 1:
        $for N in range(0, NR, 32):
          HVX_Vector vacc1x0x${N//32} = Q6_V_vzero();
    $elif DATATYPE == "QD8_F32":
      $for N in range(0, NR, 32):
        const HVX_Vector vksum${N//32} = *((const HVX_Vector*) w); w = (const int8_t*) w + 128;
      $for M in range(MR):
        const HVX_Vector vinput_zero_point${M} = Q6_V_vsplat_R(quantization_params[${M}].zero_point);
        $for N in range(0, NR, 32):
          HVX_Vector vacc${M}x${N//32} = xnn_mul_s32(vksum${N//32}, vinput_zero_point${M});
    $else:
      $for N in range(0, NR, 32):
        HVX_Vector vacc0x${N//32} = *((HVX_Vector *) w); w = (const int8_t*) w + 128;
      $for M in range(1, MR):
        $for N in range(0, NR, 32):
          HVX_Vector vacc${M}x${N//32} = vacc0x${N//32};

    size_t k = kc;
    $if DATATYPE in ["QC2_F16", "QC2_F32"]:
      // ${UNALIGNED_COMMENT}
      if (${IS_UNALIGNED}) {
        for (; k >= 16 * sizeof(int8_t); k -= 16 * sizeof(int8_t)) {
          $for M in range(MR):
            const int32_t ra${M}x0 = unaligned_load_s32(a${M}); a${M} += 4;
            const int32_t ra${M}x1 = unaligned_load_s32(a${M}); a${M} += 4;
            const int32_t ra${M}x2 = unaligned_load_s32(a${M}); a${M} += 4;
            const int32_t ra${M}x3 = unaligned_load_s32(a${M}); a${M} += 4;

          $for N in range(0, NR, 32):
            const HVX_Vector vbb${N//32} = *((const HVX_Vector*) w); w = (const int8_t*) w + 128;

          $if MR == 1:
            $for N in range(0, NR, 32):
              const HVX_Vector vb${N//32}x0 = Q6_V_vand_VV(vbb${N//32}, vmask03);
              vacc0x${N//32} = Q6_Vw_vrmpyacc_VwVubRb(vacc0x${N//32}, vb${N//32}x0, ra0x0);
            $for N in range(0, NR, 32):
              const HVX_Vector vb${N//32}x1 = Q6_V_vand_VV(vbb${N//32}, vmask0c);
              vacc1x0x${N//32} = Q6_Vw_vrmpyacc_VwVubRb(vacc1x0x${N//32}, vb${N//32}x1, ra0x1);
            $for N in range(0, NR, 32):
              const HVX_Vector vbb_hi${N//32} = Q6_Vuw_vlsr_VuwR(vbb${N//32}, 4);
            $for N in range(0, NR, 32):
              const HVX_Vector vb${N//32}x2 = Q6_V_vand_VV(vbb_hi${N//32}, vmask03);
              vacc0x${N//32} = Q6_Vw_vrmpyacc_VwVubRb(vacc0x${N//32}, vb${N//32}x2, ra0x2);
            $for N in range(0, NR, 32):
              const HVX_Vector vb${N//32}x3 = Q6_V_vand_VV(vbb_hi${N//32}, vmask0c);
              vacc1x0x${N//32} = Q6_Vw_vrmpyacc_VwVubRb(vacc1x0x${N//32}, vb${N//32}x3, ra0x3);
          $else:
            $for N in range(0, NR, 32):
              const HVX_Vector vb${N//32}x0 = Q6_V_vand_VV(vbb${N//32}, vmask03);
            $for M in range(MR):
              $for N in range(0, NR, 32):
                vacc${M}x${N//32} = Q6_Vw_vrmpyacc_VwVubRb(vacc${M}x${N//32}, vb${N//32}x0, ra${M}x0);
            $for N in range(0, NR, 32):
              const HVX_Vector vb${N//32}x1 = Q6_V_vand_VV(Q6_Vuw_vlsr_VuwR(vbb${N//32}, 2), vmask03);
            $for M in range(MR):
              $for N in range(0, NR, 32):
                vacc${M}x${N//32} = Q6_Vw_vrmpyacc_VwVubRb(vacc${M}x${N//32}, vb${N//32}x1, ra${M}x1);
            $for N in range(0, NR, 32):
              const HVX_Vector vb${N//32}x2 = Q6_V_vand_VV(Q6_Vuw_vlsr_VuwR(vbb${N//32}, 4), vmask03);
            $for M in range(MR):
              $for N in range(0, NR, 32):
                vacc${M}x${N//32} = Q6_Vw_vrmpyacc_VwVubRb(vacc${M}x${N//32}, vb${N//32}x2, ra${M}x2);
            $for N in range(0, NR, 32):
              const HVX_Vector vb${N//32}x3 = Q6_V_vand_VV(Q6_Vuw_vlsr_VuwR(vbb${N//32}, 6), vmask03);
            $for M in range(MR):
              $for N in range(0, NR, 32):
                vacc${M}x${N//32} = Q6_Vw_vrmpyacc_VwVubRb(vacc${M}x${N//32}, vb${N//32}x3, ra${M}x3);
        }
      } else {
        for (; k >= 16 * sizeof(int8_t); k -= 16 * sizeof(int8_t)) {
          $if MR == 1:
            const int32_t ra0x0 = *((const int32_t*) a0); a0 += 4;
            const int32_t ra0x1 = *((const int32_t*) a0); a0 += 4;
            const int32_t ra0x2 = *((const int32_t*) a0); a0 += 4;
            const int32_t ra0x3 = *((const int32_t*) a0); a0 += 4;

            $for N in range(0, NR, 32):
              const HVX_Vector vbb${N//32} = *((const HVX_Vector*) w); w = (const int8_t*) w + 128;

            $for N in range(0, NR, 32):
              const HVX_Vector vb${N//32}x0 = Q6_V_vand_VV(vbb${N//32}, vmask03);
              vacc0x${N//32} = Q6_Vw_vrmpyacc_VwVubRb(vacc0x${N//32}, vb${N//32}x0, ra0x0);
            $for N in range(0, NR, 32):
              const HVX_Vector vb${N//32}x1 = Q6_V_vand_VV(vbb${N//32}, vmask0c);
              vacc1x0x${N//32} = Q6_Vw_vrmpyacc_VwVubRb(vacc1x0x${N//32}, vb${N//32}x1, ra0x1);
            $for N in range(0, NR, 32):
              const HVX_Vector vbb_hi${N//32} = Q6_Vuw_vlsr_VuwR(vbb${N//32}, 4);
            $for N in range(0, NR, 32):
              const HVX_Vector vb${N//32}x2 = Q6_V_vand_VV(vbb_hi${N//32}, vmask03);
              vacc0x${N//32} = Q6_Vw_vrmpyacc_VwVubRb(vacc0x${N//32}, vb${N//32}x2, ra0x2);
            $for N in range(0, NR, 32):
              const HVX_Vector vb${N//32}x3 = Q6_V_vand_VV(vbb_hi${N//32}, vmask0c);
              vacc1x0x${N//32} = Q6_Vw_vrmpyacc_VwVubRb(vacc1x0x${N//32}, vb${N//32}x3, ra0x3);
          $else:
            $for N in range(0, NR, 32):
              HVX_Vector vbb${N//32} = *((const HVX_Vector*) w); w = (const int8_t*) w + 128;

            $for M in range(MR):
              const int32_t ra${M}x0 = *((const int32_t*) a${M}); a${M} += 4;
            $for N in range(0, NR, 32):
              const HVX_Vector vb${N//32}x0 = Q6_V_vand_VV(vbb${N//32}, vmask03);
            $for M in range(MR):
              $for N in range(0, NR, 32):
                vacc${M}x${N//32} = Q6_Vw_vrmpyacc_VwVubRb(vacc${M}x${N//32}, vb${N//32}x0, ra${M}x0);

            $for M in range(MR):
              const int32_t ra${M}x1 = *((const int32_t*) a${M}); a${M} += 4;
            $for N in range(0, NR, 32):
              vbb${N//32} = Q6_Vuw_vlsr_VuwR(vbb${N//32}, 2);
              const HVX_Vector vb${N//32}x1 = Q6_V_vand_VV(vbb${N//32}, vmask03);
            $for M in range(MR):
              $for N in range(0, NR, 32):
                vacc${M}x${N//32} = Q6_Vw_vrmpyacc_VwVubRb(vacc${M}x${N//32}, vb${N//32}x1, ra${M}x1);

            $for M in range(MR):
              const int32_t ra${M}x2 = *((const int32_t*) a${M}); a${M} += 4;
            $for N in range(0, NR, 32):
              vbb${N//32} = Q6_Vuw_vlsr_VuwR(vbb${N//32}, 2);
              const HVX_Vector vb${N//32}x2 = Q6_V_vand_VV(vbb${N//32}, vmask03);
            $for M in range(MR):
              $for N in range(0, NR, 32):
                vacc${M}x${N//32} = Q6_Vw_vrmpyacc_VwVubRb(vacc${M}x${N//32}, vb${N//32}x2, ra${M}x2);

            $for M in range(MR):
              const int32_t ra${M}x3 = *((const int32_t*) a${M}); a${M} += 4;
            $for N in range(0, NR, 32):
              vbb${N//32} = Q6_Vuw_vlsr_VuwR(vbb${N//32}, 2);
              const HVX_Vector vb${N//32}x3 = Q6_V_vand_VV(vbb${N//32}, vmask03);
            $for M in range(MR):
              $for N in range(0, NR, 32):
                vacc${M}x${N//32} = Q6_Vw_vrmpyacc_VwVubRb(vacc${M}x${N//32}, vb${N//32}x3, ra${M}x3);
        }
      }
      if (k != 0) {
        $for N in range(0, NR, 32):
          const HVX_Vector vbb${N//32} = *((const HVX_Vector*) w); w = (const int8_t*) w + 128;
        $for N in range(0, NR, 32):
          const HVX_Vector vb${N//32}x0 = Q6_V_vand_VV(vbb${N//32}, vmask03);
        if (k >= 4 * sizeof(int8_t)) {
          $for M in range(MR):
            const int32_t ra${M}x0 = unaligned_load_s32(a${M});
