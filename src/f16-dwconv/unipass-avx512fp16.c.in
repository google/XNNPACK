$assert CHANNEL_TILE % 32 == 0
$assert KERNEL_TILE >= 2
$assert ACCUMULATORS >= 1
$REG = 32
#include <assert.h>
#include <stddef.h>
#include <stdint.h>

#include <immintrin.h>

#include "src/xnnpack/common.h"
#include "src/xnnpack/dwconv.h"
#include "src/xnnpack/math.h"
#include "src/xnnpack/microparams.h"


void xnn_f16_dwconv_minmax_ukernel_${KERNEL_TILE}p${CHANNEL_TILE}c__avx512fp16${"" if ACCUMULATORS == 1 else "_acc%d" % ACCUMULATORS}(
    size_t channels,
    size_t output_width,
    const xnn_float16** input,
    const xnn_float16* weights,
    xnn_float16* output,
    intptr_t input_stride,
    size_t output_increment,
    size_t input_offset,
    size_t input_pixel_stride,
    const xnn_float16* zero,
    const struct xnn_f16_minmax_params* restrict params) XNN_OOB_READS
{
  assert(channels != 0);
  assert(output_width != 0);

#if defined(__AVX512FP16__)
  const __m512h vmin = _mm512_castsi512_ph(_mm512_set1_epi16(*(const uint16_t*) &params->scalar.min));
  const __m512h vmax = _mm512_castsi512_ph(_mm512_set1_epi16(*(const uint16_t*) &params->scalar.max));

  uint16_t* o = (uint16_t*) output;
  do {
    $for K in range(KERNEL_TILE):
      const uint16_t* i${K} = (const uint16_t*) input[${K}];
      assert(i${K} != NULL);
      if XNN_UNPREDICTABLE(i${K} != (const uint16_t*) zero) {
        i${K} = (const uint16_t*) ((uintptr_t) i${K} + input_offset);
      }
    input = (const xnn_float16**) ((uintptr_t) input + input_stride);

    size_t c = channels;
    const uint16_t* w = (const uint16_t*) weights;
    for (; c >= ${CHANNEL_TILE}; c -= ${CHANNEL_TILE}) {
      $for C in range(0, CHANNEL_TILE, REG):
        __m512h vacc${C // REG}p0 = _mm512_loadu_ph(w + ${C});

      $for K in range(KERNEL_TILE):

        $for C in range(0, CHANNEL_TILE, REG):
          const __m512h vi${K}x${C // REG} = _mm512_loadu_ph(i${K} + ${C});
        i${K} += ${CHANNEL_TILE};

        $for C in range(0, CHANNEL_TILE, REG):
          const __m512h vk${K}x${C // REG} = _mm512_loadu_ph(w + ${(K + 1) * CHANNEL_TILE + C});
        $for C in range(0, CHANNEL_TILE, REG):
          $if 1 <= K < ACCUMULATORS:
            __m512h vacc${C // REG}p${K} = _mm512_mul_ph(vi${K}x${C // REG}, vk${K}x${C // REG});
          $else:
            vacc${C // REG}p${K % ACCUMULATORS} = _mm512_fmadd_ph(vi${K}x${C // REG}, vk${K}x${C // REG}, vacc${C // REG}p${K % ACCUMULATORS});

      w += ${(KERNEL_TILE + 1) * CHANNEL_TILE};

      $if ACCUMULATORS > 1:
        // Add up all accumulators to the p0 accumulators.
        $ACC_STEP = 1
        $while ACC_STEP < ACCUMULATORS:
          $for A in range(0, ACCUMULATORS, ACC_STEP * 2):
            $if A + ACC_STEP < ACCUMULATORS:
              $for C in range(0, CHANNEL_TILE, REG):
                vacc${C // REG}p${A} = _mm512_add_ph(vacc${C // REG}p${A}, vacc${C // REG}p${A + ACC_STEP});
          $ACC_STEP *= 2

      $for C in range(0, CHANNEL_TILE, REG):
        __m512h vacc${C // REG} = _mm512_max_ph(vmin, vacc${C // REG}p0);
      $for C in range(0, CHANNEL_TILE, REG):
        vacc${C // REG} = _mm512_min_ph(vmax, vacc${C // REG});

      $for C in range(0, CHANNEL_TILE, REG):
        _mm512_storeu_ph(o + ${C}, vacc${C // REG});
      o += ${CHANNEL_TILE};
    }
    $if CHANNEL_TILE > REG:
      for (; c >= ${REG}; c -= ${REG}) {
        __m512h vacc0p0 = _mm512_loadu_ph(w);

        $for K in range(KERNEL_TILE):

          const __m512h vi${K}x0 = _mm512_loadu_ph(i${K});
          i${K} += ${REG};

          const __m512h vk${K}x0 = _mm512_loadu_ph(w + ${(K + 1) * CHANNEL_TILE});
          $if 1 <= K < ACCUMULATORS:
            __m512h vacc0p${K} = _mm512_mul_ph(vi${K}x0, vk${K}x0);
          $else:
            vacc0p${K % ACCUMULATORS} = _mm512_fmadd_ph(vi${K}x0, vk${K}x0, vacc0p${K % ACCUMULATORS});

        w += ${REG};

        $if ACCUMULATORS > 1:
          // Add up all accumulators to vacc0p0
          $ACC_STEP = 1
          $while ACC_STEP < ACCUMULATORS:
            $for A in range(0, ACCUMULATORS, ACC_STEP * 2):
              $if A + ACC_STEP < ACCUMULATORS:
                vacc0p${A} = _mm512_add_ph(vacc0p${A}, vacc0p${A + ACC_STEP});
            $ACC_STEP *= 2

        __m512h vacc0 = _mm512_max_ph(vmin, vacc0p0);
        vacc0 = _mm512_min_ph(vmax, vacc0);

        _mm512_storeu_ph(o, vacc0);
        o += ${REG};
      }
    if XNN_UNLIKELY(c != 0) {
      assert(c >= 1);
      assert(c < ${REG});
      const __mmask32 vmask = _cvtu32_mask32((UINT32_C(1) << c) - UINT32_C(1));

      __m512h vacc0p0 = _mm512_castsi512_ph(_mm512_maskz_loadu_epi16(vmask, w));

      $for K in range(KERNEL_TILE):

        const __m512h vi${K}x0 = _mm512_castsi512_ph(_mm512_maskz_loadu_epi16(vmask, i${K}));

        const __m512h vk${K}x0 = _mm512_castsi512_ph(_mm512_maskz_loadu_epi16(vmask, w + ${(K + 1) * CHANNEL_TILE}));
        $if 1 <= K < ACCUMULATORS:
          __m512h vacc0p${K} = _mm512_mul_ph(vi${K}x0, vk${K}x0);
        $else:
          vacc0p${K % ACCUMULATORS} = _mm512_fmadd_ph(vi${K}x0, vk${K}x0, vacc0p${K % ACCUMULATORS});

      $if ACCUMULATORS > 1:
        // Add up all accumulators to vacc0p0
        $ACC_STEP = 1
        $while ACC_STEP < ACCUMULATORS:
          $for A in range(0, ACCUMULATORS, ACC_STEP * 2):
            $if A + ACC_STEP < ACCUMULATORS:
              vacc0p${A} = _mm512_add_ph(vacc0p${A}, vacc0p${A + ACC_STEP});
          $ACC_STEP *= 2

      __m512h vacc0 = _mm512_max_ph(vmin, vacc0p0);
      vacc0 = _mm512_min_ph(vmax, vacc0);

      _mm512_mask_storeu_epi16(o, vmask, _mm512_castph_si512(vacc0));
      o += c;
    }

    input_offset += input_pixel_stride;
    o = (uint16_t*) ((uintptr_t) o + output_increment);
  } while (--output_width != 0);
#endif  // defined(__AVX512FP16__)
}
