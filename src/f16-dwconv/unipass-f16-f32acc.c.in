$assert ARCH in ("scalar", "wasmrelaxedsimd", "neonfp16")
$SIMD_SIZE = {
$  "scalar": 1,
$  "wasmrelaxedsimd": 4,
$  "neonfp16": 4,
$}[ARCH]
$SIMD_ARCH = {
$  "neonfp16": "neon",
$}.get(ARCH, ARCH)
$assert CHANNEL_TILE % SIMD_SIZE == 0
$assert KERNEL_TILE >= 2
$assert ACCUMULATORS >= 1
$ABC = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
#include <assert.h>
#include <stddef.h>
#include <stdint.h>

#include "src/xnnpack/common.h"
#include "src/xnnpack/dwconv.h"
#include "src/xnnpack/microparams.h"
#include "src/xnnpack/simd/f32-${SIMD_ARCH}.h"
$if ARCH == "wasmrelaxedsimd":
  #undef XNN_SIMD_HAS_NATIVE_FMA
  #include "src/xnnpack/simd/f16-wasmrelaxedsimd.h"
$elif ARCH == "scalar":
  #include "src/xnnpack/simd/f16-scalar.h"


static XNN_INLINE xnn_simd_f32_t xnn_loadu_f16_f32(const xnn_float16* input) {
  return xnn_cvt_f32_f16(xnn_loadu_f16(input));
}

static XNN_INLINE xnn_simd_f32_t xnn_load_tail_f16_f32(
    const xnn_float16* input, size_t elements)
{
  return xnn_cvt_f32_f16(xnn_load_tail_f16(input, elements));
}

static XNN_INLINE void xnn_store_f32_f16(
    xnn_float16* output, xnn_simd_f32_t value)
{
  xnn_store_tail_f16(output, xnn_cvt_f16_f32(value), xnn_simd_size_f32);
}

static XNN_INLINE void xnn_store_tail_f32_f16(
    xnn_float16* output, xnn_simd_f32_t value, size_t elements)
{
  xnn_store_tail_f16(output, xnn_cvt_f16_f32(value), elements);
}


void xnn_f16_f32acc_dwconv_minmax_ukernel_${KERNEL_TILE}p${CHANNEL_TILE}c__${ARCH}${"" if ACCUMULATORS == 1 else "_acc%d" % ACCUMULATORS}(
    size_t channels,
    size_t output_width,
    const xnn_float16** input,
    const xnn_float16* weights,
    xnn_float16* output,
    intptr_t input_stride,
    size_t output_increment,
    size_t input_offset,
    size_t input_pixel_stride,
    const xnn_float16* zero,
    const struct xnn_f16_minmax_params* restrict params) XNN_OOB_READS
{
  assert(channels != 0);
  assert(output_width != 0);
  assert(xnn_simd_size_f32 == ${SIMD_SIZE});

  const xnn_simd_f32_t vmin = xnn_set1_f32(xnn_float16_to_float(params->scalar.min));
  const xnn_simd_f32_t vmax = xnn_set1_f32(xnn_float16_to_float(params->scalar.max));
  do {
    $for K in range(KERNEL_TILE):
      const xnn_float16* i${K} = input[${K}];
      assert(i${K} != NULL);
      if XNN_UNPREDICTABLE(i${K} != zero) {
        i${K} = (const xnn_float16*) ((uintptr_t) i${K} + input_offset);
      }
    input = (const xnn_float16**) ((uintptr_t) input + input_stride);

    size_t c = channels;
    const xnn_float16* w = weights;
    for (; c >= ${CHANNEL_TILE}; c -= ${CHANNEL_TILE}) {
      $for C in range(0, CHANNEL_TILE, SIMD_SIZE):
        xnn_simd_f32_t vacc${ABC[C:C+SIMD_SIZE]}p0 = xnn_loadu_f16_f32(w + ${C});

      $for K in range(KERNEL_TILE):
        $for C in range(0, CHANNEL_TILE, SIMD_SIZE):
          const xnn_simd_f32_t vi${K}x${ABC[C:C+SIMD_SIZE]} = xnn_loadu_f16_f32(i${K} + ${C});
          const xnn_simd_f32_t vk${K}x${ABC[C:C+SIMD_SIZE]} = xnn_loadu_f16_f32(w + ${(K + 1) * CHANNEL_TILE + C});
          $if 1 <= K < ACCUMULATORS:
            xnn_simd_f32_t vacc${ABC[C:C+SIMD_SIZE]}p${K} = xnn_mul_f32(vi${K}x${ABC[C:C+SIMD_SIZE]}, vk${K}x${ABC[C:C+SIMD_SIZE]});
          $else:
            vacc${ABC[C:C+SIMD_SIZE]}p${K % ACCUMULATORS} = xnn_fmadd_f32(vi${K}x${ABC[C:C+SIMD_SIZE]}, vk${K}x${ABC[C:C+SIMD_SIZE]}, vacc${ABC[C:C+SIMD_SIZE]}p${K % ACCUMULATORS});
        i${K} += ${CHANNEL_TILE};

      w += ${(KERNEL_TILE + 1) * CHANNEL_TILE};

      $if ACCUMULATORS > 1:
        $ACC_SLICE = 1
        $while ACC_SLICE < ACCUMULATORS:
          $for A in range(0, ACCUMULATORS, ACC_SLICE * 2):
            $if A + ACC_SLICE < ACCUMULATORS:
              $for C in range(0, CHANNEL_TILE, SIMD_SIZE):
                vacc${ABC[C:C+SIMD_SIZE]}p${A} = xnn_add_f32(vacc${ABC[C:C+SIMD_SIZE]}p${A}, vacc${ABC[C:C+SIMD_SIZE]}p${A + ACC_SLICE});
          $ACC_SLICE *= 2

      $for C in range(0, CHANNEL_TILE, SIMD_SIZE):
        xnn_simd_f32_t vacc${ABC[C:C+SIMD_SIZE]} = xnn_max_f32(vacc${ABC[C:C+SIMD_SIZE]}p0, vmin);
        vacc${ABC[C:C+SIMD_SIZE]} = xnn_min_f32(vacc${ABC[C:C+SIMD_SIZE]}, vmax);
        xnn_store_f32_f16(output + ${C}, vacc${ABC[C:C+SIMD_SIZE]});
      output += ${CHANNEL_TILE};
    }
    $if CHANNEL_TILE > SIMD_SIZE:
      for (; c >= ${SIMD_SIZE}; c -= ${SIMD_SIZE}) {
        xnn_simd_f32_t vacc${ABC[0:SIMD_SIZE]}p0 = xnn_loadu_f16_f32(w);

        $for K in range(KERNEL_TILE):
          const xnn_simd_f32_t vi${K}x${ABC[0:SIMD_SIZE]} = xnn_loadu_f16_f32(i${K});
          const xnn_simd_f32_t vk${K}x${ABC[0:SIMD_SIZE]} = xnn_loadu_f16_f32(w + ${(K + 1) * CHANNEL_TILE});
          $if 1 <= K < ACCUMULATORS:
            xnn_simd_f32_t vacc${ABC[0:SIMD_SIZE]}p${K} = xnn_mul_f32(vi${K}x${ABC[0:SIMD_SIZE]}, vk${K}x${ABC[0:SIMD_SIZE]});
          $else:
            vacc${ABC[0:SIMD_SIZE]}p${K % ACCUMULATORS} = xnn_fmadd_f32(vi${K}x${ABC[0:SIMD_SIZE]}, vk${K}x${ABC[0:SIMD_SIZE]}, vacc${ABC[0:SIMD_SIZE]}p${K % ACCUMULATORS});
          i${K} += ${SIMD_SIZE};

        w += ${SIMD_SIZE};

        $if ACCUMULATORS > 1:
          $ACC_SLICE = 1
          $while ACC_SLICE < ACCUMULATORS:
            $for A in range(0, ACCUMULATORS, ACC_SLICE * 2):
              $if A + ACC_SLICE < ACCUMULATORS:
                vacc${ABC[0:SIMD_SIZE]}p${A} = xnn_add_f32(vacc${ABC[0:SIMD_SIZE]}p${A}, vacc${ABC[0:SIMD_SIZE]}p${A + ACC_SLICE});
            $ACC_SLICE *= 2

        xnn_simd_f32_t vacc${ABC[0:SIMD_SIZE]} = xnn_max_f32(vacc${ABC[0:SIMD_SIZE]}p0, vmin);
        vacc${ABC[0:SIMD_SIZE]} = xnn_min_f32(vacc${ABC[0:SIMD_SIZE]}, vmax);
        xnn_store_f32_f16(output, vacc${ABC[0:SIMD_SIZE]});
        output += ${SIMD_SIZE};
      }
    if XNN_UNLIKELY(c != 0) {
      xnn_simd_f32_t vacc${ABC[0:SIMD_SIZE]}p0 = xnn_loadu_f16_f32(w);

      $for K in range(KERNEL_TILE):
        const xnn_simd_f32_t vi${K}x${ABC[0:SIMD_SIZE]} = xnn_load_tail_f16_f32(i${K}, c);
        const xnn_simd_f32_t vk${K}x${ABC[0:SIMD_SIZE]} = xnn_loadu_f16_f32(w + ${(K + 1) * CHANNEL_TILE});
        $if 1 <= K < ACCUMULATORS:
          xnn_simd_f32_t vacc${ABC[0:SIMD_SIZE]}p${K} = xnn_mul_f32(vi${K}x${ABC[0:SIMD_SIZE]}, vk${K}x${ABC[0:SIMD_SIZE]});
        $else:
          vacc${ABC[0:SIMD_SIZE]}p${K % ACCUMULATORS} = xnn_fmadd_f32(vi${K}x${ABC[0:SIMD_SIZE]}, vk${K}x${ABC[0:SIMD_SIZE]}, vacc${ABC[0:SIMD_SIZE]}p${K % ACCUMULATORS});

      $if ACCUMULATORS > 1:
        $ACC_SLICE = 1
        $while ACC_SLICE < ACCUMULATORS:
          $for A in range(0, ACCUMULATORS, ACC_SLICE * 2):
            $if A + ACC_SLICE < ACCUMULATORS:
              vacc${ABC[0:SIMD_SIZE]}p${A} = xnn_add_f32(vacc${ABC[0:SIMD_SIZE]}p${A}, vacc${ABC[0:SIMD_SIZE]}p${A + ACC_SLICE});
          $ACC_SLICE *= 2

      xnn_simd_f32_t vacc${ABC[0:SIMD_SIZE]} = xnn_max_f32(vacc${ABC[0:SIMD_SIZE]}p0, vmin);
      vacc${ABC[0:SIMD_SIZE]} = xnn_min_f32(vacc${ABC[0:SIMD_SIZE]}, vmax);
      xnn_store_tail_f32_f16(output, vacc${ABC[0:SIMD_SIZE]}, c);
      output += c;
    }

    input_offset += input_pixel_stride;
    output = (xnn_float16*) ((uintptr_t) output + output_increment);
  } while (--output_width != 0);
}