$BATCH_TILES = tuple(int(bt) for bt in BATCH_TILES.split(","))
$SIMD_SIZE = BATCH_TILES[0]
#include <assert.h>
#include <stddef.h>
#include <stdint.h>

#include "src/xnnpack/common.h"
#include "src/xnnpack/microparams.h"
#include "src/xnnpack/simd/s8-${ARCH}.h"
#include "src/xnnpack/vunary.h"

$for BATCH_TILE in BATCH_TILES:
  $assert BATCH_TILE % SIMD_SIZE == 0
  $assert BATCH_TILE >= SIMD_SIZE
  $SIMD_TILE = BATCH_TILE // SIMD_SIZE

  void xnn_s8_vclamp_ukernel__${ARCH}_u${BATCH_TILE}(
      size_t batch,
      const int8_t* input,
      int8_t* output,
      const struct xnn_s8_minmax_params* restrict params) XNN_OOB_READS
  {
    assert(batch != 0);
    assert(batch % sizeof(int8_t) == 0);
    assert(input != NULL);
    assert(output != NULL);
    assert(params != NULL);

    const xnn_simd_s8_t vmin = xnn_set1_s8(params->scalar.min);
    const xnn_simd_s8_t vmax = xnn_set1_s8(params->scalar.max);

    $if SIMD_TILE > 1:
      for (; batch >= ${BATCH_TILE} * sizeof(int8_t); batch -= ${BATCH_TILE} * sizeof(int8_t)) {
        $for N in range(SIMD_TILE):
          xnn_simd_s8_t vacc${N} = xnn_loadu_s8(input + ${N} * xnn_simd_size_s8);
        input += ${BATCH_TILE};

        $for N in range(SIMD_TILE):
          vacc${N} = xnn_max_s8(vmin, vacc${N});

        $for N in range(SIMD_TILE):
          vacc${N} = xnn_min_s8(vmax, vacc${N});

        $for N in range(SIMD_TILE):
          xnn_storeu_s8(output + ${N} * xnn_simd_size_s8, vacc${N});
        output += ${BATCH_TILE};
      }
    for (; batch >= xnn_simd_bytes_s8; batch -= xnn_simd_bytes_s8) {
      xnn_simd_s8_t vacc = xnn_loadu_s8(input);
      input += xnn_simd_size_s8;

      vacc = xnn_max_s8(vmin, vacc);
      vacc = xnn_min_s8(vmax, vacc);

      xnn_storeu_s8(output, vacc);
      output += xnn_simd_size_s8;
    }
    if XNN_UNLIKELY(batch != 0) {
      xnn_simd_s8_t vacc = xnn_load_tail_s8(input, batch);

      vacc = xnn_max_s8(vmin, vacc);
      vacc = xnn_min_s8(vmax, vacc);

      xnn_store_tail_s8(output, vacc, batch);
    }
  }
