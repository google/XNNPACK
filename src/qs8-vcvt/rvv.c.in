$assert DATATYPE in ["QS8", "QU8"]
$assert LMUL in [1, 2, 4]
#include <assert.h>

#include <riscv_vector.h>
#include "src/xnnpack/vcvt.h"

$XINT8_T = {"QS8": "int8_t", "QU8": "uint8_t"}[DATATYPE]
void xnn_${DATATYPE.lower()}_vcvt_ukernel__rvv_u${LMUL}v(
    size_t batch,
    const ${XINT8_T}* input,
    ${XINT8_T}* output,
    const struct xnn_${DATATYPE.lower()}_cvt_params* restrict params)
{
  assert(batch != 0);
  assert(batch % sizeof(${XINT8_T}) == 0);
  assert(input != NULL);
  assert(output != NULL);

  $if DATATYPE == "QS8":
    $LMUL_QS8 = min(LMUL, 2)
    const int32_t vbias =
        (int32_t) (((uint32_t) (int32_t) params->scalar.output_zero_point) << 16) -
        (int32_t) params->scalar.multiplier * (int32_t) params->scalar.input_zero_point +
        INT32_C(0x8000);
    const int32_t multiplier = params->scalar.multiplier;
  $else:
    const ${XINT8_T} input_zero_point = params->scalar.input_zero_point;
    const int16_t multiplier = params->scalar.multiplier;
    const int16_t output_zero_point = params->scalar.output_zero_point;

  do {
    $if DATATYPE == "QS8":
      size_t vl = __riscv_vsetvl_e8m${LMUL_QS8}(batch); batch -= vl;
      vint8m${LMUL_QS8}_t in_i8v = __riscv_vle8_v_i8m${LMUL_QS8}(input, vl); input += vl;
      vint32m${LMUL_QS8*4}_t acc_i32v = __riscv_vsext_vf4(in_i8v, vl);
      vint32m${LMUL_QS8*4}_t bias_i32v = __riscv_vmv_v_x_i32m${LMUL_QS8*4}(vbias, vl);
      acc_i32v = __riscv_vmacc(bias_i32v, multiplier, acc_i32v, vl);
      vint16m${LMUL_QS8*2}_t out_i16v = __riscv_vnclip(acc_i32v, 16, __RISCV_VXRM_RDN, vl);
      vint8m${LMUL_QS8}_t out_i8v = __riscv_vnclip(out_i16v, 0, __RISCV_VXRM_RNU, vl);
      __riscv_vse8(output, out_i8v, vl); output += vl;
    $else:
      size_t vl = __riscv_vsetvl_e8m${LMUL}(batch); batch -= vl;
      vuint8m${LMUL}_t in_u8v = __riscv_vle8_v_u8m${LMUL}(input, vl); input += vl;
      vint16m${LMUL*2}_t acc_i16v = __riscv_vreinterpret_i16m${LMUL*2}(__riscv_vwsubu_vx(in_u8v, input_zero_point, vl));
      acc_i16v = __riscv_vsll(acc_i16v, 7, vl);
      acc_i16v = __riscv_vsmul(acc_i16v, multiplier, __RISCV_VXRM_RNU, vl);
      acc_i16v = __riscv_vsadd(acc_i16v, output_zero_point, vl);
      acc_i16v = __riscv_vmax(acc_i16v, 0, vl);
      vuint8m${LMUL}_t out_u8v = __riscv_vnclipu(__riscv_vreinterpret_u16m${LMUL*2}(acc_i16v), 0, __RISCV_VXRM_RDN, vl);
      __riscv_vse8(output, out_u8v, vl); output += vl;
  } while (batch != 0);
}
