$assert DATATYPE in ["QS8", "QU8"]
$assert BATCH_TILE % 32 == 0
$assert BATCH_TILE >= 32
#include <assert.h>
#include <stddef.h>
#include <stdint.h>

#include <hexagon_protos.h>
#include <hexagon_types.h>
#include <hvx_hexagon_protos.h>

#include "src/xnnpack/common.h"
#include "src/xnnpack/intrinsics-polyfill.h"
#include "src/xnnpack/microparams.h"
#include "src/xnnpack/vcvt.h"


$XINT8_T = {"QS8": "int8_t", "QU8": "uint8_t"}[DATATYPE]
$VUNPACK_XB = {"QS8": "Q6_Wh_vunpack_Vb", "QU8": "Q6_Wuh_vunpack_Vub"}[DATATYPE]
$VPACK_HV_X8 = {"QS8": "Q6_Vb_vpack_VhVh_sat", "QU8": "Q6_Vub_vpack_VhVh_sat"}[DATATYPE]
void xnn_${DATATYPE.lower()}_vcvt_ukernel__hvx_u${BATCH_TILE}(
    size_t batch,
    const ${XINT8_T}* input,
    ${XINT8_T}* output,
    const struct xnn_${DATATYPE.lower()}_cvt_params* restrict params) XNN_OOB_READS
{
  assert(batch != 0);
  assert(batch % sizeof(${XINT8_T}) == 0);
  assert(input != NULL);
  assert(output != NULL);

  const HVX_Vector vinput_zero_point = Q6_Vh_vsplat_R(params->scalar.input_zero_point);
  const HVX_Vector vmultiplier = Q6_Vh_vsplat_R(-params->scalar.multiplier);
  const HVX_Vector voutput_zero_point = Q6_Vh_vsplat_R(params->scalar.output_zero_point);
  XNN_FORCE_REALIZATION(vinput_zero_point);
  XNN_FORCE_REALIZATION(vmultiplier);
  XNN_FORCE_REALIZATION(voutput_zero_point);
  $if BATCH_TILE > 32:
    for (; batch >= ${BATCH_TILE} * sizeof(${XINT8_T}); batch -= ${BATCH_TILE} * sizeof(${XINT8_T})) {
      $for N in range(0, BATCH_TILE, 128):
        const HVX_Vector vx${N // 128} = *((const HVX_UVector*) (input + ${N}));
      input += ${BATCH_TILE};

      $for N in range(0, BATCH_TILE, 128):
        const HVX_VectorPair vacc_pair${N // 128} = ${VUNPACK_XB}(vx${N // 128});
        HVX_Vector vacc${N // 64} = Q6_V_lo_W(vacc_pair${N // 128});
        $if N + 64 < BATCH_TILE:
          HVX_Vector vacc${(N + 64) // 64} = Q6_V_hi_W(vacc_pair${N // 128});

      $for N in range(0, BATCH_TILE, 64):
        vacc${N // 64} = Q6_Vh_vsub_VhVh(vinput_zero_point, vacc${N // 64});
        vacc${N // 64} = Q6_Vh_vasl_VhR(vacc${N // 64}, 7);
        vacc${N // 64} = Q6_Vh_vmpy_VhVh_s1_rnd_sat(vacc${N // 64}, vmultiplier);
        vacc${N // 64} = Q6_Vh_vadd_VhVh_sat(vacc${N // 64}, voutput_zero_point);

      $for N in range(0, BATCH_TILE, 128):
        $if N + 64 < BATCH_TILE:
          const HVX_Vector vy${N // 128} = ${VPACK_HV_X8}(vacc${(N + 64) // 64}, vacc${N // 64});
        $else:
          const HVX_Vector vy${N // 128} = ${VPACK_HV_X8}(vacc${N // 64}, vacc${N // 64});

      $for N in range(0, BATCH_TILE, 128):
        $if N + 128 <= BATCH_TILE:
          *((HVX_UVector*) output) = vy${N // 128};
          output += 128;
        $else:
          Q6_V_vstu_variable(output, ${BATCH_TILE - N}, vy${N // 128});
          output += ${BATCH_TILE - N};
    }
  $if BATCH_TILE > 64:
    for (; batch >= 64 * sizeof(${XINT8_T}); batch -= 64 * sizeof(${XINT8_T})) {
      const HVX_Vector vx = *((const HVX_UVector*) input);
      input += 64;

      HVX_Vector vacc = Q6_V_lo_W(${VUNPACK_XB}(vx));
      vacc = Q6_Vh_vsub_VhVh(vinput_zero_point, vacc);
      vacc = Q6_Vh_vasl_VhR(vacc, 7);
      vacc = Q6_Vh_vmpy_VhVh_s1_rnd_sat(vacc, vmultiplier);
      vacc = Q6_Vh_vadd_VhVh_sat(vacc, voutput_zero_point);

      const HVX_Vector vy = ${VPACK_HV_X8}(vacc, vacc);
      Q6_V_vstu_variable(output, 64, vy);
      output += 64;
    }
  for (; batch >= 32 * sizeof(${XINT8_T}); batch -= 32 * sizeof(${XINT8_T})) {
    const HVX_Vector vx = *((const HVX_UVector*) input);
    input += 32;

    HVX_Vector vacc = Q6_V_lo_W(${VUNPACK_XB}(vx));
    vacc = Q6_Vh_vsub_VhVh(vinput_zero_point, vacc);
    vacc = Q6_Vh_vasl_VhR(vacc, 7);
    vacc = Q6_Vh_vmpy_VhVh_s1_rnd_sat(vacc, vmultiplier);
    vacc = Q6_Vh_vadd_VhVh_sat(vacc, voutput_zero_point);

    const HVX_Vector vy = ${VPACK_HV_X8}(vacc, vacc);
    Q6_V_vstu_variable(output, 32, vy);
    output += 32;
  }
  if XNN_UNLIKELY(batch != 0) {
    assert(batch >= 1 * sizeof(${XINT8_T}));
    assert(batch <= 31 * sizeof(${XINT8_T}));

    const HVX_Vector vx = *((const HVX_UVector*) input);
    HVX_Vector vacc = Q6_V_lo_W(${VUNPACK_XB}(vx));
    vacc = Q6_Vh_vsub_VhVh(vinput_zero_point, vacc);
    vacc = Q6_Vh_vasl_VhR(vacc, 7);
    vacc = Q6_Vh_vmpy_VhVh_s1_rnd_sat(vacc, vmultiplier);
    vacc = Q6_Vh_vadd_VhVh_sat(vacc, voutput_zero_point);

    const HVX_Vector vy = ${VPACK_HV_X8}(vacc, vacc);
    Q6_V_vstu_variable(output, batch, vy);
  }
}
