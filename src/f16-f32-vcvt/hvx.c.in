$assert BATCH_TILE % 32 == 0
$assert BATCH_TILE >= 32
$SIMD_TILE = BATCH_TILE // 32
#include <assert.h>
#include <stddef.h>
#include <stdint.h>

#include "src/xnnpack/common.h"
#include "src/xnnpack/math.h"
#include "src/xnnpack/simd/f32-hvx.h"
#include "src/xnnpack/vcvt.h"


void xnn_f16_f32_vcvt_ukernel__hvx_u${BATCH_TILE}(
    size_t batch,
    const xnn_float16* input,
    float* output,
    const void* params) XNN_OOB_READS
{
  assert(batch != 0);
  assert(batch % sizeof(xnn_float16) == 0);
  assert(input != NULL);
  assert(output != NULL);

  $if BATCH_TILE > 32:
    for (; batch >= ${BATCH_TILE} * sizeof(xnn_float16); batch -= ${BATCH_TILE} * sizeof(xnn_float16)) {
      #if __HVX_ARCH__ >= 81
      $for N in range(0, SIMD_TILE, 2):
        const xnn_simd_f16_t vx${N // 2} = xnn_loadu_f16(input + ${N * 32});
      input += ${BATCH_TILE};

      $for N in range(0, SIMD_TILE, 2):
        const HVX_VectorPair vw${N // 2} = Q6_Wsf_vcvt_Vhf(Q6_Vh_vshuff_Vh(vx${N // 2}));

      $for N in range(0, SIMD_TILE, 2):
        xnn_storeu_f32(output + ${N * 32}, Q6_V_lo_W(vw${N // 2}));
        xnn_storeu_f32(output + ${(N + 1) * 32}, Q6_V_hi_W(vw${N // 2}));
      #else
      $for N in range(SIMD_TILE):
        const xnn_simd_f32_t vy${N} = xnn_cvt_f32_f16(xnn_loadu_f16(input + ${N * 32}));
      input += ${BATCH_TILE};

      $for N in range(SIMD_TILE):
        xnn_storeu_f32(output + ${N * 32}, vy${N});
      #endif
      output += ${BATCH_TILE};
    }
  for (; batch >= 32 * sizeof(xnn_float16); batch -= 32 * sizeof(xnn_float16)) {
    const xnn_simd_f32_t vy = xnn_cvt_f32_f16(xnn_loadu_f16(input));
    input += 32;

    xnn_storeu_f32(output, vy);
    output += 32;
  }
  if XNN_UNLIKELY(batch != 0) {
    assert(batch >= 1 * sizeof(xnn_float16));
    assert(batch <= 31 * sizeof(xnn_float16));

    const size_t num_elements = batch >> XNN_LOG2_SIZEOF_FLOAT16;
    const xnn_simd_f32_t vy = xnn_cvt_f32_f16(xnn_load_tail_f16(input, num_elements));
    xnn_store_tail_f32(output, vy, num_elements);
  }
}
