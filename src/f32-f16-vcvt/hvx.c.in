$assert BATCH_TILE % 32 == 0
$assert BATCH_TILE >= 32
$SIMD_TILE = BATCH_TILE // 32
#include <assert.h>
#include <stddef.h>
#include <stdint.h>

#include "src/xnnpack/common.h"
#include "src/xnnpack/math.h"
#include "src/xnnpack/simd/f32-hvx.h"
#include "src/xnnpack/vcvt.h"


void xnn_f32_f16_vcvt_ukernel__hvx_u${BATCH_TILE}(
    size_t batch,
    const float* input,
    xnn_float16* output,
    const void* params) XNN_OOB_READS
{
  assert(batch != 0);
  assert(batch % sizeof(float) == 0);
  assert(input != NULL);
  assert(output != NULL);

  $if BATCH_TILE > 32:
    for (; batch >= ${BATCH_TILE} * sizeof(float); batch -= ${BATCH_TILE} * sizeof(float)) {
      $for N in range(SIMD_TILE):
        const xnn_simd_f32_t vx${N} = xnn_loadu_f32(input + ${N * 32});
      input += ${BATCH_TILE};

      $for N in range(0, SIMD_TILE, 2):
        const xnn_simd_f16_t vy${N // 2} = Q6_Vh_vdeal_Vh(Q6_Vhf_vcvt_VsfVsf(vx${N}, vx${N + 1}));

      $for N in range(0, SIMD_TILE, 2):
        xnn_storeu_f16(output + ${N * 32}, vy${N // 2});
      output += ${BATCH_TILE};
    }
  $if BATCH_TILE > 64:
    for (; batch >= 64 * sizeof(float); batch -= 64 * sizeof(float)) {
      const xnn_simd_f32_t vx0 = xnn_loadu_f32(input);
      const xnn_simd_f32_t vx1 = xnn_loadu_f32(input + 32);
      input += 64;

      const xnn_simd_f16_t vy = Q6_Vh_vdeal_Vh(Q6_Vhf_vcvt_VsfVsf(vx0, vx1));

      xnn_storeu_f16(output, vy);
      output += 64;
    }
  for (; batch >= 32 * sizeof(float); batch -= 32 * sizeof(float)) {
    const xnn_simd_f32_t vx = xnn_loadu_f32(input);
    input += 32;

    const xnn_simd_f16_t vy = xnn_cvt_f16_f32(vx);

    xnn_store_tail_f16(output, vy, 32);
    output += 32;
  }
  if XNN_UNLIKELY(batch != 0) {
    assert(batch >= 1 * sizeof(float));
    assert(batch <= 31 * sizeof(float));

    const size_t num_elements = batch >> XNN_LOG2_SIZEOF_FLOAT;
    const xnn_simd_f32_t vx = xnn_loadu_f32(input);
    const xnn_simd_f16_t vy = xnn_cvt_f16_f32(vx);
    xnn_store_tail_f16(output, vy, num_elements);
  }
}
