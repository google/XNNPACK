$assert NR >= 32
$assert NR % 32 == 0
$assert KBLOCK == 16

#include <assert.h>
#include <stddef.h>
#include <stdint.h>
#include <string.h>

#include <immintrin.h>

#include "src/xnnpack/common.h"
#include "src/xnnpack/intrinsics-polyfill.h"
#include "src/xnnpack/packw.h"
#include "src/xnnpack/unaligned.h"
$if PREFETCH:
  #include "src/xnnpack/prefetch.h"


void xnn_x16_packw_gemm_goi_ukernel_x${NR}__avx512skx_u${KBLOCK}${"_prfm" if PREFETCH else ""}(
  size_t g,
  size_t nc,
  size_t kc,
  size_t nr,
  size_t kr,
  size_t sr,
  const uint16_t* weights,
  const uint16_t* bias,
  const void* scale,
  uint16_t* packed_weights,
  size_t extra_bytes,
  const void* params)
{
  assert(g != 0);
  assert(nc != 0);
  assert(kc != 0);
  assert(nr == ${NR});   // This kernel is for NR=${NR}
  assert(kr == 1);
  assert(sr == 1);
  assert(weights != NULL);
  assert(packed_weights != NULL);

  const uint16_t* b = bias;
  uint16_t* packed_w = packed_weights;
  do {
    // NC main loop multiple of ${NR}
    const uint16_t* w_base = weights;
    size_t n = nc;

    for (; n >= ${NR}; n -= ${NR}) {
      if XNN_LIKELY(b != NULL) {
        $for N in range(0, NR, 32):
          const __m512i vb${N} = _mm512_loadu_si512((const __m512i*) (b + ${N}));
          _mm512_storeu_si512((__m512i*) (packed_w + ${N}), vb${N});
        b += ${NR};
      } else {
        const __m512i vzero = _mm512_setzero_si512();
        $for N in range(0, NR, 32):
          _mm512_storeu_si512((__m512i*) (packed_w + ${N}), vzero);
      }
      packed_w += ${NR};

      const ptrdiff_t stride1 = (ptrdiff_t) kc;
      const ptrdiff_t stride2 = stride1 * 2;
      const ptrdiff_t stride3 = stride1 * 3;
      const ptrdiff_t stride4 = stride1 * 4;
      const ptrdiff_t stride5 = stride1 * 5;
      const ptrdiff_t stride6 = stride1 * 6;
      const ptrdiff_t stride7 = stride1 * 7;

      $for N in range(0, NR, 8):
        $if N == 0:
          const uint16_t* w0 = w_base;
        $else:
          const uint16_t* w${N} = w0 + ${N} * stride1;
      $if PREFETCH:
        $for N in range(0, NR, 8):
          $for L in range(8):
            $if L == 0:
              xnn_prefetch_to_l1((const int8_t*) w${N});
              xnn_prefetch_to_l1((const int8_t*) w${N} + 64);
            $else:
              xnn_prefetch_to_l1((const int8_t*) (w${N} + stride${L}));
              xnn_prefetch_to_l1((const int8_t*) (w${N} + stride${L}) + 64);

      // KC main loop multiple of ${KBLOCK}
      size_t k = kc;
      for (; k >= ${KBLOCK}; k -= ${KBLOCK}) {
        $for N in range(0, NR, 32):
          $for L in range(8):
            $if L == 0:
              const __m256i v${N+L} = _mm256_loadu_si256((const __m256i*) w${N});
              const __m256i v${N+L+8} = _mm256_loadu_si256((const __m256i*) w${N+8});
              const __m256i v${N+L+16} = _mm256_loadu_si256((const __m256i*) w${N+16});
              const __m256i v${N+L+24} = _mm256_loadu_si256((const __m256i*) w${N+24});
            $else:
              const __m256i v${N+L} = _mm256_loadu_si256((const __m256i*) (w${N} + stride${L}));
              const __m256i v${N+L+8} = _mm256_loadu_si256((const __m256i*) (w${N+8} + stride${L}));
              const __m256i v${N+L+16} = _mm256_loadu_si256((const __m256i*) (w${N+16} + stride${L}));
              const __m256i v${N+L+24} = _mm256_loadu_si256((const __m256i*) (w${N+24} + stride${L}));
            __m512i z${N+L} = _mm512_inserti64x4(_mm512_castsi256_si512(v${N+L}), v${N+L+8}, 1);
            __m512i z${N+L+8} = _mm512_inserti64x4(_mm512_castsi256_si512(v${N+L+16}), v${N+L+24}, 1);
          w${N} += ${KBLOCK};
          w${N+8} += ${KBLOCK};
          w${N+16} += ${KBLOCK};
          w${N+24} += ${KBLOCK};

        $for N in range(0, NR, 32):
          $for B in (0, 8):
            $for L in range(0, 8, 2):
              const __m512i t${N+B+L} = _mm512_unpacklo_epi16(z${N+B+L}, z${N+B+L+1});
              const __m512i t${N+B+L+1} = _mm512_unpackhi_epi16(z${N+B+L}, z${N+B+L+1});

            $for L in range(0, 8, 4):
              const __m512i u${N+B+L} = _mm512_unpacklo_epi32(t${N+B+L}, t${N+B+L+2});
              const __m512i u${N+B+L+1} = _mm512_unpackhi_epi32(t${N+B+L}, t${N+B+L+2});
              const __m512i u${N+B+L+2} = _mm512_unpacklo_epi32(t${N+B+L+1}, t${N+B+L+3});
              const __m512i u${N+B+L+3} = _mm512_unpackhi_epi32(t${N+B+L+1}, t${N+B+L+3});

            const __m512i w${N+B+0} = _mm512_unpacklo_epi64(u${N+B+0}, u${N+B+4});
            const __m512i w${N+B+1} = _mm512_unpackhi_epi64(u${N+B+0}, u${N+B+4});
            const __m512i w${N+B+2} = _mm512_unpacklo_epi64(u${N+B+1}, u${N+B+5});
            const __m512i w${N+B+3} = _mm512_unpackhi_epi64(u${N+B+1}, u${N+B+5});
            const __m512i w${N+B+4} = _mm512_unpacklo_epi64(u${N+B+2}, u${N+B+6});
            const __m512i w${N+B+5} = _mm512_unpackhi_epi64(u${N+B+2}, u${N+B+6});
            const __m512i w${N+B+6} = _mm512_unpacklo_epi64(u${N+B+3}, u${N+B+7});
            const __m512i w${N+B+7} = _mm512_unpackhi_epi64(u${N+B+3}, u${N+B+7});

          $for K in range(8):
            const __m512i out${N}_${K} = _mm512_shuffle_i32x4(w${N+K}, w${N+8+K}, _MM_SHUFFLE(2, 0, 2, 0));
            const __m512i out${N}_${K+8} = _mm512_shuffle_i32x4(w${N+K}, w${N+8+K}, _MM_SHUFFLE(3, 1, 3, 1));
            _mm512_storeu_si512((__m512i*) (packed_w + ${N + K*NR}), out${N}_${K});
            _mm512_storeu_si512((__m512i*) (packed_w + ${N + (K+8)*NR}), out${N}_${K+8});
        packed_w += ${NR * KBLOCK};
      }

      // KC remainder (1..15) using AVX-512BW masking
      if XNN_UNLIKELY(k != 0) {
        assert(k >= 1);
        assert(k <= 15);
        const __mmask16 kmask = _cvtu32_mask16((1U << k) - 1U);

        $for N in range(0, NR, 32):
          $for L in range(8):
            $if L == 0:
              const __m256i v${N+L} = _mm256_maskz_loadu_epi16(kmask, w${N});
              const __m256i v${N+L+8} = _mm256_maskz_loadu_epi16(kmask, w${N+8});
              const __m256i v${N+L+16} = _mm256_maskz_loadu_epi16(kmask, w${N+16});
              const __m256i v${N+L+24} = _mm256_maskz_loadu_epi16(kmask, w${N+24});
            $else:
              const __m256i v${N+L} = _mm256_maskz_loadu_epi16(kmask, w${N} + stride${L});
              const __m256i v${N+L+8} = _mm256_maskz_loadu_epi16(kmask, w${N+8} + stride${L});
              const __m256i v${N+L+16} = _mm256_maskz_loadu_epi16(kmask, w${N+16} + stride${L});
              const __m256i v${N+L+24} = _mm256_maskz_loadu_epi16(kmask, w${N+24} + stride${L});
            __m512i z${N+L} = _mm512_inserti64x4(_mm512_castsi256_si512(v${N+L}), v${N+L+8}, 1);
            __m512i z${N+L+8} = _mm512_inserti64x4(_mm512_castsi256_si512(v${N+L+16}), v${N+L+24}, 1);
          w${N} += k;
          w${N+8} += k;
          w${N+16} += k;
          w${N+24} += k;

        $for N in range(0, NR, 32):
          $for B in (0, 8):
            $for L in range(0, 8, 2):
              const __m512i t${N+B+L} = _mm512_unpacklo_epi16(z${N+B+L}, z${N+B+L+1});
              const __m512i t${N+B+L+1} = _mm512_unpackhi_epi16(z${N+B+L}, z${N+B+L+1});

            $for L in range(0, 8, 4):
              const __m512i u${N+B+L} = _mm512_unpacklo_epi32(t${N+B+L}, t${N+B+L+2});
              const __m512i u${N+B+L+1} = _mm512_unpackhi_epi32(t${N+B+L}, t${N+B+L+2});
              const __m512i u${N+B+L+2} = _mm512_unpacklo_epi32(t${N+B+L+1}, t${N+B+L+3});
              const __m512i u${N+B+L+3} = _mm512_unpackhi_epi32(t${N+B+L+1}, t${N+B+L+3});

            const __m512i w${N+B+0} = _mm512_unpacklo_epi64(u${N+B+0}, u${N+B+4});
            const __m512i w${N+B+1} = _mm512_unpackhi_epi64(u${N+B+0}, u${N+B+4});
            const __m512i w${N+B+2} = _mm512_unpacklo_epi64(u${N+B+1}, u${N+B+5});
            const __m512i w${N+B+3} = _mm512_unpackhi_epi64(u${N+B+1}, u${N+B+5});
            const __m512i w${N+B+4} = _mm512_unpacklo_epi64(u${N+B+2}, u${N+B+6});
            const __m512i w${N+B+5} = _mm512_unpackhi_epi64(u${N+B+2}, u${N+B+6});
            const __m512i w${N+B+6} = _mm512_unpacklo_epi64(u${N+B+3}, u${N+B+7});
            const __m512i w${N+B+7} = _mm512_unpackhi_epi64(u${N+B+3}, u${N+B+7});

          $for K in range(8):
            const __m512i out${N}_${K} = _mm512_shuffle_i32x4(w${N+K}, w${N+8+K}, _MM_SHUFFLE(2, 0, 2, 0));
            if (k > ${K}) {
              _mm512_storeu_si512((__m512i*) (packed_w + ${N + K*NR}), out${N}_${K});
            }
            const __m512i out${N}_${K+8} = _mm512_shuffle_i32x4(w${N+K}, w${N+8+K}, _MM_SHUFFLE(3, 1, 3, 1));
            if (k > ${K+8}) {
              _mm512_storeu_si512((__m512i*) (packed_w + ${N + (K+8)*NR}), out${N}_${K+8});
            }
        packed_w += ${NR} * k;
      }
      packed_w = (uint16_t*) ((uintptr_t) packed_w + extra_bytes);
      w_base += ${NR} * stride1;
    }

    // NC remainder (1..${NR-1})
    if XNN_UNLIKELY(n != 0) {
      assert(n >= 1);
      assert(n <= ${NR-1});
      const uint16_t* w0 = w_base;
      if XNN_LIKELY(b != NULL) {
        size_t nb = n;
        do {
          *packed_w++ = *b++;
        } while (--nb != 0);
        packed_w += (${NR} - n);
      } else {
        const __m512i vzero = _mm512_setzero_si512();
        $for N in range(0, NR, 32):
          _mm512_storeu_si512((__m512i*) (packed_w + ${N}), vzero);
        packed_w += ${NR};
      }

      // NR remainder has less than ${NR} rows so last row is not loaded
      $for N in range(1, NR-1):
        const uint16_t* w${N} = w${N-1} + kc;
        $if N % 2 == 0:
          if XNN_UNPREDICTABLE(n <= ${N}) {
            w${N} = w${N-1};
          }
        $else:
          if XNN_UNPREDICTABLE(n < ${N+1}) {
            w${N} = w${N-1};
          }

      // KC main loop multiple of ${KBLOCK}
      size_t k = kc;
      for (; k >= ${KBLOCK}; k -= ${KBLOCK}) {
        $for N in range(0, NR, 32):
          $for L in range(8):
            $if N+L == NR-1:
              const __m256i v${N+L} = _mm256_setzero_si256();
            $else:
              const __m256i v${N+L} = _mm256_loadu_si256((const __m256i*) w${N+L});
              w${N+L} += ${KBLOCK};
            $if N+L+8 == NR-1:
              const __m256i v${N+L+8} = _mm256_setzero_si256();
            $else:
              const __m256i v${N+L+8} = _mm256_loadu_si256((const __m256i*) w${N+L+8});
              w${N+L+8} += ${KBLOCK};
            $if N+L+16 == NR-1:
              const __m256i v${N+L+16} = _mm256_setzero_si256();
            $else:
              const __m256i v${N+L+16} = _mm256_loadu_si256((const __m256i*) w${N+L+16});
              w${N+L+16} += ${KBLOCK};
            $if N+L+24 == NR-1:
              const __m256i v${N+L+24} = _mm256_setzero_si256();
            $else:
              const __m256i v${N+L+24} = _mm256_loadu_si256((const __m256i*) w${N+L+24});
              w${N+L+24} += ${KBLOCK};
            __m512i z${N+L} = _mm512_inserti64x4(_mm512_castsi256_si512(v${N+L}), v${N+L+8}, 1);
            __m512i z${N+L+8} = _mm512_inserti64x4(_mm512_castsi256_si512(v${N+L+16}), v${N+L+24}, 1);

        $for N in range(0, NR, 32):
          $for B in (0, 8):
            $for L in range(0, 8, 2):
              const __m512i t${N+B+L} = _mm512_unpacklo_epi16(z${N+B+L}, z${N+B+L+1});
              const __m512i t${N+B+L+1} = _mm512_unpackhi_epi16(z${N+B+L}, z${N+B+L+1});

            $for L in range(0, 8, 4):
              const __m512i u${N+B+L} = _mm512_unpacklo_epi32(t${N+B+L}, t${N+B+L+2});
              const __m512i u${N+B+L+1} = _mm512_unpackhi_epi32(t${N+B+L}, t${N+B+L+2});
              const __m512i u${N+B+L+2} = _mm512_unpacklo_epi32(t${N+B+L+1}, t${N+B+L+3});
              const __m512i u${N+B+L+3} = _mm512_unpackhi_epi32(t${N+B+L+1}, t${N+B+L+3});

            const __m512i w${N+B+0} = _mm512_unpacklo_epi64(u${N+B+0}, u${N+B+4});
            const __m512i w${N+B+1} = _mm512_unpackhi_epi64(u${N+B+0}, u${N+B+4});
            const __m512i w${N+B+2} = _mm512_unpacklo_epi64(u${N+B+1}, u${N+B+5});
            const __m512i w${N+B+3} = _mm512_unpackhi_epi64(u${N+B+1}, u${N+B+5});
            const __m512i w${N+B+4} = _mm512_unpacklo_epi64(u${N+B+2}, u${N+B+6});
            const __m512i w${N+B+5} = _mm512_unpackhi_epi64(u${N+B+2}, u${N+B+6});
            const __m512i w${N+B+6} = _mm512_unpacklo_epi64(u${N+B+3}, u${N+B+7});
            const __m512i w${N+B+7} = _mm512_unpackhi_epi64(u${N+B+3}, u${N+B+7});

          $for K in range(8):
            const __m512i out${N}_${K} = _mm512_shuffle_i32x4(w${N+K}, w${N+8+K}, _MM_SHUFFLE(2, 0, 2, 0));
            const __m512i out${N}_${K+8} = _mm512_shuffle_i32x4(w${N+K}, w${N+8+K}, _MM_SHUFFLE(3, 1, 3, 1));
            _mm512_storeu_si512((__m512i*) (packed_w + ${N + K*NR}), out${N}_${K});
            _mm512_storeu_si512((__m512i*) (packed_w + ${N + (K+8)*NR}), out${N}_${K+8});
        packed_w += ${NR * KBLOCK};
      }

      // KC remainder (1..15) using AVX-512BW masking
      if XNN_UNLIKELY(k != 0) {
        assert(k >= 1);
        assert(k <= 15);
        const __mmask16 kmask = _cvtu32_mask16((1U << k) - 1U);

        $for N in range(0, NR, 32):
          $for L in range(8):
            $if N+L == NR-1:
              const __m256i v${N+L} = _mm256_setzero_si256();
            $else:
              const __m256i v${N+L} = _mm256_maskz_loadu_epi16(kmask, w${N+L});
              w${N+L} += k;
            $if N+L+8 == NR-1:
              const __m256i v${N+L+8} = _mm256_setzero_si256();
            $else:
              const __m256i v${N+L+8} = _mm256_maskz_loadu_epi16(kmask, w${N+L+8});
              w${N+L+8} += k;
            $if N+L+16 == NR-1:
              const __m256i v${N+L+16} = _mm256_setzero_si256();
            $else:
              const __m256i v${N+L+16} = _mm256_maskz_loadu_epi16(kmask, w${N+L+16});
              w${N+L+16} += k;
            $if N+L+24 == NR-1:
              const __m256i v${N+L+24} = _mm256_setzero_si256();
            $else:
              const __m256i v${N+L+24} = _mm256_maskz_loadu_epi16(kmask, w${N+L+24});
              w${N+L+24} += k;
            __m512i z${N+L} = _mm512_inserti64x4(_mm512_castsi256_si512(v${N+L}), v${N+L+8}, 1);
            __m512i z${N+L+8} = _mm512_inserti64x4(_mm512_castsi256_si512(v${N+L+16}), v${N+L+24}, 1);

        $for N in range(0, NR, 32):
          $for B in (0, 8):
            $for L in range(0, 8, 2):
              const __m512i t${N+B+L} = _mm512_unpacklo_epi16(z${N+B+L}, z${N+B+L+1});
              const __m512i t${N+B+L+1} = _mm512_unpackhi_epi16(z${N+B+L}, z${N+B+L+1});

            $for L in range(0, 8, 4):
              const __m512i u${N+B+L} = _mm512_unpacklo_epi32(t${N+B+L}, t${N+B+L+2});
              const __m512i u${N+B+L+1} = _mm512_unpackhi_epi32(t${N+B+L}, t${N+B+L+2});
              const __m512i u${N+B+L+2} = _mm512_unpacklo_epi32(t${N+B+L+1}, t${N+B+L+3});
              const __m512i u${N+B+L+3} = _mm512_unpackhi_epi32(t${N+B+L+1}, t${N+B+L+3});

            const __m512i w${N+B+0} = _mm512_unpacklo_epi64(u${N+B+0}, u${N+B+4});
            const __m512i w${N+B+1} = _mm512_unpackhi_epi64(u${N+B+0}, u${N+B+4});
            const __m512i w${N+B+2} = _mm512_unpacklo_epi64(u${N+B+1}, u${N+B+5});
            const __m512i w${N+B+3} = _mm512_unpackhi_epi64(u${N+B+1}, u${N+B+5});
            const __m512i w${N+B+4} = _mm512_unpacklo_epi64(u${N+B+2}, u${N+B+6});
            const __m512i w${N+B+5} = _mm512_unpackhi_epi64(u${N+B+2}, u${N+B+6});
            const __m512i w${N+B+6} = _mm512_unpacklo_epi64(u${N+B+3}, u${N+B+7});
            const __m512i w${N+B+7} = _mm512_unpackhi_epi64(u${N+B+3}, u${N+B+7});

          $for K in range(8):
            const __m512i out${N}_${K} = _mm512_shuffle_i32x4(w${N+K}, w${N+8+K}, _MM_SHUFFLE(2, 0, 2, 0));
            if (k > ${K}) {
              _mm512_storeu_si512((__m512i*) (packed_w + ${N + K*NR}), out${N}_${K});
            }
            const __m512i out${N}_${K+8} = _mm512_shuffle_i32x4(w${N+K}, w${N+8+K}, _MM_SHUFFLE(3, 1, 3, 1));
            if (k > ${K+8}) {
              _mm512_storeu_si512((__m512i*) (packed_w + ${N + (K+8)*NR}), out${N}_${K+8});
            }
        packed_w += ${NR} * k;
      }
      packed_w = (uint16_t*) ((uintptr_t) packed_w + extra_bytes);
    }
    weights += nc * kc;
  } while (--g != 0);
}
