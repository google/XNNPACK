$assert NR in [16, 32, 64]
$assert KR == 2
$assert KBLOCK == 2

#include <assert.h>
#include <stddef.h>
#include <stdint.h>

#include <immintrin.h>

#include "src/xnnpack/common.h"
#include "src/xnnpack/intrinsics-polyfill.h"
#include "src/xnnpack/packw.h"
$if PREFETCH:
  #include "src/xnnpack/prefetch.h"


void xnn_x16_packw_gemm_gio_ukernel_x${NR}c${KR}__avx512skx_u${KBLOCK}${"_prfm" if PREFETCH else ""}(
  size_t g,
  size_t nc,
  size_t kc,
  size_t nr,
  size_t kr,
  size_t sr,
  size_t k_stride,
  const uint16_t* weights,
  const uint16_t* bias,
  const void* scale,
  uint16_t* packed_weights,
  size_t extra_bytes,
  const void* params)
{
  assert(g != 0);
  assert(nc != 0);
  assert(kc != 0);
  assert(nr == ${NR});   // This kernel is for NR=${NR}
  assert(kr == ${KR});
  assert(sr == 1);
  assert(k_stride != 0);
  assert(weights != NULL);
  assert(packed_weights != NULL);

  $if NR == 16:
    const __m256i vzero = _mm256_setzero_si256();
  $else:
    const __m512i vzero = _mm512_setzero_si512();
    const __m512i vperm = _mm512_set_epi64(7, 3, 6, 2, 5, 1, 4, 0);
  const uint16_t* b = bias;
  uint16_t* packed_w = packed_weights;
  do {
    // NC main loop multiple of ${NR}
    const uint16_t* w = weights;
    size_t n = nc;

    for (; n >= ${NR}; n -= ${NR}) {
      if XNN_LIKELY(b != NULL) {
        $if NR == 16:
          const __m256i vb0 = _mm256_loadu_si256((const __m256i*) b);
          _mm256_storeu_si256((__m256i*) packed_w, vb0);
        $else:
          $for N in range(0, NR, 32):
            const __m512i vb${N} = _mm512_loadu_si512((const __m512i*) (b + ${N}));
            _mm512_storeu_si512((__m512i*) (packed_w + ${N}), vb${N});
        b += ${NR};
      } else {
        $if NR == 16:
          _mm256_storeu_si256((__m256i*) packed_w, vzero);
        $else:
          $for N in range(0, NR, 32):
            _mm512_storeu_si512((__m512i*) (packed_w + ${N}), vzero);
      }
      packed_w += ${NR};

      const uint16_t* w_col = w;
      size_t k = kc;
      for (; k >= 2; k -= 2) {
        $if NR == 16:
          const __m256i v0_0 = _mm256_permute4x64_epi64(_mm256_loadu_si256((const __m256i*) w_col), _MM_SHUFFLE(3, 1, 2, 0));
          const __m256i v1_0 = _mm256_permute4x64_epi64(_mm256_loadu_si256((const __m256i*) (w_col + k_stride)), _MM_SHUFFLE(3, 1, 2, 0));
          $if PREFETCH:
            xnn_prefetch_to_l1((const int8_t*) (w_col + 2 * k_stride));
            xnn_prefetch_to_l1((const int8_t*) (w_col + 3 * k_stride));
          const __m256i vlo_0 = _mm256_unpacklo_epi16(v0_0, v1_0);
          const __m256i vhi_0 = _mm256_unpackhi_epi16(v0_0, v1_0);
          _mm256_storeu_si256((__m256i*) packed_w, vlo_0);
          _mm256_storeu_si256((__m256i*) (packed_w + 16), vhi_0);
        $else:
          $for N in range(0, NR, 32):
            const __m512i v0_${N} = _mm512_permutexvar_epi64(vperm, _mm512_loadu_si512((const __m512i*) (w_col + ${N})));
            const __m512i v1_${N} = _mm512_permutexvar_epi64(vperm, _mm512_loadu_si512((const __m512i*) (w_col + k_stride + ${N})));
          $if PREFETCH:
            $for N in range(0, NR, 32):
              xnn_prefetch_to_l1((const int8_t*) (w_col + 2 * k_stride + ${N}));
              xnn_prefetch_to_l1((const int8_t*) (w_col + 3 * k_stride + ${N}));
          $for N in range(0, NR, 32):
            const __m512i vlo_${N} = _mm512_unpacklo_epi16(v0_${N}, v1_${N});
            const __m512i vhi_${N} = _mm512_unpackhi_epi16(v0_${N}, v1_${N});
            _mm512_storeu_si512((__m512i*) (packed_w + ${N * 2}), vlo_${N});
            _mm512_storeu_si512((__m512i*) (packed_w + ${N * 2 + 32}), vhi_${N});
        w_col += 2 * k_stride;
        packed_w += ${NR * 2};
      }

      if XNN_UNLIKELY(k != 0) {
        $if NR == 16:
          const __m256i v0_0 = _mm256_permute4x64_epi64(_mm256_loadu_si256((const __m256i*) w_col), _MM_SHUFFLE(3, 1, 2, 0));
          const __m256i vlo_0 = _mm256_unpacklo_epi16(v0_0, vzero);
          const __m256i vhi_0 = _mm256_unpackhi_epi16(v0_0, vzero);
          _mm256_storeu_si256((__m256i*) packed_w, vlo_0);
          _mm256_storeu_si256((__m256i*) (packed_w + 16), vhi_0);
        $else:
          $for N in range(0, NR, 32):
            const __m512i v0_${N} = _mm512_permutexvar_epi64(vperm, _mm512_loadu_si512((const __m512i*) (w_col + ${N})));
            const __m512i vlo_${N} = _mm512_unpacklo_epi16(v0_${N}, vzero);
            const __m512i vhi_${N} = _mm512_unpackhi_epi16(v0_${N}, vzero);
            _mm512_storeu_si512((__m512i*) (packed_w + ${N * 2}), vlo_${N});
            _mm512_storeu_si512((__m512i*) (packed_w + ${N * 2 + 32}), vhi_${N});
        packed_w += ${NR * 2};
      }
      packed_w = (uint16_t*) ((uintptr_t) packed_w + extra_bytes);
      w += ${NR};
    }

    // NC remainder (1..${NR-1})
    if XNN_UNLIKELY(n != 0) {
      assert(n >= 1);
      assert(n <= ${NR-1});

      $if NR == 16:
        const __mmask16 vmask0 = _cvtu32_mask16((uint32_t) ((UINT32_C(1) << n) - UINT32_C(1)));
      $elif NR == 32:
        const __mmask32 vmask0 = _cvtu32_mask32((uint32_t) ((UINT64_C(1) << n) - UINT64_C(1)));
      $else:
        const uint64_t vmask = (UINT64_C(1) << n) - UINT64_C(1);
        const __mmask32 vmask0 = _cvtu32_mask32((uint32_t) vmask);
        const __mmask32 vmask32 = _cvtu32_mask32((uint32_t) (vmask >> 32));

      if XNN_LIKELY(b != NULL) {
        $if NR == 16:
          const __m256i vb0 = _mm256_maskz_loadu_epi16(vmask0, b);
          _mm256_storeu_si256((__m256i*) packed_w, vb0);
        $else:
          $for N in range(0, NR, 32):
            const __m512i vb${N} = _mm512_maskz_loadu_epi16(vmask${N}, b + ${N});
            _mm512_storeu_si512((__m512i*) (packed_w + ${N}), vb${N});
        b += n;
      } else {
        $if NR == 16:
          _mm256_storeu_si256((__m256i*) packed_w, vzero);
        $else:
          $for N in range(0, NR, 32):
            _mm512_storeu_si512((__m512i*) (packed_w + ${N}), vzero);
      }
      packed_w += ${NR};

      const uint16_t* w_col = w;
      size_t k = kc;
      for (; k >= 2; k -= 2) {
        $if NR == 16:
          const __m256i v0_0 = _mm256_permute4x64_epi64(_mm256_maskz_loadu_epi16(vmask0, w_col), _MM_SHUFFLE(3, 1, 2, 0));
          const __m256i v1_0 = _mm256_permute4x64_epi64(_mm256_maskz_loadu_epi16(vmask0, w_col + k_stride), _MM_SHUFFLE(3, 1, 2, 0));
          const __m256i vlo_0 = _mm256_unpacklo_epi16(v0_0, v1_0);
          const __m256i vhi_0 = _mm256_unpackhi_epi16(v0_0, v1_0);
          _mm256_storeu_si256((__m256i*) packed_w, vlo_0);
          _mm256_storeu_si256((__m256i*) (packed_w + 16), vhi_0);
        $else:
          $for N in range(0, NR, 32):
            const __m512i v0_${N} = _mm512_permutexvar_epi64(vperm, _mm512_maskz_loadu_epi16(vmask${N}, w_col + ${N}));
            const __m512i v1_${N} = _mm512_permutexvar_epi64(vperm, _mm512_maskz_loadu_epi16(vmask${N}, w_col + k_stride + ${N}));
            const __m512i vlo_${N} = _mm512_unpacklo_epi16(v0_${N}, v1_${N});
            const __m512i vhi_${N} = _mm512_unpackhi_epi16(v0_${N}, v1_${N});
            _mm512_storeu_si512((__m512i*) (packed_w + ${N * 2}), vlo_${N});
            _mm512_storeu_si512((__m512i*) (packed_w + ${N * 2 + 32}), vhi_${N});
        w_col += 2 * k_stride;
        packed_w += ${NR * 2};
      }

      if XNN_UNLIKELY(k != 0) {
        $if NR == 16:
          const __m256i v0_0 = _mm256_permute4x64_epi64(_mm256_maskz_loadu_epi16(vmask0, w_col), _MM_SHUFFLE(3, 1, 2, 0));
          const __m256i vlo_0 = _mm256_unpacklo_epi16(v0_0, vzero);
          const __m256i vhi_0 = _mm256_unpackhi_epi16(v0_0, vzero);
          _mm256_storeu_si256((__m256i*) packed_w, vlo_0);
          _mm256_storeu_si256((__m256i*) (packed_w + 16), vhi_0);
        $else:
          $for N in range(0, NR, 32):
            const __m512i v0_${N} = _mm512_permutexvar_epi64(vperm, _mm512_maskz_loadu_epi16(vmask${N}, w_col + ${N}));
            const __m512i vlo_${N} = _mm512_unpacklo_epi16(v0_${N}, vzero);
            const __m512i vhi_${N} = _mm512_unpackhi_epi16(v0_${N}, vzero);
            _mm512_storeu_si512((__m512i*) (packed_w + ${N * 2}), vlo_${N});
            _mm512_storeu_si512((__m512i*) (packed_w + ${N * 2 + 32}), vhi_${N});
        packed_w += ${NR * 2};
      }
      packed_w = (uint16_t*) ((uintptr_t) packed_w + extra_bytes);
    }
    weights += nc * kc;
  } while (--g != 0);
}
