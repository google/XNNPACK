$assert MR >= 1
$assert NR in (8, 16)
$NV = NR // 4
#include <arm_neon.h>
#include <assert.h>
#include <stddef.h>
#include <stdint.h>

#include "src/xnnpack/common.h"
#include "src/xnnpack/gemm.h"
#include "src/xnnpack/math.h"
#include "src/xnnpack/microparams.h"


// Packed weights layout, per block of ${NR} output channels:
//   float bias[${NR}];
//   for each input channel: uint16_t kernel[${NR}];  // bf16
//
// Every bf16 value is widened to fp32 with a 16-bit shift, so this only needs
// NEON FMA (e.g. Apple M1, which has no BF16 instructions).
void xnn_bf16_f32_gemm_minmax_ukernel_${MR}x${NR}__neonfma_lane_ld64(
    size_t mr,
    size_t nc,
    size_t kc,
    const uint16_t* restrict a,
    size_t a_stride,
    const void* restrict w,
    float* restrict c,
    size_t cm_stride,
    size_t cn_stride,
    const struct xnn_f32_minmax_params* restrict params)
{
  assert(mr != 0);
  assert(mr <= ${MR});
  assert(nc != 0);
  assert(kc != 0);
  assert(kc % sizeof(xnn_bfloat16) == 0);
  assert(a != NULL);
  assert(w != NULL);
  assert(c != NULL);

  const uint16_t* a0 = a;
  float* c0 = c;
  $for M in range(1, MR):
    const uint16_t* a${M} = (const uint16_t*) ((uintptr_t) a${M-1} + a_stride);
    float* c${M} = (float*) ((uintptr_t) c${M-1} + cm_stride);
    $if M % 2 == 0:
      if XNN_UNPREDICTABLE(mr <= ${M}) {
        a${M} = a${M-1};
        c${M} = c${M-1};
      }
    $elif M + 1 == MR:
      if XNN_UNPREDICTABLE(mr != ${M+1}) {
        a${M} = a${M-1};
        c${M} = c${M-1};
      }
    $else:
      if XNN_UNPREDICTABLE(mr < ${M+1}) {
        a${M} = a${M-1};
        c${M} = c${M-1};
      }

  const float32x4_t vmin = vdupq_n_f32(params->scalar.min);
  const float32x4_t vmax = vdupq_n_f32(params->scalar.max);
  do {
    $for N in range(NV):
      float32x4_t vacc0x${N} = vld1q_f32((const float*) w + ${N * 4});
    $for M in range(1, MR):
      $for N in range(NV):
        float32x4_t vacc${M}x${N} = vacc0x${N};
    const uint16_t* wk = (const uint16_t*) ((const float*) w + ${NR});

    size_t k = kc;
    for (; k >= 4 * sizeof(xnn_bfloat16); k -= 4 * sizeof(xnn_bfloat16)) {
      $for M in range(MR):
        const float32x4_t va${M} = vreinterpretq_f32_u32(vshll_n_u16(vld1_u16(a${M}), 16));
        a${M} += 4;

      $for L in range(4):
        $for N in range(0, NV, 2):
          const uint16x8_t vb${N}c${L} = vld1q_u16(wk + ${L * NR + N * 4});
          const float32x4_t vb${N}x${L} = vreinterpretq_f32_u32(vshll_n_u16(vget_low_u16(vb${N}c${L}), 16));
          const float32x4_t vb${N + 1}x${L} = vreinterpretq_f32_u32(vshll_n_u16(vget_high_u16(vb${N}c${L}), 16));
        $for M in range(MR):
          $for N in range(NV):
            vacc${M}x${N} = vfmaq_lane_f32(vacc${M}x${N}, vb${N}x${L}, ${"vget_low_f32" if L < 2 else "vget_high_f32"}(va${M}), ${L % 2});
      wk += ${4 * NR};
    }
    for (; k != 0; k -= sizeof(xnn_bfloat16)) {
      $for M in range(MR):
        const float32x4_t va${M} = vdupq_n_f32(math_cvt_fp32_bf16(*a${M}++));

      $for N in range(0, NV, 2):
        const uint16x8_t vb${N}c = vld1q_u16(wk + ${N * 4});
        const float32x4_t vb${N} = vreinterpretq_f32_u32(vshll_n_u16(vget_low_u16(vb${N}c), 16));
        const float32x4_t vb${N + 1} = vreinterpretq_f32_u32(vshll_n_u16(vget_high_u16(vb${N}c), 16));
      wk += ${NR};

      $for M in range(MR):
        $for N in range(NV):
          vacc${M}x${N} = vfmaq_f32(vacc${M}x${N}, va${M}, vb${N});
    }
    w = (const void*) wk;

    $for M in range(MR):
      $for N in range(NV):
        vacc${M}x${N} = vmaxq_f32(vacc${M}x${N}, vmin);
    $for M in range(MR):
      $for N in range(NV):
        vacc${M}x${N} = vminq_f32(vacc${M}x${N}, vmax);

    if XNN_LIKELY(nc >= ${NR}) {
      $for M in range(MR):
        $for N in range(NV):
          vst1q_f32(c${M} + ${N * 4}, vacc${M}x${N});
        c${M} = (float*) ((uintptr_t) c${M} + cn_stride);

      $for M in range(MR):
        a${M} = (const uint16_t*) ((uintptr_t) a${M} - kc);

      nc -= ${NR};
    } else {
      $if NR == 16:
        if (nc & 8) {
          $for M in range(MR):
            vst1q_f32(c${M}, vacc${M}x0);
            vst1q_f32(c${M} + 4, vacc${M}x1);
            vacc${M}x0 = vacc${M}x2;
            vacc${M}x1 = vacc${M}x3;
            c${M} += 8;
        }
      if (nc & 4) {
        $for M in range(MR):
          vst1q_f32(c${M}, vacc${M}x0);
          vacc${M}x0 = vacc${M}x1;
          c${M} += 4;
      }
      $for M in range(MR):
        float32x2_t vacc${M}_lo = vget_low_f32(vacc${M}x0);
      if (nc & 2) {
        $for M in range(MR):
          vst1_f32(c${M}, vacc${M}_lo);
          vacc${M}_lo = vget_high_f32(vacc${M}x0);
          c${M} += 2;
      }
      if (nc & 1) {
        $for M in range(MR):
          vst1_lane_f32(c${M}, vacc${M}_lo, 0);
      }
      nc = 0;
    }
  } while (nc != 0);
}
