$assert CHANNELS in [64, 128]
#include <assert.h>
#include <math.h>
#include <stddef.h>
#include <stdint.h>

#include <hexagon_types.h>
#include <hexagon_protos.h>
#include <hvx_hexagon_protos.h>

#include "src/xnnpack/common.h"
#include "src/xnnpack/intrinsics-polyfill.h"
#include "src/xnnpack/math.h"
#include "src/xnnpack/microparams.h"
#include "src/xnnpack/reduce.h"
#include "src/xnnpack/simd/s32-hvx.h"


void xnn_qs8_rdsum_ukernel_${ACCUMULATORS}p${ACCUMULATORS}x__hvx_u${CHANNELS}(
    size_t rows,
    size_t channels,
    const int8_t* input,
    size_t input_stride,
    const int8_t* zero,
    int32_t* output,
    const struct xnn_qs8_rsum_params* restrict params) XNN_OOB_READS
{
  assert(rows != 0);
  assert(channels != 0);
  assert(input != NULL);
  assert(output != NULL);

  size_t input_increment = ${ACCUMULATORS} * input_stride;
  for (; channels >= ${CHANNELS}; channels -= ${CHANNELS}) {
    const int8_t* i0 = input;
    $for ACC in range(1, ACCUMULATORS):
      const int8_t* i${ACC} = (const int8_t*) ((uintptr_t) input + ${ACC} * input_stride);

    $for C in range(0, CHANNELS, 32):
      HVX_Vector vacc${C} = Q6_V_vzero();

    // 256 int8s may be summed into an int16 before overflowing
    // To prevent handling the tails of the inner 256 loop, we round 256 down to
    // the nearest integer multiple of ACCUMULATORS.
    $OVERFLOW = (256 // ACCUMULATORS) * ACCUMULATORS
    int num_batches = floor((rows + ${OVERFLOW - 1}) / ${OVERFLOW});
    int r = rows;
    for (; num_batches > 0; --num_batches) {
      $for C in range(0, CHANNELS, 64):
        HVX_Vector v16acc_${C} = Q6_V_vzero();
      for (int current_batch = min(r, ${OVERFLOW}); current_batch > 0; current_batch -= ${ACCUMULATORS}) {
        $for N in range(1, ACCUMULATORS, 2):
          if XNN_UNPREDICTABLE(current_batch < ${N+1}) {
            i${N} = zero;
          }
          if XNN_UNPREDICTABLE(current_batch <= ${N+1}) {
            i${N+1} = zero;
          }
        $for ACC in range(ACCUMULATORS):
          $for C in range(0, CHANNELS, 64):
            const HVX_Vector vin${ACC}_${C} = Q6_V_lo_W(Q6_Wh_vunpack_Vb(*((const HVX_UVector*) &i${ACC}[${C}])));
            v16acc_${C} = Q6_Vh_vadd_VhVh(v16acc_${C}, vin${ACC}_${C});
        $for N in range(0, ACCUMULATORS):
          i${N} = (const int8_t*) ((uintptr_t) i${N} + input_increment);
      }
      $for C in range(0, CHANNELS, 64):
        const HVX_VectorPair vacc32_${C} = Q6_Ww_vunpack_Vh(v16acc_${C});
        vacc${C} = Q6_Vw_vadd_VwVw(vacc${C}, Q6_V_lo_W(vacc32_${C}));
        vacc${C+32} = Q6_Vw_vadd_VwVw(vacc${C+32}, Q6_V_hi_W(vacc32_${C}));
      r = doz(r, ${OVERFLOW});
    }

    const int32_t* o = output;
    $for C in range(0, CHANNELS, 32):
      HVX_Vector vo${C} = *((const HVX_UVector*) o); o += 32;
    $for C in range(0, CHANNELS, 32):
      vo${C} = Q6_Vw_vadd_VwVw(vacc${C}, vo${C});
    $for C in range(0, CHANNELS, 32):
      *((HVX_UVector*) output) = vo${C}; output += 32;

    input = (const int8_t*) ((uintptr_t) input + ${CHANNELS} * sizeof(int8_t));
  }
  if (channels != 0) {
    input_increment = ${ACCUMULATORS} * input_stride;
    // 256 int8s may be summed into an int16 before overflowing.
    do {
      int num_batches = floor((rows + ${OVERFLOW - 1}) / ${OVERFLOW});
      int r = rows;
      const int8_t* i0 = input;
      $for ACC in range(1, ACCUMULATORS):
        const int8_t* i${ACC} = (const int8_t*) ((uintptr_t) input + ${ACC} * input_stride);

      HVX_Vector vacc0 = Q6_V_vzero();
      HVX_Vector vacc1 = Q6_V_vzero();

      for (; num_batches > 0; --num_batches) {
        HVX_Vector v16acc = Q6_V_vzero();
        for (int current_batch = min(r, ${OVERFLOW}); current_batch > 0; current_batch -= ${ACCUMULATORS}) {
          $for N in range(1, ACCUMULATORS, 2):
            if XNN_UNPREDICTABLE(current_batch < ${N+1}) {
              i${N} = zero;
            }
            if XNN_UNPREDICTABLE(current_batch <= ${N+1}) {
              i${N+1} = zero;
            }

          $for ACC in range(ACCUMULATORS):
            const HVX_Vector vin${ACC} = Q6_V_lo_W(Q6_Wh_vunpack_Vb(*((const HVX_UVector*) &i${ACC}[0])));
            v16acc = Q6_Vh_vadd_VhVh(v16acc, vin${ACC});
          $for N in range(ACCUMULATORS):
            i${N} = (const int8_t*) ((uintptr_t) i${N} + input_increment);
        }
        const HVX_VectorPair vacc32 = Q6_Ww_vunpack_Vh(v16acc);
        vacc0 = Q6_Vw_vadd_VwVw(vacc0, Q6_V_lo_W(vacc32));
        vacc1 = Q6_Vw_vadd_VwVw(vacc1, Q6_V_hi_W(vacc32));
        r = doz(r, ${OVERFLOW});
      }

      if XNN_LIKELY(channels >= 64) {
        HVX_Vector vo0 = *((const HVX_UVector*) output);
        HVX_Vector vo1 = *((const HVX_UVector*) (output + 32));
        vo0 = Q6_Vw_vadd_VwVw(vo0, vacc0);
        vo1 = Q6_Vw_vadd_VwVw(vo1, vacc1);
        *((HVX_UVector*) output) = vo0; output += 32;
        *((HVX_UVector*) output) = vo1; output += 32;
        channels -= 64;
        input = (const int8_t*) ((uintptr_t) input + 64 * sizeof(int8_t));
      } else {
        if (channels >= 32) {
          HVX_Vector vo0 = *((const HVX_UVector*) output);
          vo0 = Q6_Vw_vadd_VwVw(vo0, vacc0);
          *((HVX_UVector*) output) = vo0; output += 32;
          channels -= 32;
          vacc0 = vacc1;
        }
        if (channels != 0) {
          HVX_Vector vo0 = xnn_load_tail_safe_s32(output, channels);
          vo0 = Q6_Vw_vadd_VwVw(vo0, vacc0);
          Q6_V_vstu_variable(output, channels * sizeof(int32_t), vo0);
        }
        channels = 0;
      }
    } while (channels != 0);
  }
}
