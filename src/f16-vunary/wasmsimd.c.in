$assert BATCH_TILE % 8 == 0
$assert BATCH_TILE >= 8
$SIMD_TILE = BATCH_TILE // 8
$ABC = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
$assert OP in ["ABS", "NEG"]
#include <assert.h>
#include <stddef.h>
#include <stdint.h>

#include <wasm_simd128.h>

#include "src/xnnpack/common.h"
#include "src/xnnpack/math.h"
#include "src/xnnpack/microparams.h"
#include "src/xnnpack/vunary.h"


$WASM_OP_V128 = {
$  "ABS": lambda x: "wasm_v128_and(%s, vnonsign_mask)" % x,
$  "NEG": lambda x: "wasm_v128_xor(%s, vsign_mask)" % x,
$}[OP]
void xnn_f16_v${OP.lower()}_ukernel__wasmsimd_u${BATCH_TILE}(
    size_t batch,
    const xnn_float16* input,
    xnn_float16* output,
    const struct xnn_f16_default_params* restrict params) XNN_OOB_READS
{
  assert(batch != 0);
  assert(batch % sizeof(uint16_t) == 0);
  assert(input != NULL);
  assert(output != NULL);

  const uint16_t* i = (const uint16_t*) input;
  uint16_t* o = (uint16_t*) output;
  $if OP == "ABS":
    const v128_t vnonsign_mask = wasm_u16x8_const_splat(UINT16_C(0x7FFF));
    XNN_FORCE_REALIZATION(vnonsign_mask);
  $elif OP == "NEG":
    const v128_t vsign_mask = wasm_u16x8_const_splat(UINT16_C(0x8000));
    XNN_FORCE_REALIZATION(vsign_mask);
  $if BATCH_TILE > 8:
    for (; batch >= ${BATCH_TILE} * sizeof(uint16_t); batch -= ${BATCH_TILE} * sizeof(uint16_t)) {
      v128_t vacc${ABC[0]} = wasm_v128_load(i);
      $for N in range(1, SIMD_TILE):
        v128_t vacc${ABC[N]} = wasm_v128_load(i + ${N * 8});
      i += ${BATCH_TILE};

      $for N in range(SIMD_TILE):
        vacc${ABC[N]} = ${WASM_OP_V128("vacc" + ABC[N])};

      wasm_v128_store(o, vacc${ABC[0]});
      $for N in range(1, SIMD_TILE):
        wasm_v128_store(o + ${N * 8}, vacc${ABC[N]});
      o += ${BATCH_TILE};
    }
  for (; batch >= 8 * sizeof(uint16_t); batch -= 8 * sizeof(uint16_t)) {
    v128_t vacc = wasm_v128_load(i);
    i += 8;
    vacc = ${WASM_OP_V128("vacc")};
    wasm_v128_store(o, vacc);
    o += 8;
  }
  if XNN_UNLIKELY(batch != 0) {
    v128_t vacc = wasm_v128_load(i);
    vacc = ${WASM_OP_V128("vacc")};
    if (batch & (4 * sizeof(uint16_t))) {
      wasm_v128_store64_lane(o, vacc, 0);
      vacc = wasm_i64x2_shuffle(vacc, vacc, 1, 1);
      o += 4;
    }
    if (batch & (2 * sizeof(uint16_t))) {
      wasm_v128_store32_lane(o, vacc, 0);
      vacc = wasm_i64x2_shr(vacc, 32);
      o += 2;
    }
    if (batch & (1 * sizeof(uint16_t))) {
      wasm_v128_store16_lane(o, vacc, 0);
    }
  }
}
