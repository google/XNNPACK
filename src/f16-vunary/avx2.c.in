$assert BATCH_TILE % 16 == 0
$assert BATCH_TILE >= 16
$SIMD_TILE = BATCH_TILE // 16
$ABC = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
$assert OP in ["ABS", "NEG"]
#include <assert.h>
#include <stddef.h>
#include <stdint.h>

#include <immintrin.h>

#include "src/xnnpack/common.h"
#include "src/xnnpack/math.h"
#include "src/xnnpack/microparams.h"
#include "src/xnnpack/unaligned.h"
#include "src/xnnpack/vunary.h"


$_MM256_OP_SI256 = {
$  "ABS": lambda x: "_mm256_and_si256(%s, vnonsign_mask)" % x,
$  "NEG": lambda x: "_mm256_xor_si256(%s, vsign_mask)" % x,
$}[OP]
$_MM_OP_SI128 = {
$  "ABS": lambda x: "_mm_and_si128(%s, _mm256_castsi256_si128(vnonsign_mask))" % x,
$  "NEG": lambda x: "_mm_xor_si128(%s, _mm256_castsi256_si128(vsign_mask))" % x,
$}[OP]
void xnn_f16_v${OP.lower()}_ukernel__avx2_u${BATCH_TILE}(
    size_t batch,
    const xnn_float16* input,
    xnn_float16* output,
    const struct xnn_f16_default_params* restrict params) XNN_OOB_READS
{
  assert(batch != 0);
  assert(batch % sizeof(uint16_t) == 0);
  assert(input != NULL);
  assert(output != NULL);

  const uint16_t* i = (const uint16_t*) input;
  uint16_t* o = (uint16_t*) output;
  $if OP == "ABS":
    const __m256i vnonsign_mask = _mm256_set1_epi16(0x7FFF);
  $elif OP == "NEG":
    const __m256i vsign_mask = _mm256_set1_epi16(0x8000);
  $if BATCH_TILE > 16:
    for (; batch >= ${BATCH_TILE} * sizeof(uint16_t); batch -= ${BATCH_TILE} * sizeof(uint16_t)) {
      __m256i vacc${ABC[0]} = _mm256_loadu_si256((const __m256i*) i);
      $for N in range(1, SIMD_TILE):
        __m256i vacc${ABC[N]} = _mm256_loadu_si256((const __m256i*) (i + ${N * 16}));
      i += ${BATCH_TILE};

      $for N in range(SIMD_TILE):
        vacc${ABC[N]} = ${_MM256_OP_SI256("vacc" + ABC[N])};

      _mm256_storeu_si256((__m256i*) o, vacc${ABC[0]});
      $for N in range(1, SIMD_TILE):
        _mm256_storeu_si256((__m256i*) (o + ${N * 16}), vacc${ABC[N]});
      o += ${BATCH_TILE};
    }
  for (; batch >= 16 * sizeof(uint16_t); batch -= 16 * sizeof(uint16_t)) {
    __m256i vacc = _mm256_loadu_si256((const __m256i*) i);
    i += 16;
    vacc = ${_MM256_OP_SI256("vacc")};
    _mm256_storeu_si256((__m256i*) o, vacc);
    o += 16;
  }
  for (; batch >= 8 * sizeof(uint16_t); batch -= 8 * sizeof(uint16_t)) {
    __m128i vacc = _mm_loadu_si128((const __m128i*) i);
    i += 8;
    vacc = ${_MM_OP_SI128("vacc")};
    _mm_storeu_si128((__m128i*) o, vacc);
    o += 8;
  }
  if XNN_UNLIKELY(batch != 0) {
    __m128i vacc = _mm_loadu_si128((const __m128i*) i);
    vacc = ${_MM_OP_SI128("vacc")};
    if (batch & (4 * sizeof(uint16_t))) {
      _mm_storel_epi64((__m128i*) o, vacc);
      o += 4;
      vacc = _mm_unpackhi_epi64(vacc, vacc);
    }
    if (batch & (2 * sizeof(uint16_t))) {
      unaligned_store_u32(o, (uint32_t) _mm_cvtsi128_si32(vacc));
      o += 2;
      vacc = _mm_srli_epi64(vacc, 32);
    }
    if (batch & (1 * sizeof(uint16_t))) {
      *o = (uint16_t) _mm_extract_epi16(vacc, 0);
    }
  }
}
