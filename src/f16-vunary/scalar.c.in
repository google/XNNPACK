$assert BATCH_TILE >= 1
$assert OP in ["ABS", "NEG"]
#include <assert.h>
#include <stddef.h>
#include <stdint.h>

#include "src/xnnpack/common.h"
#include "src/xnnpack/math.h"
#include "src/xnnpack/microparams.h"
#include "src/xnnpack/vunary.h"


$SCALAR_OP = {
$  "ABS": lambda x: "%s & vnonsign_mask" % x,
$  "NEG": lambda x: "%s ^ vsign_mask" % x,
$}[OP]
void xnn_f16_v${OP.lower()}_ukernel__scalar_u${BATCH_TILE}(
    size_t batch,
    const xnn_float16* input,
    xnn_float16* output,
    const struct xnn_f16_default_params* restrict params)
{
  assert(batch != 0);
  assert(batch % sizeof(uint16_t) == 0);
  assert(input != NULL);
  assert(output != NULL);

  const uint16_t* i = (const uint16_t*) input;
  uint16_t* o = (uint16_t*) output;
  $if OP == "ABS":
    const uint16_t vnonsign_mask = UINT16_C(0x7FFF);
  $elif OP == "NEG":
    const uint16_t vsign_mask = UINT16_C(0x8000);
  $if BATCH_TILE > 1:
    for (; batch >= ${BATCH_TILE} * sizeof(uint16_t); batch -= ${BATCH_TILE} * sizeof(uint16_t)) {
      $for N in range(BATCH_TILE):
        uint16_t vacc${N} = i[${N}];
      i += ${BATCH_TILE};

      $for N in range(BATCH_TILE):
        vacc${N} = ${SCALAR_OP("vacc" + str(N))};

      $for N in range(BATCH_TILE):
        o[${N}] = vacc${N};
      o += ${BATCH_TILE};
    }
  $if BATCH_TILE == 1:
    do {
      uint16_t vacc = *i++;
      vacc = ${SCALAR_OP("vacc")};
      *o++ = vacc;
      batch -= sizeof(uint16_t);
    } while (batch != 0);
  $elif BATCH_TILE == 2:
    if XNN_UNLIKELY(batch != 0) {
      uint16_t vacc = *i;
      vacc = ${SCALAR_OP("vacc")};
      *o = vacc;
    }
  $else:
    if XNN_UNLIKELY(batch != 0) {
      do {
        uint16_t vacc = *i++;
        vacc = ${SCALAR_OP("vacc")};
        *o++ = vacc;
        batch -= sizeof(uint16_t);
      } while (batch != 0);
    }
}
