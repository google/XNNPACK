$assert DATATYPE in ["QS8", "QU8"]
$assert BATCH_TILE % 32 == 0
$assert BATCH_TILE >= 32
#include <assert.h>
#include <stddef.h>
#include <stdint.h>

#include "src/xnnpack/common.h"
#include "src/xnnpack/microparams.h"
#include "src/xnnpack/simd/f32-hvx.h"
#include "src/xnnpack/vcvt.h"


$XINT8_T = {"QS8": "int8_t", "QU8": "uint8_t"}[DATATYPE]
$VUNPACK_XB = {"QS8": "Q6_Wh_vunpack_Vb", "QU8": "Q6_Wuh_vunpack_Vub"}[DATATYPE]
void xnn_${DATATYPE.lower()}_f32_vcvt_ukernel__hvx_u${BATCH_TILE}(
    size_t batch,
    const ${XINT8_T}* input,
    float* output,
    const struct xnn_${DATATYPE.lower()}_f32_cvt_params* restrict params) XNN_OOB_READS
{
  assert(batch != 0);
  assert(batch % sizeof(${XINT8_T}) == 0);
  assert(input != NULL);
  assert(output != NULL);

  const HVX_Vector vzero_point = Q6_Vh_vsplat_R(params->scalar.zero_point);
  const HVX_Vector vscale = xnn_set1_f32(params->scalar.scale);
  XNN_FORCE_REALIZATION(vzero_point);
  XNN_FORCE_REALIZATION(vscale);
  $if BATCH_TILE > 32:
    for (; batch >= ${BATCH_TILE} * sizeof(${XINT8_T}); batch -= ${BATCH_TILE} * sizeof(${XINT8_T})) {
      $for N in range(0, BATCH_TILE, 128):
        const HVX_Vector vx${N // 128} = *((const HVX_UVector*) (input + ${N}));
      input += ${BATCH_TILE};

      $for N in range(0, BATCH_TILE, 128):
        const HVX_VectorPair vh_pair${N // 128} = ${VUNPACK_XB}(vx${N // 128});
        HVX_Vector vh${N // 64} = Q6_Vh_vsub_VhVh(Q6_V_lo_W(vh_pair${N // 128}), vzero_point);
        $if N + 64 < BATCH_TILE:
          HVX_Vector vh${(N + 64) // 64} = Q6_Vh_vsub_VhVh(Q6_V_hi_W(vh_pair${N // 128}), vzero_point);

      $for N in range(0, BATCH_TILE, 64):
        const HVX_VectorPair vw_pair${N // 64} = Q6_Ww_vunpack_Vh(vh${N // 64});
        const HVX_Vector vy${N // 32} = xnn_mul_f32(Q6_Vsf_equals_Vw(Q6_V_lo_W(vw_pair${N // 64})), vscale);
        $if N + 32 < BATCH_TILE:
          const HVX_Vector vy${(N + 32) // 32} = xnn_mul_f32(Q6_Vsf_equals_Vw(Q6_V_hi_W(vw_pair${N // 64})), vscale);

      $for N in range(0, BATCH_TILE, 32):
        xnn_storeu_f32(output + ${N}, vy${N // 32});
      output += ${BATCH_TILE};
    }
  $if BATCH_TILE > 64:
    for (; batch >= 64 * sizeof(${XINT8_T}); batch -= 64 * sizeof(${XINT8_T})) {
      const HVX_Vector vx = *((const HVX_UVector*) input);
      input += 64;

      const HVX_Vector vh = Q6_Vh_vsub_VhVh(Q6_V_lo_W(${VUNPACK_XB}(vx)), vzero_point);
      const HVX_VectorPair vw_pair = Q6_Ww_vunpack_Vh(vh);
      const HVX_Vector vy0 = xnn_mul_f32(Q6_Vsf_equals_Vw(Q6_V_lo_W(vw_pair)), vscale);
      const HVX_Vector vy1 = xnn_mul_f32(Q6_Vsf_equals_Vw(Q6_V_hi_W(vw_pair)), vscale);

      xnn_storeu_f32(output, vy0);
      xnn_storeu_f32(output + 32, vy1);
      output += 64;
    }
  for (; batch >= 32 * sizeof(${XINT8_T}); batch -= 32 * sizeof(${XINT8_T})) {
    const HVX_Vector vx = *((const HVX_UVector*) input);
    input += 32;

    const HVX_Vector vh = Q6_Vh_vsub_VhVh(Q6_V_lo_W(${VUNPACK_XB}(vx)), vzero_point);
    const HVX_Vector vw = Q6_V_lo_W(Q6_Ww_vunpack_Vh(vh));
    const HVX_Vector vy = xnn_mul_f32(Q6_Vsf_equals_Vw(vw), vscale);

    xnn_storeu_f32(output, vy);
    output += 32;
  }
  if XNN_UNLIKELY(batch != 0) {
    assert(batch >= 1 * sizeof(${XINT8_T}));
    assert(batch <= 31 * sizeof(${XINT8_T}));

    const HVX_Vector vx = *((const HVX_UVector*) input);
    const HVX_Vector vh = Q6_Vh_vsub_VhVh(Q6_V_lo_W(${VUNPACK_XB}(vx)), vzero_point);
    const HVX_Vector vw = Q6_V_lo_W(Q6_Ww_vunpack_Vh(vh));
    const HVX_Vector vy = xnn_mul_f32(Q6_Vsf_equals_Vw(vw), vscale);

    xnn_store_tail_f32(output, vy, batch);
  }
}
