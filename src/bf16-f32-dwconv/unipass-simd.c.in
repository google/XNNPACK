$assert ARCH in ("avx2", "avx512skx")
$SIMD_SIZE = {"avx2": 8, "avx512skx": 16}[ARCH]
$assert CHANNEL_TILE % SIMD_SIZE == 0
$assert KERNEL_TILE >= 2
$assert ACCUMULATORS >= 1
#include <assert.h>
#include <immintrin.h>
#include <stddef.h>
#include <stdint.h>

#include "src/xnnpack/common.h"
#include "src/xnnpack/dwconv.h"
#include "src/xnnpack/intrinsics-polyfill.h"
#include "src/xnnpack/microparams.h"


$if ARCH == "avx512skx":
  $VEC = "__m512"
  $FMADD = "_mm512_fmadd_ps"
  $MUL = "_mm512_mul_ps"
  $ADD = "_mm512_add_ps"
  $MAX = "_mm512_max_ps"
  $MIN = "_mm512_min_ps"
  $SET1 = "_mm512_set1_ps"
  $LOADU = "_mm512_loadu_ps"
  $STOREU = "_mm512_storeu_ps"
  static XNN_INLINE __m512 load_bf16_as_f32(const uint16_t* ptr) {
    return _mm512_castsi512_ps(_mm512_slli_epi32(
        _mm512_cvtepu16_epi32(_mm256_loadu_si256((const __m256i*) ptr)), 16));
  }

  static XNN_INLINE __m512 maskz_load_bf16_as_f32(__mmask16 mask,
                                                  const uint16_t* ptr) {
    return _mm512_castsi512_ps(_mm512_slli_epi32(
        _mm512_cvtepu16_epi32(_mm256_maskz_loadu_epi16(mask, ptr)), 16));
  }
$else:
  $VEC = "__m256"
  $FMADD = "_mm256_fmadd_ps"
  $MUL = "_mm256_mul_ps"
  $ADD = "_mm256_add_ps"
  $MAX = "_mm256_max_ps"
  $MIN = "_mm256_min_ps"
  $SET1 = "_mm256_set1_ps"
  $LOADU = "_mm256_loadu_ps"
  $STOREU = "_mm256_storeu_ps"
  static XNN_INLINE __m256 load_bf16_as_f32(const uint16_t* ptr) {
    return _mm256_castsi256_ps(_mm256_slli_epi32(
        _mm256_cvtepu16_epi32(_mm_loadu_si128((const __m128i*) ptr)), 16));
  }

// Packed weights layout, per block of ${CHANNEL_TILE} channels:
//   float bias[${CHANNEL_TILE}];
//   uint16_t kernel[${KERNEL_TILE}][${CHANNEL_TILE}];  // bf16
void xnn_bf16_f32_dwconv_minmax_ukernel_${KERNEL_TILE}p${CHANNEL_TILE}c__${ARCH}${"" if ACCUMULATORS == 1 else "_acc%d" % ACCUMULATORS}(
    size_t channels,
    size_t output_width,
    const xnn_bfloat16** input,
    const void* weights,
    float* output,
    intptr_t input_stride,
    size_t output_increment,
    size_t input_offset,
    size_t input_pixel_stride,
    const xnn_bfloat16* zero,
    const struct xnn_f32_minmax_params* restrict params)${" XNN_OOB_READS" if ARCH == "avx2" else ""}
{
  assert(channels != 0);
  assert(output_width != 0);

  const ${VEC} vmin = ${SET1}(params->scalar.min);
  const ${VEC} vmax = ${SET1}(params->scalar.max);
  do {
    $for K in range(KERNEL_TILE):
      const uint16_t* i${K} = (const uint16_t*) input[${K}];
      assert(i${K} != NULL);
      if XNN_UNPREDICTABLE(i${K} != (const uint16_t*) zero) {
        i${K} = (const uint16_t*) ((uintptr_t) i${K} + input_offset);
      }
    input = (const xnn_bfloat16**) ((uintptr_t) input + input_stride);

    size_t c = channels;
    const float* wb = (const float*) weights;
    for (; c >= ${CHANNEL_TILE}; c -= ${CHANNEL_TILE}) {
      const uint16_t* wk = (const uint16_t*) (wb + ${CHANNEL_TILE});
      $for C in range(0, CHANNEL_TILE, SIMD_SIZE):
        ${VEC} vacc${C}p0 = ${LOADU}(wb + ${C});

      $for K in range(KERNEL_TILE):

        $for C in range(0, CHANNEL_TILE, SIMD_SIZE):
          const ${VEC} vi${K}x${C} = load_bf16_as_f32(i${K} + ${C});
        i${K} += ${CHANNEL_TILE};

        $for C in range(0, CHANNEL_TILE, SIMD_SIZE):
          const ${VEC} vk${K}x${C} = load_bf16_as_f32(wk + ${K * CHANNEL_TILE + C});
        $for C in range(0, CHANNEL_TILE, SIMD_SIZE):
          $if 1 <= K < ACCUMULATORS:
            ${VEC} vacc${C}p${K} = ${MUL}(vi${K}x${C}, vk${K}x${C});
          $else:
            vacc${C}p${K % ACCUMULATORS} = ${FMADD}(vi${K}x${C}, vk${K}x${C}, vacc${C}p${K % ACCUMULATORS});

      wb = (const float*) (wk + ${KERNEL_TILE * CHANNEL_TILE});

      $if ACCUMULATORS > 1:
        $ACC_SLICE = 1
        $while ACC_SLICE < ACCUMULATORS:
          $for A in range(0, ACCUMULATORS, ACC_SLICE * 2):
            $if A + ACC_SLICE < ACCUMULATORS:
              $for C in range(0, CHANNEL_TILE, SIMD_SIZE):
                vacc${C}p${A} = ${ADD}(vacc${C}p${A}, vacc${C}p${A + ACC_SLICE});
          $ACC_SLICE *= 2

      $for C in range(0, CHANNEL_TILE, SIMD_SIZE):
        ${VEC} vacc${C} = ${MAX}(vmin, vacc${C}p0);
      $for C in range(0, CHANNEL_TILE, SIMD_SIZE):
        vacc${C} = ${MIN}(vmax, vacc${C});

      $for C in range(0, CHANNEL_TILE, SIMD_SIZE):
        ${STOREU}(output + ${C}, vacc${C});
      output += ${CHANNEL_TILE};
    }
    if XNN_UNLIKELY(c != 0) {
      const uint16_t* wk = (const uint16_t*) (wb + ${CHANNEL_TILE});
      $if CHANNEL_TILE > SIMD_SIZE:
        for (; c >= ${SIMD_SIZE}; c -= ${SIMD_SIZE}) {
          ${VEC} vacc0p0 = ${LOADU}(wb);
          $for K in range(KERNEL_TILE):

            const ${VEC} vi${K}x0 = load_bf16_as_f32(i${K});
            i${K} += ${SIMD_SIZE};

            const ${VEC} vk${K}x0 = load_bf16_as_f32(wk + ${K * CHANNEL_TILE});
            $if 1 <= K < ACCUMULATORS:
              ${VEC} vacc0p${K} = ${MUL}(vi${K}x0, vk${K}x0);
            $else:
              vacc0p${K % ACCUMULATORS} = ${FMADD}(vi${K}x0, vk${K}x0, vacc0p${K % ACCUMULATORS});

          wb += ${SIMD_SIZE};
          wk += ${SIMD_SIZE};

          $if ACCUMULATORS > 1:
            $ACC_SLICE = 1
            $while ACC_SLICE < ACCUMULATORS:
              $for A in range(0, ACCUMULATORS, ACC_SLICE * 2):
                $if A + ACC_SLICE < ACCUMULATORS:
                  vacc0p${A} = ${ADD}(vacc0p${A}, vacc0p${A + ACC_SLICE});
              $ACC_SLICE *= 2

          ${VEC} vacc0 = ${MAX}(vmin, vacc0p0);
          vacc0 = ${MIN}(vmax, vacc0);

          ${STOREU}(output, vacc0);
          output += ${SIMD_SIZE};
        }
      if XNN_LIKELY(c != 0) {
        $if ARCH == "avx512skx":
          const __mmask16 vmask = _cvtu32_mask16((uint32_t) ((UINT32_C(1) << c) - 1));
          ${VEC} vacc0p0 = _mm512_maskz_loadu_ps(vmask, wb);
          $for K in range(KERNEL_TILE):

            const ${VEC} vi${K}x0 = maskz_load_bf16_as_f32(vmask, i${K});
            const ${VEC} vk${K}x0 = maskz_load_bf16_as_f32(vmask, wk + ${K * CHANNEL_TILE});
            $if 1 <= K < ACCUMULATORS:
              ${VEC} vacc0p${K} = ${MUL}(vi${K}x0, vk${K}x0);
            $else:
              vacc0p${K % ACCUMULATORS} = ${FMADD}(vi${K}x0, vk${K}x0, vacc0p${K % ACCUMULATORS});
        $else:
          // Reads past the last channel are covered by XNN_EXTRA_BYTES on the
          // inputs and by the channel tile padding of the packed weights.
          ${VEC} vacc0p0 = ${LOADU}(wb);
          $for K in range(KERNEL_TILE):

            const ${VEC} vi${K}x0 = load_bf16_as_f32(i${K});
            const ${VEC} vk${K}x0 = load_bf16_as_f32(wk + ${K * CHANNEL_TILE});
            $if 1 <= K < ACCUMULATORS:
              ${VEC} vacc0p${K} = ${MUL}(vi${K}x0, vk${K}x0);
            $else:
              vacc0p${K % ACCUMULATORS} = ${FMADD}(vi${K}x0, vk${K}x0, vacc0p${K % ACCUMULATORS});

        $if ACCUMULATORS > 1:
          $ACC_SLICE = 1
          $while ACC_SLICE < ACCUMULATORS:
            $for A in range(0, ACCUMULATORS, ACC_SLICE * 2):
              $if A + ACC_SLICE < ACCUMULATORS:
                vacc0p${A} = ${ADD}(vacc0p${A}, vacc0p${A + ACC_SLICE});
            $ACC_SLICE *= 2

        ${VEC} vacc0 = ${MAX}(vmin, vacc0p0);
        vacc0 = ${MIN}(vmax, vacc0);

        $if ARCH == "avx512skx":
          _mm512_mask_storeu_ps(output, vmask, vacc0);
          output += c;
        $else:
          __m128 vacc0_lo = _mm256_castps256_ps128(vacc0);
          if (c & 4) {
            _mm_storeu_ps(output, vacc0_lo);
            vacc0_lo = _mm256_extractf128_ps(vacc0, 1);
            output += 4;
          }
          if (c & 2) {
            _mm_storel_pi((__m64*) output, vacc0_lo);
            vacc0_lo = _mm_movehl_ps(vacc0_lo, vacc0_lo);
            output += 2;
          }
          if (c & 1) {
            _mm_store_ss(output, vacc0_lo);
            output += 1;
          }
      }
    }

    input_offset += input_pixel_stride;
    output = (float*) ((uintptr_t) output + output_increment);
  } while (--output_width != 0);
}
