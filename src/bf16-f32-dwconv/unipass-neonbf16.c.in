$assert CHANNEL_TILE % 8 == 0
$assert KERNEL_TILE >= 2
$assert ACCUMULATORS >= 1
#include <arm_neon.h>
#include <assert.h>
#include <stddef.h>
#include <stdint.h>

#include "src/xnnpack/common.h"
#include "src/xnnpack/dwconv.h"
#include "src/xnnpack/microparams.h"


// Packed weights layout, per block of ${CHANNEL_TILE} channels:
//   float bias[${CHANNEL_TILE}];
//   uint16_t kernel[${KERNEL_TILE}][${CHANNEL_TILE}];  // bf16
//
// BFMLALB/BFMLALT multiply-accumulate the even/odd bf16 lanes into fp32, so
// every group of 8 channels is accumulated as its even and odd channels and
// re-interleaved before the store. This needs the Arm BF16 extension (e.g.
// Apple M2 and later).
void xnn_bf16_f32_dwconv_minmax_ukernel_${KERNEL_TILE}p${CHANNEL_TILE}c__neonbf16${"" if ACCUMULATORS == 1 else "_acc%d" % ACCUMULATORS}(
    size_t channels,
    size_t output_width,
    const xnn_bfloat16** input,
    const void* weights,
    float* output,
    intptr_t input_stride,
    size_t output_increment,
    size_t input_offset,
    size_t input_pixel_stride,
    const xnn_bfloat16* zero,
    const struct xnn_f32_minmax_params* restrict params) XNN_OOB_READS
{
  assert(channels != 0);
  assert(output_width != 0);

  const float32x4_t vmin = vdupq_n_f32(params->scalar.min);
  const float32x4_t vmax = vdupq_n_f32(params->scalar.max);
  do {
    $for K in range(KERNEL_TILE):
      const uint16_t* i${K} = (const uint16_t*) input[${K}];
      assert(i${K} != NULL);
      if XNN_UNPREDICTABLE(i${K} != (const uint16_t*) zero) {
        i${K} = (const uint16_t*) ((uintptr_t) i${K} + input_offset);
      }
    input = (const xnn_bfloat16**) ((uintptr_t) input + input_stride);

    size_t c = channels;
    const float* wb = (const float*) weights;
    for (; c >= ${CHANNEL_TILE}; c -= ${CHANNEL_TILE}) {
      const uint16_t* wk = (const uint16_t*) (wb + ${CHANNEL_TILE});
      $for C in range(0, CHANNEL_TILE, 8):
        const float32x4x2_t vbias${C} = vuzpq_f32(vld1q_f32(wb + ${C}), vld1q_f32(wb + ${C + 4}));
        float32x4_t vacc${C}ep0 = vbias${C}.val[0];
        float32x4_t vacc${C}op0 = vbias${C}.val[1];

      $for K in range(KERNEL_TILE):

        $for C in range(0, CHANNEL_TILE, 8):
          const bfloat16x8_t vi${K}x${C} = vreinterpretq_bf16_u16(vld1q_u16(i${K} + ${C}));
        i${K} += ${CHANNEL_TILE};

        $for C in range(0, CHANNEL_TILE, 8):
          const bfloat16x8_t vk${K}x${C} = vreinterpretq_bf16_u16(vld1q_u16(wk + ${K * CHANNEL_TILE + C}));
        $for C in range(0, CHANNEL_TILE, 8):
          $if 1 <= K < ACCUMULATORS:
            float32x4_t vacc${C}ep${K} = vbfmlalbq_f32(vdupq_n_f32(0.0f), vi${K}x${C}, vk${K}x${C});
            float32x4_t vacc${C}op${K} = vbfmlaltq_f32(vdupq_n_f32(0.0f), vi${K}x${C}, vk${K}x${C});
          $else:
            vacc${C}ep${K % ACCUMULATORS} = vbfmlalbq_f32(vacc${C}ep${K % ACCUMULATORS}, vi${K}x${C}, vk${K}x${C});
            vacc${C}op${K % ACCUMULATORS} = vbfmlaltq_f32(vacc${C}op${K % ACCUMULATORS}, vi${K}x${C}, vk${K}x${C});

      wb = (const float*) (wk + ${KERNEL_TILE * CHANNEL_TILE});

      $if ACCUMULATORS > 1:
        $ACC_SLICE = 1
        $while ACC_SLICE < ACCUMULATORS:
          $for A in range(0, ACCUMULATORS, ACC_SLICE * 2):
            $if A + ACC_SLICE < ACCUMULATORS:
              $for C in range(0, CHANNEL_TILE, 8):
                vacc${C}ep${A} = vaddq_f32(vacc${C}ep${A}, vacc${C}ep${A + ACC_SLICE});
                vacc${C}op${A} = vaddq_f32(vacc${C}op${A}, vacc${C}op${A + ACC_SLICE});
          $ACC_SLICE *= 2

      $for C in range(0, CHANNEL_TILE, 8):
        const float32x4x2_t vacc${C} = vzipq_f32(
            vminq_f32(vmaxq_f32(vacc${C}ep0, vmin), vmax),
            vminq_f32(vmaxq_f32(vacc${C}op0, vmin), vmax));

      $for C in range(0, CHANNEL_TILE, 8):
        vst1q_f32(output + ${C}, vacc${C}.val[0]);
        vst1q_f32(output + ${C + 4}, vacc${C}.val[1]);
      output += ${CHANNEL_TILE};
    }
    if XNN_UNLIKELY(c != 0) {
      // Reads past the last channel are covered by XNN_EXTRA_BYTES on the
      // inputs and by the channel tile padding of the packed weights.
      const uint16_t* wk = (const uint16_t*) (wb + ${CHANNEL_TILE});
      do {
        const float32x4x2_t vbias = vuzpq_f32(vld1q_f32(wb), vld1q_f32(wb + 4));
        float32x4_t vaccep0 = vbias.val[0];
        float32x4_t vaccop0 = vbias.val[1];
        $for K in range(KERNEL_TILE):

          const bfloat16x8_t vi${K} = vreinterpretq_bf16_u16(vld1q_u16(i${K}));
          i${K} += 8;
          const bfloat16x8_t vk${K} = vreinterpretq_bf16_u16(vld1q_u16(wk + ${K * CHANNEL_TILE}));
          $if 1 <= K < ACCUMULATORS:
            float32x4_t vaccep${K} = vbfmlalbq_f32(vdupq_n_f32(0.0f), vi${K}, vk${K});
            float32x4_t vaccop${K} = vbfmlaltq_f32(vdupq_n_f32(0.0f), vi${K}, vk${K});
          $else:
            vaccep${K % ACCUMULATORS} = vbfmlalbq_f32(vaccep${K % ACCUMULATORS}, vi${K}, vk${K});
            vaccop${K % ACCUMULATORS} = vbfmlaltq_f32(vaccop${K % ACCUMULATORS}, vi${K}, vk${K});
        wb += 8;
        wk += 8;

        $if ACCUMULATORS > 1:
          $ACC_SLICE = 1
          $while ACC_SLICE < ACCUMULATORS:
            $for A in range(0, ACCUMULATORS, ACC_SLICE * 2):
              $if A + ACC_SLICE < ACCUMULATORS:
                vaccep${A} = vaddq_f32(vaccep${A}, vaccep${A + ACC_SLICE});
                vaccop${A} = vaddq_f32(vaccop${A}, vaccop${A + ACC_SLICE});
            $ACC_SLICE *= 2

        const float32x4x2_t vacc = vzipq_f32(
            vminq_f32(vmaxq_f32(vaccep0, vmin), vmax),
            vminq_f32(vmaxq_f32(vaccop0, vmin), vmax));
        float32x4_t vacc0 = vacc.val[0];

        if XNN_LIKELY(c >= 8) {
          vst1q_f32(output, vacc0);
          vst1q_f32(output + 4, vacc.val[1]);
          output += 8;
          c -= 8;
        } else {
          if (c & 4) {
            vst1q_f32(output, vacc0);
            vacc0 = vacc.val[1];
            output += 4;
          }
          float32x2_t vacc0_lo = vget_low_f32(vacc0);
          if (c & 2) {
            vst1_f32(output, vacc0_lo);
            vacc0_lo = vget_high_f32(vacc0);
            output += 2;
          }
          if (c & 1) {
            vst1_lane_f32(output, vacc0_lo, 0);
            output += 1;
          }
          c = 0;
        }
      } while (c != 0);
    }

    input_offset += input_pixel_stride;
    output = (float*) ((uintptr_t) output + output_increment);
  } while (--output_width != 0);
}
