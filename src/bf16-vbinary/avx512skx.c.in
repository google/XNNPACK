$assert BATCH_TILE % 16 == 0
$assert BATCH_TILE >= 16
$SIMD_TILE = BATCH_TILE // 16
$assert OP in ["ADD", "DIV", "RDIV", "MAX", "MIN", "MUL", "SUB", "RSUB", "SQRDIFF", "PRELU", "RPRELU"]
$assert BROADCAST or OP not in ["RDIV", "RSUB", "RPRELU"]
#include <assert.h>
#include <immintrin.h>
#include <stddef.h>
#include <stdint.h>

#include "src/xnnpack/common.h"
#include "src/xnnpack/intrinsics-polyfill.h"
#include "src/xnnpack/microparams.h"
#include "src/xnnpack/vbinary.h"


static inline __m512 load_bf16_as_f32(const uint16_t* input) {
  return _mm512_castsi512_ps(_mm512_slli_epi32(
      _mm512_cvtepu16_epi32(_mm256_loadu_si256((const __m256i*) input)), 16));
}

static inline __m512 maskz_load_bf16_as_f32(
    __mmask16 mask, const uint16_t* input) {
  return _mm512_castsi512_ps(_mm512_slli_epi32(
      _mm512_cvtepu16_epi32(_mm256_maskz_loadu_epi16(mask, input)), 16));
}

static inline __m256i convert_f32_to_bf16(__m512 value) {
  const __m512i vbias = _mm512_set1_epi32(0x7FFF);
  const __m512i vone = _mm512_set1_epi32(1);
  const __m512i vabs_mask = _mm512_set1_epi32(0x7FFFFFFF);
  const __m512i vexp_mask = _mm512_set1_epi32(0x7F800000);
  const __m512i vquiet = _mm512_set1_epi32(0x00400000);

  __m512i vi = _mm512_castps_si512(value);
  const __m512i vlsb =
      _mm512_and_si512(_mm512_srli_epi32(vi, 16), vone);
  const __m512i vrounded =
      _mm512_add_epi32(_mm512_add_epi32(vi, vbias), vlsb);
  const __mmask16 vnanmask = _mm512_cmpgt_epu32_mask(
      _mm512_and_si512(vi, vabs_mask), vexp_mask);
  vi = _mm512_mask_or_epi32(vrounded, vnanmask, vi, vquiet);
  return _mm512_cvtepi32_epi16(_mm512_srli_epi32(vi, 16));
}

$OP_F32 = {
$  "ADD": lambda a, b: "_mm512_add_ps(%s, %s)" % (a, b),
$  "DIV": lambda a, b: "_mm512_div_ps(%s, %s)" % (a, b),
$  "RDIV": lambda a, b: "_mm512_div_ps(%s, %s)" % (b, a),
$  "MAX": lambda a, b: "_mm512_max_ps(%s, %s)" % (a, b),
$  "MIN": lambda a, b: "_mm512_min_ps(%s, %s)" % (a, b),
$  "MUL": lambda a, b: "_mm512_mul_ps(%s, %s)" % (a, b),
$  "SUB": lambda a, b: "_mm512_sub_ps(%s, %s)" % (a, b),
$  "RSUB": lambda a, b: "_mm512_sub_ps(%s, %s)" % (b, a),
$  "SQRDIFF": lambda a, b: "_mm512_sub_ps(%s, %s)" % (a, b),
$  "PRELU": lambda a, b: "_mm512_mask_mul_ps(%s, _mm512_movepi32_mask(_mm512_castps_si512(%s)), %s, %s)" % (a, a, a, b),
$  "RPRELU": lambda a, b: "_mm512_mask_mul_ps(%s, vsign, %s, %s)" % (b, a, b),
$}[OP]
$SUFFIX = "c" if BROADCAST else ""
$B = lambda n: "vb" if BROADCAST else "vb%d" % n
void xnn_bf16_v${OP.lower()}${SUFFIX}_ukernel__avx512skx_u${BATCH_TILE}(
    size_t batch,
    const xnn_bfloat16* input_a,
    const xnn_bfloat16* input_b,
    xnn_bfloat16* output,
    const struct xnn_bf16_default_params* restrict params)
{
  assert(batch != 0);
  assert(batch % sizeof(xnn_bfloat16) == 0);
  assert(input_a != NULL);
  assert(input_b != NULL);
  assert(output != NULL);

  const uint16_t* a = (const uint16_t*) input_a;
  $if not BROADCAST:
    const uint16_t* b = (const uint16_t*) input_b;
  uint16_t* o = (uint16_t*) output;
  $if BROADCAST:
    const __m512 vb = _mm512_castsi512_ps(
        _mm512_set1_epi32((int) ((uint32_t) *((const uint16_t*) input_b) << 16)));
    $if OP == "RPRELU":
      const __mmask16 vsign = _mm512_movepi32_mask(_mm512_castps_si512(vb));
  for (; batch >= ${BATCH_TILE} * sizeof(xnn_bfloat16);
       batch -= ${BATCH_TILE} * sizeof(xnn_bfloat16)) {
    $for N in range(SIMD_TILE):
      const __m512 va${N} = load_bf16_as_f32(a + ${N * 16});
      $if not BROADCAST:
        const __m512 vb${N} = load_bf16_as_f32(b + ${N * 16});
    a += ${BATCH_TILE};
    $if not BROADCAST:
      b += ${BATCH_TILE};

    $for N in range(SIMD_TILE):
      __m512 vy${N} = ${OP_F32("va%d" % N, B(N))};
    $if OP == "SQRDIFF":
      $for N in range(SIMD_TILE):
        vy${N} = _mm512_mul_ps(vy${N}, vy${N});

    $for N in range(SIMD_TILE):
      _mm256_storeu_si256((__m256i*) (o + ${N * 16}), convert_f32_to_bf16(vy${N}));
    o += ${BATCH_TILE};
  }
  $if BATCH_TILE > 16:
    for (; batch >= 16 * sizeof(xnn_bfloat16); batch -= 16 * sizeof(xnn_bfloat16)) {
      const __m512 va0 = load_bf16_as_f32(a);
      a += 16;
      $if not BROADCAST:
        const __m512 vb0 = load_bf16_as_f32(b);
        b += 16;

      __m512 vy0 = ${OP_F32("va0", B(0))};
      $if OP == "SQRDIFF":
        vy0 = _mm512_mul_ps(vy0, vy0);

      _mm256_storeu_si256((__m256i*) o, convert_f32_to_bf16(vy0));
      o += 16;
    }
  if XNN_UNLIKELY(batch != 0) {
    const size_t elements = batch / sizeof(xnn_bfloat16);
    assert(elements != 0 && elements < 16);
    const __mmask16 vmask =
        _cvtu32_mask16((uint32_t) ((UINT32_C(1) << elements) - 1));

    const __m512 va0 = maskz_load_bf16_as_f32(vmask, a);
    $if not BROADCAST:
      const __m512 vb0 = maskz_load_bf16_as_f32(vmask, b);

    __m512 vy0 = ${OP_F32("va0", B(0))};
    $if OP == "SQRDIFF":
      vy0 = _mm512_mul_ps(vy0, vy0);

    _mm256_mask_storeu_epi16(o, vmask, convert_f32_to_bf16(vy0));
  }
}
